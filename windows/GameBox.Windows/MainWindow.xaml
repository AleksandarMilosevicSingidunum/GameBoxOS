<Window x:Class="GameBox.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameBox Windows Companion" Width="1120" Height="720"
        MinWidth="760" MinHeight="520" WindowStartupLocation="CenterScreen">
    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <StackPanel><TextBlock Text="GAMEBOX" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" FontSize="18"/>
                <TextBlock Text="Windows Companion" FontSize="34" FontWeight="Bold"/></StackPanel>
            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" HorizontalAlignment="Right">
                <TextBlock x:Name="StatusText" Foreground="#9EADC0" Text="Local library ready" TextAlignment="Right"/>
                <TextBlock x:Name="LibrarySummaryText" Foreground="#718198" TextAlignment="Right" AutomationProperties.LiveSetting="Polite"/>
            </StackPanel>
        </DockPanel>
        <Grid Grid.Row="1" Margin="0,22,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" AutomationProperties.Name="Search library" TextChanged="SearchBox_TextChanged" FontSize="16"/>
            <ComboBox x:Name="SortBox" Grid.Column="1" Width="150" Margin="18,0" SelectedIndex="0" SelectionChanged="FilterChanged" AutomationProperties.Name="Library sort order">
                <ComboBoxItem Content="Favorites and title"/><ComboBoxItem Content="Recently played"/>
            </ComboBox>
            <ComboBox x:Name="PlatformBox" Grid.Column="2" Width="130" Margin="0,0,18,0" SelectionChanged="FilterChanged" AutomationProperties.Name="Platform filter"/>
            <CheckBox x:Name="FavoritesOnlyCheck" Grid.Column="3" Content="Favorites only" Margin="18,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox x:Name="AvailableOnlyCheck" Grid.Column="4" Content="Available only" Margin="0,0,18,0" VerticalAlignment="Center" Checked="FilterChanged" Unchecked="FilterChanged"/>
            <Button Grid.Column="5" Content="Discover games" Click="DiscoverShortcuts_Click" Margin="0,0,10,0" AutomationProperties.Name="Discover Windows shortcuts, Steam, Epic Games, and GOG games"/>
            <Button Grid.Column="6" Content="+ Moonlight" Click="AddMoonlight_Click" Margin="0,0,10,0" AutomationProperties.Name="Add Moonlight streaming session"/>
            <Button Grid.Column="7" Content="+ Add local game" Click="AddGame_Click"/>
        </Grid>
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="1.15*"/></Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="16" Padding="12">
                <ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" SelectionChanged="GamesList_SelectionChanged" AutomationProperties.Name="Windows game library">
                    <ListBox.ItemTemplate><DataTemplate><Grid Margin="8" MinHeight="62">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel><TextBlock Text="{Binding Title}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Platform}" Foreground="#9EADC0"/></StackPanel>
                        <TextBlock Grid.Column="1" Text="★" FontSize="20" Foreground="{StaticResource AccentBrush}" Visibility="{Binding Favorite, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </Grid></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
            </Border>
            <Border Grid.Column="1" Background="#111824" CornerRadius="16" Margin="18,0,0,0" Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="SELECTED GAME" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <TextBlock x:Name="SelectedTitle" Text="Choose a game" FontSize="28" FontWeight="Bold" Margin="0,8,0,4" TextWrapping="Wrap"/>
                    <TextBlock x:Name="SelectedPath" Foreground="#9EADC0" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBlock x:Name="SelectedLastPlayed" Foreground="#9EADC0" TextWrapping="Wrap" Margin="0,0,0,18" AutomationProperties.LiveSetting="Polite"/>
                    <Button x:Name="PlayButton" Content="Play" Click="Play_Click" IsEnabled="False"/>
                    <Button x:Name="EditButton" Content="Edit game details" Click="Edit_Click" IsEnabled="False" AutomationProperties.Name="Edit selected game details"/>
                    <Button x:Name="RelocateButton" Content="Relocate game" Click="Relocate_Click" IsEnabled="False" AutomationProperties.Name="Relocate selected game"/>
                    <Button x:Name="ShowFolderButton" Content="Show in folder" Click="ShowFolder_Click" IsEnabled="False" AutomationProperties.Name="Show selected game in folder"/>
                    <Button x:Name="FavoriteButton" Content="Toggle favorite" Click="Favorite_Click" IsEnabled="False"/>
                    <Button x:Name="ClearHistoryButton" Content="Clear play history" Click="ClearHistory_Click" IsEnabled="False" AutomationProperties.Name="Clear selected game play history"/>
                    <Button x:Name="RemoveButton" Content="Remove from library" Click="Remove_Click" IsEnabled="False"/>
                    <Separator Margin="0,22"/>
                    <TextBlock Text="GAMEBOX DEVICE" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <TextBox x:Name="DeviceHostBox" Text="192.168.1." Margin="0,8,0,0" AutomationProperties.Name="GameBox device host or IP"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="86"/></Grid.ColumnDefinitions>
                        <PasswordBox x:Name="DeviceSecretBox" AutomationProperties.Name="GameBox pairing secret"/>
                        <TextBox x:Name="DevicePortBox" Grid.Column="1" Text="49500" Margin="8,0,0,0" AutomationProperties.Name="GameBox device port"/>
                    </Grid>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button Content="Check and remember device" Click="CheckDevice_Click" AutomationProperties.Name="Authenticate, check, and securely remember GameBox device"/>
                        <Button Grid.Column="1" Content="Discover" Click="DiscoverDevice_Click" Margin="8,0,0,0" AutomationProperties.Name="Discover enabled GameBox devices on the local network"/>
                        <Button x:Name="ForgetDeviceButton" Grid.Column="2" Content="Forget" Click="ForgetDevice_Click" IsEnabled="False" Margin="8,0,0,0" AutomationProperties.Name="Forget protected GameBox pairing"/>
                    </Grid>
                    <ComboBox x:Name="DiscoveredDevicesBox" DisplayMemberPath="DeviceName" SelectionChanged="DiscoveredDevice_SelectionChanged" Margin="0,8,0,0" Visibility="Collapsed" AutomationProperties.Name="Discovered GameBox devices"/>
                    <TextBlock x:Name="DeviceStatusText" Foreground="#9EADC0" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" Text="Enter the pairing secret shown in GameBox Settings. After a successful check it is encrypted for this Windows user with DPAPI."/>
                    <TextBlock Text="DEVICE PREFERENCES" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" Margin="0,14,0,4"/>
                    <CheckBox x:Name="ReducedMotionDeviceCheck" Content="Reduce interface motion" IsEnabled="False" Margin="0,3"/>
                    <CheckBox x:Name="ShowUnavailableGamesDeviceCheck" Content="Show unavailable games" IsEnabled="False" Margin="0,3"/>
                    <CheckBox x:Name="ShowUnavailableShortcutsDeviceCheck" Content="Show unavailable Media and PC apps" IsEnabled="False" Margin="0,3"/>
                    <CheckBox x:Name="UnmeteredDownloadsDeviceCheck" Content="Download only on unmetered networks" IsEnabled="False" Margin="0,3"/>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Button Content="Refresh device settings" Click="RefreshDeviceSettings_Click" AutomationProperties.Name="Refresh paired GameBox preferences"/>
                        <Button Grid.Column="1" Content="Apply device settings" Click="ApplyDeviceSettings_Click" Margin="8,0,0,0" AutomationProperties.Name="Apply paired GameBox preferences"/>
                    </Grid>
                    <TextBlock x:Name="DeviceConfigurationSummaryText" Foreground="#9EADC0" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" Text="Connect to load device preferences."/>
                    <Button Content="Refresh GameBox library" Click="RefreshDeviceLibrary_Click" Margin="0,12,0,0" AutomationProperties.Name="Refresh paired GameBox library"/>
                    <TextBlock x:Name="DeviceLibrarySummaryText" Foreground="#9EADC0" TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" Text="No paired library loaded."/>
                    <ListBox x:Name="DeviceLibraryList" SelectionChanged="DeviceLibraryList_SelectionChanged" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MaxHeight="128" Margin="0,4,0,0" AutomationProperties.Name="Paired GameBox library">
                        <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="2"><TextBlock Text="{Binding Title}" FontWeight="SemiBold"/><TextBlock Foreground="#9EADC0" Text="{Binding Platform}"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <Button x:Name="FavoriteDeviceGameButton" Content="Add device favorite" Click="FavoriteDeviceGame_Click" IsEnabled="False" Margin="0,8,0,0" AutomationProperties.Name="Set favorite state for selected GameBox game"/>
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Button x:Name="DownloadDeviceSaveButton" Content="Save to PC" Click="DownloadDeviceSave_Click" IsEnabled="False" AutomationProperties.Name="Download selected GameBox managed save"/>
                        <Button x:Name="UploadDeviceSaveButton" Grid.Column="1" Content="Send save" Click="UploadDeviceSave_Click" IsEnabled="False" Margin="8,0,0,0" AutomationProperties.Name="Upload a managed save for selected GameBox game"/>
                        <Button x:Name="UploadDeviceContentButton" Grid.Column="2" Content="Send game copy" Click="UploadDeviceContent_Click" IsEnabled="False" Margin="8,0,0,0" AutomationProperties.Name="Send a user-owned game copy to the selected GameBox library title"/>
                        <Button x:Name="CancelDeviceTransferButton" Grid.Column="3" Content="Cancel" Click="CancelDeviceTransfer_Click" IsEnabled="False" Margin="8,0,0,0" AutomationProperties.Name="Cancel active GameBox transfer"/>
                    </Grid>
                    <Separator Margin="0,22"/>
                    <TextBlock Text="Transfers are paired and checksum-verified. Saves are limited to 16 MiB and preserve conflicts. Send game copy accepts only a file you select and own; Android validates its console format before atomically installing it." Foreground="#9EADC0" TextWrapping="Wrap"/>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <DockPanel Grid.Row="3" Margin="0,16,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CleanupMissingButton" Content="Remove missing entries" Click="CleanupMissing_Click" IsEnabled="False" AutomationProperties.Name="Remove missing Windows library entries"/>
                <Button Content="Back up library" Click="BackupLibrary_Click" Margin="10,0,0,0" AutomationProperties.Name="Back up Windows library"/>
                <Button Content="Restore library" Click="RestoreLibrary_Click" Margin="10,0,0,0" AutomationProperties.Name="Restore Windows library"/>
            </StackPanel>
            <TextBlock Foreground="#718198" VerticalAlignment="Center" Text="Enter: Play selected   Ctrl+F: Search   Ctrl+O: Add game"/>
        </DockPanel>
    </Grid>
</Window>
