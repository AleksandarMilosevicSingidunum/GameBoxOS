-            out += ChannelMatch(
-                channel = channelFor(v.g, v.s, v.i, title),
-                score = ADDON_SCORE,
-                how = "${v.kind.label} · ${v.g.addon.displayName}",
-                program = null,
-                quality = SportsMatcher.nameQuality(v.s.info),
-                catchup = false
