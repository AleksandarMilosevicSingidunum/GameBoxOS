+            // Longer names first, and taken out once found, so "american football" isn't also football.
+            for ((w, s) in SPORT_NAMES) {
+                if (t.contains(" $w ")) {
+                    out += s
+                    t = t.replace(" $w ", " ")
+                }
+            }
+            return out
+        }
