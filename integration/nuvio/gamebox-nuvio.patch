+    @Test
+    fun `legacy GameBox playlist is imported without replacing existing sources`() = runTest {
+        val existingUrl = "https://example.test/existing.m3u"
+        val legacyUrl = "https://example.test/gamebox.m3u"
+        preferences.updatePlaylists {
+            it + PlaylistSource(id = "existing", name = "Existing", url = existingUrl)
+        }
+
+        val imported = preferences.importLegacyGameBoxPlaylist(legacyUrl)
