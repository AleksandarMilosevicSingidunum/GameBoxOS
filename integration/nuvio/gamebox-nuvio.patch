-    private suspend fun vodFor(a: Addon, cats: List<CatalogDescriptor>, ev: SportsEvent): List<ChannelMatch> = coroutineScope {
-        val sport = SportsCatalog.league(ev.leagueId)?.sport ?: Sport.OTHER
-        val ttl = vodTtl(ev)
