-    <string name="playback_net_nuvio_performance_mode">Memoria nativa de ExoPlayer</string>
-    <string name="playback_net_nuvio_performance_mode_sub">Habilita el asignador nativo fuera del montón (off-heap) y las optimizaciones de desplazamiento.</string>
-    <string name="playback_net_nuvio_performance_mode_not_supported">Esta función no es compatible con tu dispositivo.</string>
-    <string name="playback_buffer_custom">Búferes de reproducción personalizados</string>
-    <string name="playback_buffer_custom_sub">Reemplaza el almacenamiento en búfer predeterminado de Media3 con los valores de abajo. Cuando está desactivado, el reproductor usa las duraciones y el tamaño objetivo del búfer predeterminados de Media3.</string>
-    <string name="playback_buffer_header">Búfer</string>
-    <string name="playback_buffer_warning">Estas configuraciones afectan el comportamiento del búfer. Valores incorrectos pueden causar problemas de reproducción.</string>
-    <string name="playback_buffer_min">Duración mínima del búfer</string>
-    <string name="playback_buffer_min_sub">Cantidad mínima de contenido para almacenar en búfer. El reproductor intentará asegurar que siempre haya al menos esta cantidad de contenido cargado por delante de la posición actual.</string>
-    <string name="playback_buffer_max">Duración máxima del búfer</string>
-    <string name="playback_buffer_max_sub">Cantidad máxima de contenido para almacenar en búfer. Debe ser al menos igual a la duración mínima del búfer. Valores más altos usan más memoria pero ofrecen una reproducción más fluida en conexiones inestables.</string>
-    <string name="playback_buffer_value_same_as_min">%1$ds (igual al mínimo)</string>
-    <string name="playback_buffer_initial">Búfer inicial</string>
-    <string name="playback_buffer_initial_sub">Cantidad de contenido que debe cargarse antes de iniciar la reproducción. Valores bajos inician más rápido pero pueden causar cortes iniciales en conexiones lentas.</string>
-    <string name="playback_buffer_after_rebuffer">Búfer después de recargar</string>
-    <string name="playback_buffer_after_rebuffer_sub">Cantidad de contenido a cargar después de que la reproducción se detenga por almacenamiento en búfer. Valores altos reducen interrupciones repetidas.</string>
-    <string name="playback_buffer_back">Duración del búfer posterior</string>
-    <string name="playback_buffer_back_sub">Cantidad de contenido ya reproducido que se mantiene en memoria. Permite retroceder rápidamente sin volver a descargar. Establécelo en 0 para desactivarlo y ahorrar memoria.</string>
-    <string name="playback_buffer_back_reserve">Reserva aproximadamente %1$d MB además del búfer objetivo. Aumentar la duración máxima del búfer reduce esto sin perder tiempo de búfer posterior.</string>
-    <string name="playback_buffer_managed">Límite de memoria administrado</string>
-    <string name="playback_buffer_managed_sub">Limita el búfer a una parte segura de la memoria del dispositivo. Desactívalo para definir manualmente el tamaño del búfer objetivo (avanzado: valores altos pueden causar cierres en dispositivos con poca memoria).</string>
-    <string name="playback_buffer_target">Tamaño del búfer objetivo</string>
-    <string name="playback_buffer_target_sub">Cantidad máxima de RAM usada para el búfer adelantado. El máximo se calcula según la memoria disponible del dispositivo (límite de memoria por aplicación de Android), por lo que dispositivos con más RAM permiten valores mayores automáticamente.</string>
-    <string name="playback_buffer_target_managed_hint">Administrado por el límite de memoria del dispositivo. Desactiva Límite de memoria administrado para configurarlo.</string>
-    <string name="playback_buffer_target_warning">Advertencia: supera el límite seguro del dispositivo (%1$d MB). La aplicación podría cerrarse durante la reproducción.</string>
-    <string name="playback_buffer_target_danger_warning">Peligro: supera el límite de advertencia (%1$d MB). Alto riesgo de fallos o cierres inesperados.</string>
-    <string name="playback_buffer_allow_large">Permitir búfer objetivo más grande</string>
-    <string name="playback_buffer_allow_large_sub">Elimina el límite de memoria del dispositivo para el control del tamaño del búfer objetivo, permitiendo valores de hasta 2 GB. Puede causar cierres en dispositivos con menos de 2 GB de RAM.</string>
-    <string name="playback_cache_header">Caché en disco</string>
-    <string name="playback_cache_vod">Caché VOD en disco</string>
-    <string name="playback_cache_vod_sub">Guarda los datos descargados en disco para la transmisión actual. Amplía el retroceso instantáneo más allá del búfer en memoria y resiste caídas breves de red. Solo aplica a transmisiones progresivas (sin HLS/DASH).</string>
-    <string name="playback_cache_auto_size">Tamaño automático</string>
-    <string name="playback_cache_auto_size_sub">Cuando está activado, el tamaño de la caché se calcula según el espacio libre en disco. Desactívalo para elegir el tamaño manualmente.</string>
-    <string name="playback_cache_vod_size">Tamaño de la caché VOD</string>
-    <string name="playback_cache_vod_size_sub">Uso máximo del disco para la caché VOD progresiva (eliminación LRU).</string>
-    <string name="playback_cache_info_range">Rango: %1$d-%2$d MB.</string>
-    <string name="playback_cache_info_auto">El modo automático apunta a aproximadamente el 10 % del espacio libre.</string>
-    <string name="playback_cache_info_manual_headroom">El modo manual mantiene aproximadamente %1$d MB libres.</string>
-    <string name="playback_cache_info_free_disk">Espacio libre disponible: %1$s.</string>
-    <string name="playback_cache_info_restart">El nuevo límite de caché se aplicará tras reiniciar la aplicación al cambiar entre modos o tamaños.</string>
-    <string name="playback_cache_write_warning">En dispositivos con almacenamiento interno, la actividad de escritura es constante y puede aumentar el desgaste con el tiempo.</string>
-    <string name="playback_reset_to_default">Restablecer valores predeterminados</string>
-    <string name="playback_net_custom">Red personalizada</string>
-    <string name="playback_net_custom_sub">Usa múltiples conexiones paralelas para obtener transmisiones progresivas. Cuando está desactivado, se usa una sola conexión.</string>
-    <string name="playback_net_parallel">Conexiones paralelas</string>
-    <string name="playback_net_parallel_sub">Usa múltiples conexiones en paralelo para obtener transmisiones. Actívalo si experimentas almacenamiento en búfer aunque tu velocidad de descarga sea claramente suficiente.</string>
-    <string name="playback_net_connection_count">Cantidad de conexiones</string>
-    <string name="playback_net_connection_count_sub">Número de conexiones TCP paralelas. Los valores más altos aumentan el uso de memoria y el rendimiento, pero con beneficios cada vez menores.</string>
-    <string name="playback_net_chunk_size">Tamaño de fragmento</string>
-    <string name="playback_net_chunk_size_sub">Tamaño de cada fragmento de descarga por conexión. Los fragmentos más grandes reducen la sobrecarga, pero utilizan más memoria.</string>
