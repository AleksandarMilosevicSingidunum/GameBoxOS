-    <string name="playback_buffer_custom">Buffers de reprodução personalizados</string>
-    <string name="playback_buffer_custom_sub">Substituir o comportamento predefinido de buffer do Media3 com os valores abaixo. Quando desativado, o leitor utiliza as durações de buffer e o tamanho de destino originais do Media3.</string>
-    <string name="playback_buffer_header">Buffer</string>
-    <string name="playback_buffer_warning">Estas definições afetam o comportamento do buffer. Valores incorretos podem causar problemas de reprodução.</string>
-    <string name="playback_buffer_min">Duração mín. do buffer</string>
-    <string name="playback_buffer_min_sub">Quantidade mínima de multimédia a colocar em buffer. O leitor tentará garantir que existe sempre pelo menos esta quantidade de conteúdo em buffer à frente da posição de reprodução atual.</string>
-    <string name="playback_buffer_max">Duração máx. do buffer</string>
-    <string name="playback_buffer_max_sub">Quantidade máxima de multimédia a colocar em buffer. Tem de ser pelo menos igual à duração mínima do buffer. Valores mais altos consomem mais memória, mas proporcionam uma reprodução mais fluida em ligações instáveis.</string>
-    <string name="playback_buffer_value_same_as_min">%1$ds (igual ao mín.)</string>
-    <string name="playback_buffer_initial">Buffer inicial</string>
-    <string name="playback_buffer_initial_sub">Quanto conteúdo tem de estar em buffer antes de a reprodução iniciar. Valores mais baixos iniciam mais rapidamente, mas podem causar soluços iniciais em ligações lentas.</string>
-    <string name="playback_buffer_after_rebuffer">Buffer após rebuffer</string>
-    <string name="playback_buffer_after_rebuffer_sub">Quanto conteúdo colocar em buffer após a reprodução parar devido a carregamento. Valores mais altos reduzem interrupções repetidas de buffer.</string>
-    <string name="playback_buffer_back">Duração do buffer anterior</string>
-    <string name="playback_buffer_back_sub">Quanto conteúdo já reproduzido manter na memória. Permite retroceder rapidamente sem voltar a transferir. Define como 0 para desativar e poupar memória.</string>
-    <string name="playback_buffer_back_reserve">Reserva ~%1$d MB além do buffer de destino. Aumentar a duração máxima do buffer reduz este espaço sem perder tempo de buffer anterior.</string>
-    <string name="playback_buffer_managed">Orçamento de memória gerido</string>
-    <string name="playback_buffer_managed_sub">Limita o buffer a uma percentagem segura da memória deste dispositivo. Desativa para definir o tamanho do buffer de destino manualmente (avançado — valores elevados podem fazer com que dispositivos com pouca memória encerrem a aplicação).</string>
-    <string name="playback_buffer_target">Tamanho do buffer de destino</string>
-    <string name="playback_buffer_target_sub">Memória RAM máxima utilizada para pré-carregamento. O máximo é calculado a partir da memória disponível do teu dispositivo (limite de heap por aplicação do Android), pelo que dispositivos com mais RAM desbloqueiam limites maiores automaticamente.</string>
-    <string name="playback_buffer_target_managed_hint">Gerido pelo orçamento de memória do dispositivo. Desativa o Orçamento de memória gerido para definir isto.</string>
-    <string name="playback_buffer_target_warning">Aviso: acima do limite de segurança do dispositivo (%1$d MB). A aplicação poderá encerrar durante a reprodução.</string>
-    <string name="playback_buffer_target_danger_warning">Perigo: Acima do limite de aviso (%1$d MB). Elevado risco de encerramento.</string>
-    <string name="playback_buffer_allow_large">Permitir buffer de destino maior</string>
-    <string name="playback_buffer_allow_large_sub">Remove o limite de memória do dispositivo no cursor do tamanho do buffer de destino, permitindo valores até 2 GB. Pode encerrar em dispositivos com menos de 2 GB de RAM.</string>
-    <string name="playback_cache_header">Cache de disco</string>
-    <string name="playback_cache_vod">Cache de disco VOD</string>
-    <string name="playback_cache_vod_sub">Guardar os bytes transferidos no disco para a fonte atual. Estende a navegação instantânea para trás além do buffer anterior na memória e sobrevive a pequenas falhas de rede. Aplica-se apenas a transmissões progressivas (sem HLS/DASH).</string>
-    <string name="playback_cache_auto_size">Tamanho automático</string>
-    <string name="playback_cache_auto_size_sub">Quando ativado, o tamanho da cache é dimensionado com base no espaço em disco livre. Desativa para escolher um tamanho manualmente.</string>
-    <string name="playback_cache_vod_size">Tamanho da cache VOD</string>
-    <string name="playback_cache_vod_size_sub">Utilização máxima de disco para a cache VOD progressiva (removida por LRU).</string>
-    <string name="playback_cache_info_range">Intervalo: %1$d-%2$d MB.</string>
-    <string name="playback_cache_info_auto">O modo automático visa cerca de 10% do espaço livre.</string>
-    <string name="playback_cache_info_manual_headroom">O modo manual mantém cerca de %1$d MB de margem.</string>
-    <string name="playback_cache_info_free_disk">Espaço em disco livre disponível: %1$s.</string>
-    <string name="playback_cache_info_restart">O novo limite da cache aplica-se após reiniciar a aplicação ao alterar entre modos/tamanhos.</string>
-    <string name="playback_cache_write_warning">Em dispositivos com armazenamento integrado, a atividade de escrita é constante e pode adicionar desgaste ao longo do tempo.</string>
-    <string name="playback_reset_to_default">Repor predefinições</string>
-    <string name="playback_net_custom">Rede personalizada</string>
-    <string name="playback_net_custom_sub">Utilizar várias ligações em paralelo para obter fontes progressivas. Quando desativado, é utilizada uma única ligação.</string>
-    <string name="playback_net_parallel">Ligações em paralelo</string>
-    <string name="playback_net_parallel_sub">Utilizar várias ligações em paralelo para obter fontes. Ativa se sentires buffers apesar de a tua velocidade de transferência ser manifestamente mais do que suficiente.</string>
-    <string name="playback_net_connection_count">Número de ligações</string>
-    <string name="playback_net_connection_count_sub">Número de ligações TCP em paralelo. Valores mais altos aumentam a utilização de memória e o rendimento, mas com retorno decrescente.</string>
-    <string name="playback_net_chunk_size">Tamanho do bloco</string>
-    <string name="playback_net_chunk_size_sub">Tamanho de cada bloco de transferência por ligação. Blocos maiores reduzem a sobrecarga, mas utilizam mais memória.</string>
