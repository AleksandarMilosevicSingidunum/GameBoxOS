-    <string name="playback_buffer_custom_sub">Přepsat výchozí buferování Media3 níže uvedenými hodnotami. Je-li vypnuto, přehrávač používá výchozí délky bufferu a cílovou velikost Media3.</string>
-    <string name="playback_buffer_header">Buffer</string>
-    <string name="playback_buffer_warning">Toto nastavení ovlivňuje chování bufferování. Nesprávné hodnoty mohou způsobit problémy s přehráváním.</string>
-    <string name="playback_buffer_min">Min. délka bufferu</string>
-    <string name="playback_buffer_min_sub">Minimální množství médií k bufferování. Přehrávač se pokusí zajistit, aby bylo vždy nabufferováno alespoň tolik obsahu před aktuální pozicí přehrávání.</string>
-    <string name="playback_buffer_max">Max. délka bufferu</string>
-    <string name="playback_buffer_max_sub">Maximální množství médií k bufferování. Musí být alespoň tak velké jako minimální délka bufferu. Vyšší hodnoty využívají více paměti, ale poskytují plynulejší přehrávání na nestabilních připojeních.</string>
-    <string name="playback_buffer_value_same_as_min">%1$ds (stejné jako min.)</string>
-    <string name="playback_buffer_initial">Počáteční buffer</string>
-    <string name="playback_buffer_initial_sub">Kolik obsahu musí být nabufferováno před začátkem přehrávání. Nižší hodnoty startují rychleji, ale mohou způsobit počáteční sekání na pomalých připojeních.</string>
-    <string name="playback_buffer_after_rebuffer">Buffer po opětovném bufferování</string>
-    <string name="playback_buffer_after_rebuffer_sub">Kolik obsahu bufferovat poté, co se přehrávání zastaví kvůli bufferování. Vyšší hodnoty snižují počet opakovaných přerušení bufferováním.</string>
-    <string name="playback_buffer_back">Délka zpětného bufferu</string>
-    <string name="playback_buffer_back_sub">Kolik již přehraného obsahu udržovat v paměti. Umožňuje rychlé přetáčení zpět bez opětovného stahování. Nastavením na 0 vypnete a ušetříte paměť.</string>
-    <string name="playback_buffer_back_reserve">Vyhrazuje ~%1$dMB navíc k cílovému bufferu. Zvýšení max. délky bufferu toto zmenší bez ztráty času zpětného bufferu.</string>
-    <string name="playback_buffer_managed">Spravovaný rozpočet paměti</string>
-    <string name="playback_buffer_managed_sub">Omezí buffer na bezpečný podíl paměti tohoto zařízení. Vypněte pro ruční nastavení cílové velikosti bufferu (pokročilé – vysoké hodnoty mohou způsobit pád zařízení s malou pamětí).</string>
-    <string name="playback_buffer_target">Cílová velikost bufferu</string>
-    <string name="playback_buffer_target_sub">Maximální RAM použitá pro předbufferování. Maximum se počítá z dostupné paměti zařízení (limit haldy na aplikaci v Androidu), takže zařízení s vyšší RAM automaticky odemknou vyšší limity.</string>
-    <string name="playback_buffer_target_managed_hint">Spravováno rozpočtem paměti zařízení. Pro ruční nastavení vypněte Spravovaný rozpočet paměti.</string>
-    <string name="playback_buffer_target_warning">Varování: nad bezpečným limitem zařízení (%1$d MB). Aplikace může během přehrávání spadnout.</string>
-    <string name="playback_buffer_target_danger_warning">Nebezpečí: nad varovným limitem (%1$d MB). Vysoké riziko pádu.</string>
-    <string name="playback_buffer_allow_large">Povolit větší cílový buffer</string>
-    <string name="playback_buffer_allow_large_sub">Odstraní omezení cílové velikosti bufferu podle paměti zařízení a umožní hodnoty až 2GB. Může způsobit pád na zařízeních s méně než 2GB RAM.</string>
-    <string name="playback_cache_header">Diskový cache</string>
-    <string name="playback_cache_vod">Diskový cache VOD</string>
-    <string name="playback_cache_vod_sub">Ukládat stažené bajty na disk pro aktuální stream. Prodlužuje okamžité přetáčení zpět nad rámec bufferu v paměti a přežije krátké výpadky sítě. Platí pouze pro progresivní streamy (ne HLS/DASH).</string>
-    <string name="playback_cache_auto_size">Automatická velikost</string>
-    <string name="playback_cache_auto_size_sub">Je-li zapnuto, velikost cache se odvíjí od volného místa na disku. Vypněte pro ruční volbu velikosti.</string>
-    <string name="playback_cache_vod_size">Velikost cache VOD</string>
-    <string name="playback_cache_vod_size_sub">Maximální využití disku pro progresivní cache VOD (mazáno metodou LRU).</string>
-    <string name="playback_cache_info_range">Rozsah: %1$d-%2$d MB.</string>
