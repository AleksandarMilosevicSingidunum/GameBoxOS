+                '<input type="url" placeholder="' + escapeAttr(i18n.titleLogoPlaceholder) + '" value="' + escapeAttr(folder.titleLogoUrl || '') + '" oninput="updateFolderTitleLogoUrl(' + ci + ',' + fi + ',this.value)">' +
