+package com.gamebox.os.ui
+
+import androidx.compose.foundation.layout.fillMaxWidth
+import androidx.compose.foundation.layout.height
+import androidx.compose.material3.LinearProgressIndicator
+import androidx.compose.material3.MaterialTheme
+import androidx.compose.runtime.Composable
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.semantics.ProgressBarRangeInfo
+import androidx.compose.ui.semantics.contentDescription
+import androidx.compose.ui.semantics.progressBarRangeInfo
+import androidx.compose.ui.semantics.semantics
+import androidx.compose.ui.unit.dp
+
+@Composable
+internal fun TrackedSourcePageProgress(
+    progress: Int,
+    loadingDescription: String,
+) {
+    if (progress >= 100) return
+    val fraction = progress.coerceIn(0, 100) / 100f
+    LinearProgressIndicator(
+        progress = { fraction },
+        modifier = Modifier.fillMaxWidth()
+            .height(3.dp)
+            .semantics {
+                contentDescription = loadingDescription
+                progressBarRangeInfo = ProgressBarRangeInfo(fraction, 0f..1f)
+            },
+        color = MaterialTheme.colorScheme.primary,
+        trackColor = MaterialTheme.colorScheme.surfaceContainerHigh,
+    )
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/ui/UiFocusAndScroll.kt b/app/src/gamebox/java/com/gamebox/os/ui/UiFocusAndScroll.kt
new file mode 100644
index 0000000..f01936c
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/ui/UiFocusAndScroll.kt
@@ -0,0 +1,38 @@
+package com.gamebox.os.ui
+
+import androidx.compose.foundation.ScrollState
+import androidx.compose.foundation.relocation.BringIntoViewRequester
+import androidx.compose.foundation.relocation.bringIntoViewRequester
+import androidx.compose.foundation.rememberScrollState
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.LaunchedEffect
+import androidx.compose.runtime.remember
+import androidx.compose.runtime.rememberCoroutineScope
+import androidx.compose.runtime.snapshotFlow
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.composed
+import androidx.compose.ui.focus.onFocusChanged
+import kotlinx.coroutines.launch
+
+/** Scrolls controller-focused controls into the visible viewport. */
+internal fun Modifier.bringFocusedControlIntoView(): Modifier = composed {
+    val requester = remember { BringIntoViewRequester() }
+    val scope = rememberCoroutineScope()
+    bringIntoViewRequester(requester).onFocusChanged { state ->
+        if (state.isFocused) scope.launch { requester.bringIntoView() }
+    }
+}
+
+/** Remembers a screen's vertical position in the current saved UI state. */
+@Composable
+internal fun restoredScrollState(key: String): ScrollState {
+    val uiState = LocalGameBoxUiState.current
+    val initial = uiState?.screenValue("scroll.$key")?.toIntOrNull()?.coerceAtLeast(0) ?: 0
+    val scrollState = rememberScrollState(initial = initial)
+    LaunchedEffect(uiState, key, scrollState) {
+        snapshotFlow { scrollState.value }.collect { value ->
+            uiState?.rememberScreenValue("scroll.$key", value.toString())
+        }
+    }
+    return scrollState
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/ui/UiTextFormatters.kt b/app/src/gamebox/java/com/gamebox/os/ui/UiTextFormatters.kt
new file mode 100644
index 0000000..fade93b
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/ui/UiTextFormatters.kt
@@ -0,0 +1,35 @@
+package com.gamebox.os.ui
+
+import com.gamebox.os.domain.DownloadStatus
+import com.gamebox.os.domain.InstallState
+import java.util.Locale
+
+internal fun formatDownloadBytes(bytes: Long): String {
+    val safeBytes = bytes.coerceAtLeast(0L)
+    val mebibytes = safeBytes.toDouble() / MEBIBYTE
+    return when {
+        mebibytes >= 1024.0 -> String.format(Locale.US, "%.1f GB", mebibytes / 1024.0)
+        mebibytes >= 1.0 -> String.format(Locale.US, "%.1f MB", mebibytes)
+        safeBytes >= 1024L -> String.format(Locale.US, "%.1f KB", safeBytes / 1024.0)
+        else -> "$safeBytes B"
+    }
+}
+
+internal fun formatTransferRate(bytesPerSecond: Long): String {
+    val rate = bytesPerSecond.coerceAtLeast(0L)
+    return when {
+        rate >= 1024L * 1024L -> String.format(Locale.US, "%.1f MB/s", rate / (1024.0 * 1024.0))
+        rate >= 1024L -> String.format(Locale.US, "%.0f KB/s", rate / 1024.0)
+        else -> "$rate B/s"
+    }
+}
+
+internal fun formatBytes(bytes: Long): String =
+    String.format(Locale.US, "%.1f GB", bytes.toDouble() / GIBIBYTE)
+
+internal fun DownloadStatus.displayName(): String = name.lowercase(Locale.ROOT).replace('_', ' ')
+
+internal fun InstallState.displayName(): String = name.lowercase(Locale.ROOT).replace('_', ' ')
+
+private const val MEBIBYTE = 1024.0 * 1024.0
+private const val GIBIBYTE = MEBIBYTE * 1024.0
diff --git a/app/src/gamebox/java/com/gamebox/os/ui/theme/GameBoxTheme.kt b/app/src/gamebox/java/com/gamebox/os/ui/theme/GameBoxTheme.kt
