-    <string name="playback_buffer_header">Bafer</string>
-    <string name="playback_buffer_warning">Ova podešavanja utiču na ponašanje baferovanja. Neispravne vrednosti mogu uzrokovati probleme pri reprodukciji.</string>
-    <string name="playback_buffer_min">Minimalno trajanje bafera</string>
-    <string name="playback_buffer_min_sub">Minimalna količina medija za baferovanje. Plejer će se truditi da uvek ima bar toliko baferovanog sadržaja ispred trenutne pozicije.</string>
-    <string name="playback_buffer_max">Maksimalno trajanje bafera</string>
-    <string name="playback_buffer_max_sub">Maksimalna količina medija za baferovanje. Mora biti bar jednaka minimalnom trajanju bafera. Veće vrednosti troše više memorije, ali pružaju stabilniju reprodukciju na nestabilnim vezama.</string>
