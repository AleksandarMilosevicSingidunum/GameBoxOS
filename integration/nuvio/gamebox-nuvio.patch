-    <string name="playback_buffer_custom">Aangepaste afspeelbuffers</string>
-    <string name="playback_buffer_custom_sub">Overschrijf de standaardbuffering van Media3 met de onderstaande waarden. Wanneer dit uitstaat, gebruikt de speler de standaardbufferduur en -doelgrootte van Media3.</string>
-    <string name="playback_buffer_header">Buffer</string>
-    <string name="playback_buffer_warning">Deze instellingen beïnvloeden het buffergedrag. Onjuiste waarden kunnen afspeelproblemen veroorzaken.</string>
-    <string name="playback_buffer_min">Minimale bufferduur</string>
-    <string name="playback_buffer_min_sub">Minimale hoeveelheid media die wordt gebufferd. De speler probeert altijd ten minste deze hoeveelheid inhoud vooruit te bufferen op de huidige afspeelpositie.</string>
-    <string name="playback_buffer_max">Maximale bufferduur</string>
-    <string name="playback_buffer_max_sub">Maximale hoeveelheid media die wordt gebufferd. Moet minstens gelijk zijn aan de minimale bufferduur. Hogere waarden gebruiken meer geheugen, maar zorgen voor vloeiender afspelen bij een instabiele verbinding.</string>
-    <string name="playback_buffer_value_same_as_min">%1$d s (gelijk aan min.)</string>
-    <string name="playback_buffer_initial">Beginbuffer</string>
-    <string name="playback_buffer_initial_sub">Hoeveel inhoud er gebufferd moet zijn voordat het afspelen begint. Lagere waarden starten sneller, maar kunnen bij trage verbindingen aanvankelijk haperen.</string>
-    <string name="playback_buffer_after_rebuffer">Buffer na herbufferen</string>
-    <string name="playback_buffer_after_rebuffer_sub">Hoeveel inhoud er wordt gebufferd nadat het afspelen door buffering is gestopt. Hogere waarden verminderen herhaalde bufferonderbrekingen.</string>
-    <string name="playback_buffer_back">Duur van terugbuffer</string>
-    <string name="playback_buffer_back_sub">Hoeveel al afgespeelde inhoud in het geheugen wordt bewaard. Maakt snel terugspoelen mogelijk zonder opnieuw te downloaden. Zet op 0 om dit uit te schakelen en geheugen te besparen.</string>
-    <string name="playback_buffer_back_reserve">Reserveert ongeveer %1$d MB bovenop de doelbuffer. Door de maximale bufferduur te verhogen wordt dit kleiner zonder terugbuffertijd te verliezen.</string>
-    <string name="playback_buffer_managed">Beheerd geheugenbudget</string>
-    <string name="playback_buffer_managed_sub">Beperkt de buffer tot een veilig deel van het geheugen van dit apparaat. Zet dit uit om de doelbuffergrootte zelf in te stellen (geavanceerd — grote waarden kunnen apparaten met weinig geheugen laten crashen).</string>
-    <string name="playback_buffer_target">Doelbuffergrootte</string>
-    <string name="playback_buffer_target_sub">Maximale hoeveelheid RAM voor vooruitbufferen. Het maximum wordt berekend op basis van het beschikbare geheugen van je apparaat (de heaplimiet per app van Android), dus apparaten met meer RAM krijgen automatisch een hogere limiet.</string>
-    <string name="playback_buffer_target_managed_hint">Wordt beheerd door het geheugenbudget van het apparaat. Zet Beheerd geheugenbudget uit om dit in te stellen.</string>
-    <string name="playback_buffer_target_warning">Waarschuwing: boven de veilige limiet van het apparaat (%1$d MB). De app kan tijdens het afspelen crashen.</string>
-    <string name="playback_buffer_target_danger_warning">Gevaar: boven de waarschuwingslimiet (%1$d MB). Hoog risico op crashes.</string>
-    <string name="playback_buffer_allow_large">Grotere doelbuffer toestaan</string>
-    <string name="playback_buffer_allow_large_sub">Verwijdert de geheugenlimiet van het apparaat op de schuifregelaar voor de doelbuffergrootte, met waarden tot 2 GB. Kan crashen op apparaten met minder dan 2 GB RAM.</string>
-    <string name="playback_cache_header">Schijfcache</string>
-    <string name="playback_cache_vod">VOD-schijfcache</string>
-    <string name="playback_cache_vod_sub">Bewaar gedownloade bytes op schijf voor de huidige stream. Hiermee kun je verder terug direct terugspoelen dan de terugbuffer in het geheugen toelaat, en korte netwerkonderbrekingen worden opgevangen. Geldt alleen voor progressieve streams (geen HLS/DASH).</string>
-    <string name="playback_cache_auto_size">Automatische grootte</string>
-    <string name="playback_cache_auto_size_sub">Wanneer dit aanstaat, wordt de cachegrootte bepaald door de vrije schijfruimte. Zet dit uit om zelf een grootte te kiezen.</string>
-    <string name="playback_cache_vod_size">Grootte van VOD-cache</string>
-    <string name="playback_cache_vod_size_sub">Maximaal schijfgebruik voor de progressieve VOD-cache (LRU-verwijdering).</string>
-    <string name="playback_cache_info_range">Bereik: %1$d-%2$d MB.</string>
-    <string name="playback_cache_info_auto">De automatische modus streeft naar ongeveer 10% van de vrije ruimte.</string>
-    <string name="playback_cache_info_manual_headroom">De handmatige modus houdt ongeveer %1$d MB speling vrij.</string>
-    <string name="playback_cache_info_free_disk">Beschikbare vrije schijfruimte: %1$s.</string>
-    <string name="playback_cache_info_restart">Bij het wisselen tussen modi/groottes geldt de nieuwe cachelimiet pas na het opnieuw starten van de app.</string>
-    <string name="playback_cache_write_warning">Op apparaten met ingebouwde opslag wordt er continu geschreven, wat na verloop van tijd slijtage kan veroorzaken.</string>
-    <string name="playback_reset_to_default">Standaardwaarden herstellen</string>
-    <string name="playback_net_custom">Aangepast netwerk</string>
-    <string name="playback_net_custom_sub">Gebruik meerdere parallelle verbindingen om progressieve streams op te halen. Wanneer dit uitstaat, wordt één verbinding gebruikt.</string>
-    <string name="playback_net_parallel">Parallelle verbindingen</string>
-    <string name="playback_net_parallel_sub">Gebruik meerdere verbindingen tegelijk om streams op te halen. Schakel dit in als je last hebt van bufferen terwijl je downloadsnelheid ruim voldoende is.</string>
-    <string name="playback_net_connection_count">Aantal verbindingen</string>
