+    override fun dispatchKeyEvent(event: KeyEvent): Boolean {
+        // Button Mapper: while the user is teaching it a button (Settings), that press belongs to it.
+        val mapper = builtMapper()
+        if (mapper != null && mapper.captureController.isListening()) {
+            if (mapper.onKeyEvent(
+                    event = event,
+                    source = ButtonEventSource.FOREGROUND,
+                    accessibilityEnabled = com.nuvio.tv.core.launcher.LauncherAccessibilityService.isServiceEnabled(this),
+                    nativeHomeActive = LauncherSetup.isDefaultHome(this)
+                )
+            ) return true
+        }
+        // Live TV fork: remember when the remote was last used (the home screen's Live TV row
+        // only claims the first highlight while nobody has pressed anything yet).
+        if (event.action == KeyEvent.ACTION_DOWN) com.nuvio.tv.livetv.home.LiveTvHomeFocus.lastKeyAt = android.os.SystemClock.uptimeMillis()
+        // HOME is checked before the ambient handler: while the slideshow is up a Home press should end it
+        // and go home. Some firmware delivers raw HOME keys; most send a HOME intent or let the
+        // accessibility service filter the key, so this is a fallback, not the only path.
+        // The remote's Apps button opens the launcher's own Apps page instead of the TV's app list.
+        if (com.nuvio.tv.core.launcher.AppsKeyStore.matches(this, event.keyCode)) {
+            if (event.action == KeyEvent.ACTION_UP && !event.isCanceled) {
+                ambientIdleController.dismiss()
+                pendingOpenAppsNonce.value += 1
+            }
+            return true
+        }
+        if (event.keyCode == KeyEvent.KEYCODE_HOME) refreshHomeRole()
+        if (event.keyCode == KeyEvent.KEYCODE_HOME && nuvioHandlesHomeKey) {
+            ambientIdleController.onInteraction()
+            if (event.action == KeyEvent.ACTION_DOWN && ambientIdleController.isShowing.value) {
+                ambientIdleController.dismiss()
+            }
+            if (event.action == KeyEvent.ACTION_UP && !event.isCanceled) {
+                handleHomeKeyPress(event.eventTime)
+            }
+            return true
+        }
+        if (ambientIdleController.consumeKeyEvent(event)) return true
+        if (event.keyCode == KeyEvent.KEYCODE_BACK) {
+            if (longPressBackHeld.value) {
+                if (event.action == KeyEvent.ACTION_UP) longPressBackHeld.value = false
+                return true
+            }
+            // Once the prompt is showing, the next Back exits even if the menu was closed
+            // by the prompt itself.
+            if (confirmExitPressedOnce) {
+                if (event.action == KeyEvent.ACTION_DOWN && event.repeatCount == 0) {
+                    handleAppExit()
+                }
+                return true
+            }
+            // While the menu is open, Back is the exit prompt. Handling it here keeps the
+            // drawer's own Back handler from closing the sidebar first.
+            if (sidebarOpenForBack && !nuvioHandlesHomeKey) {
+                if (event.action == KeyEvent.ACTION_DOWN && event.repeatCount == 0) {
+                    handleAppExit()
+                }
+                return true
+            }
+        }
+        if (event.keyCode == KeyEvent.KEYCODE_BACK &&
+            externalPlaybackTracker.autoNextOverlay.value != null
+        ) {
+            if (event.action == KeyEvent.ACTION_UP) {
+                Log.d("ExtAutoNext", "dispatchKeyEvent BACK -> dismissAutoNextOverlay (loader showing)")
+                externalPlaybackTracker.dismissAutoNextOverlay()
+            }
+            return true
+        }
+        // Button Mapper: a remote button the user gave actions to (only when that button has an enabled mapping).
+        if (mapper != null && event.keyCode != KeyEvent.KEYCODE_HOME &&
+            mapper.repository.activeMappingFor(event.keyCode, isGlobal = false) != null &&
+            mapper.onKeyEvent(
+                event = event,
+                source = ButtonEventSource.FOREGROUND,
+                accessibilityEnabled = com.nuvio.tv.core.launcher.LauncherAccessibilityService.isServiceEnabled(this),
+                nativeHomeActive = LauncherSetup.isDefaultHome(this)
+            )
+        ) return true
+        return super.dispatchKeyEvent(event)
+    }
+
+    override fun onStart() {
+        // Returning from an external player: raise the auto-next loader before the player's
+        // result is dispatched and before the window repaints, so the transition shows the
+        // loader instantly with no episode-list flash. No-op unless a series episode is being
+        // tracked; onActivityResult keeps it for a completion or dismisses it otherwise.
+        externalPlaybackTracker.raiseAutoNextOverlayOnReturn()
+        super.onStart()
+        startupSyncService.startPeriodicSurfacePulls()
+        androidTvChannelSyncService.onForegroundChanged(true)
+        // Live TV fork: make sure the launcher rows exist once the app has loaded its channels.
+        // On a low-RAM TV, let startup sync and the first screen settle before drawing 36 cards.
+        val launcherRowsDelay = com.nuvio.tv.livetv.home.LauncherRowsProfile.current.startupDelayMs
+        runCatching { com.nuvio.tv.livetv.home.LiveTvLauncherRows.refresh(applicationContext, afterMs = launcherRowsDelay) }
+    }
+
+    override fun onStop() {
+        val music = com.nuvio.tv.music.MusicPlayer.state.value
+        if (!com.nuvio.tv.music.MusicSettings.keepPlayingWhileBrowsing.value &&
+            (music.isPlaying || music.isBuffering)
+        ) {
+            com.nuvio.tv.music.MusicPlayer.pause()
+        }
+        externalPlaybackTracker.onExternalPlayerCoveredApp()
+        super.onStop()
+        startupSyncService.stopPeriodicSurfacePulls()
+        // App going to background (e.g. user returning to the launcher): reconcile the
+        // Continue Watching channel once so Projectivy repaints it with fresh progress.
+        androidTvChannelSyncService.onForegroundChanged(false)
+        // Live TV fork: bring the launcher's Live TV rows up to date.
+        runCatching { com.nuvio.tv.livetv.home.LiveTvLauncherRows.refresh(applicationContext) }
+    }
+
+    override fun onDestroy() {
+        builtMapper()?.let {
+            it.actionExecutor.detachForegroundHandler(this)
+            it.cancelPendingGestures()
+        }
+        super.onDestroy()
+        PluginRuntimeHooks.onActivityDestroy()
+    }
+}
