+++ b/app/src/gamebox/java/com/gamebox/os/importer/ByteProgressThrottle.kt
@@ -0,0 +1,39 @@
+package com.gamebox.os.importer
+
+/** Coalesces byte callbacks while always allowing callers to publish final progress. */
+internal class ByteProgressThrottle(
+    private val onProgress: (Long) -> Unit,
+    private val intervalBytes: Long = DEFAULT_INTERVAL_BYTES,
+) {
+    private var lastReportedBytes = 0L
+    private var lastObservedBytes = 0L
+
+    init {
+        require(intervalBytes > 0L)
+    }
+
+    fun onBytesProcessed(bytesProcessed: Long) {
+        observe(bytesProcessed)
+        if (bytesProcessed - lastReportedBytes >= intervalBytes) {
+            onProgress(bytesProcessed)
+            lastReportedBytes = bytesProcessed
+        }
+    }
+
+    fun finish(bytesProcessed: Long) {
+        observe(bytesProcessed)
+        if (bytesProcessed != lastReportedBytes) {
+            onProgress(bytesProcessed)
+            lastReportedBytes = bytesProcessed
+        }
+    }
+
+    private fun observe(bytesProcessed: Long) {
+        require(bytesProcessed >= lastObservedBytes) { "Progress bytes cannot move backwards" }
+        lastObservedBytes = bytesProcessed
+    }
+
+    private companion object {
+        const val DEFAULT_INTERVAL_BYTES = 1024L * 1024L
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/importer/DiscSetPolicy.kt b/app/src/gamebox/java/com/gamebox/os/importer/DiscSetPolicy.kt
new file mode 100644
index 0000000..cc3f96e
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/importer/DiscSetPolicy.kt
@@ -0,0 +1,61 @@
+package com.gamebox.os.importer
+
+import java.io.File
+
+internal object DiscSetPolicy {
+    fun selectLaunchFile(directory: File, names: List<String>): String {
+        val descriptors = names.filter {
+            it.substringAfterLast('.', "").lowercase() in setOf("cue", "gdi", "mds", "ccd")
+        }
+        require(descriptors.size <= 1) { "Select one disc descriptor (.CUE, .GDI, .MDS, or .CCD) per import" }
+        if (descriptors.isNotEmpty()) {
+            validateDescriptor(directory.resolve(descriptors.single()), names)
+            return descriptors.single()
+        }
+        require(names.size == 1) {
+            "Multiple track files require one .CUE, .GDI, .MDS, or .CCD descriptor"
+        }
+        return names.single()
+    }
+
+    private fun validateDescriptor(descriptor: File, selectedNames: List<String>) {
+        require(descriptor.isFile) { "Disc descriptor is missing" }
+        require(descriptor.length() <= 2L * 1024 * 1024) { "Disc descriptor is too large" }
+        val selected = selectedNames.mapTo(mutableSetOf()) { it.lowercase() }
+        val references = when (descriptor.extension.lowercase()) {
+            "cue" -> cueReferences(descriptor)
+            "gdi" -> gdiReferences(descriptor)
+            "mds" -> listOf(descriptor.nameWithoutExtension + ".mdf")
+            "ccd" -> listOf(descriptor.nameWithoutExtension + ".img")
+            else -> emptyList()
+        }
+        references.forEach { reference ->
+            require('/' !in reference && '\\' !in reference && reference != "." && reference != "..") {
+                "Disc descriptor contains an unsafe track path"
+            }
+            require(reference.lowercase() in selected) {
+                "Disc descriptor references a file that was not selected: $reference"
+            }
+        }
+    }
+
+    private fun cueReferences(descriptor: File): List<String> {
+        val pattern = Regex("""(?im)^\s*FILE\s+(?:\"([^\"]+)\"|(\S+))""")
+        return pattern.findAll(descriptor.readText()).map { match ->
+            match.groupValues[1].ifEmpty { match.groupValues[2] }
+        }.toList().also {
+            require(it.isNotEmpty()) { "CUE descriptor does not reference any track files" }
+        }
+    }
+
+    private fun gdiReferences(descriptor: File): List<String> {
+        val pattern = Regex("""^\s*\d+\s+\d+\s+\d+\s+\d+\s+(?:\"([^\"]+)\"|(\S+))\s+\d+\s*$""")
+        return descriptor.readLines().drop(1).mapNotNull { line ->
+            pattern.matchEntire(line)?.let { match ->
+                match.groupValues[1].ifEmpty { match.groupValues[2] }
+            }
+        }.also {
+            require(it.isNotEmpty()) { "GDI descriptor does not reference any track files" }
+        }
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/importer/DiscoveryImportWorkflow.kt b/app/src/gamebox/java/com/gamebox/os/importer/DiscoveryImportWorkflow.kt
new file mode 100644
index 0000000..ea8c590
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/importer/DiscoveryImportWorkflow.kt
@@ -0,0 +1,220 @@
+package com.gamebox.os.importer
+
+import android.content.Context
+import android.net.Uri
+import android.provider.OpenableColumns
+import com.gamebox.os.content.GameMutationGate
+import com.gamebox.os.data.DiscoveryGame
+import com.gamebox.os.data.GameRepository
+import com.gamebox.os.domain.LocalContentFile
+import com.gamebox.os.domain.InstallState
+import kotlinx.coroutines.CancellationException
+import kotlinx.coroutines.NonCancellable
+import kotlinx.coroutines.withContext
+
+internal data class DiscoveryImportOutcome(
+    val message: String,
+    val succeeded: Boolean,
+    val cleanupDeferred: Boolean = false,
+)
+
+internal fun shouldRemoveImportedArchive(displayName: String): Boolean =
+    displayName.substringAfterLast('.', "").lowercase() in setOf("zip", "7z")
+
+/** Owns verified import, Library registration, rollback, and source cleanup for a discovery title. */
+internal class DiscoveryImportWorkflow(
+    private val context: Context,
+    private val importer: AuthorizedRomImporter,
+    private val repository: GameRepository,
+    private val game: DiscoveryGame,
+    private val platformName: String,
+) {
+    fun displayName(uri: Uri): String = runCatching {
+        context.contentResolver.query(
+            uri,
+            arrayOf(OpenableColumns.DISPLAY_NAME),
+            null,
+            null,
+            null,
+        )?.use { cursor ->
+            val index = cursor.getColumnIndex(OpenableColumns.DISPLAY_NAME)
+            if (index >= 0 && cursor.moveToFirst()) cursor.getString(index) else null
+        }
+    }.getOrNull() ?: uri.lastPathSegment ?: "game.rom"
+
+    suspend fun importSingle(
+        uri: Uri,
+        displayName: String,
+        removeSourceAfterSuccess: Boolean,
+        onProgress: (RomImportProgress) -> Unit = {},
+    ): DiscoveryImportOutcome = GameMutationGate.withGameLock(game.id.value) {
+        val resolvedPlatform = RomImportPolicy.resolvedPlatform(platformName, displayName)
+        when (val result = importer.import(game.id, uri, displayName, platformName, onProgress)) {
+            is RomImportResult.Imported -> completeRegistration(
+                subject = "imported files",
+                rollback = { importer.rollbackRegistration(game.id, result.transactionId) },
+            ) {
+                val importedFile = LocalContentFile(
+                    relativePath = RomImportPolicy.importRootRelativePath(game.id, result.relativePath),
+                    sha256 = result.hashes.sha256,
+                    mimeType = result.mimeType,
+                )
+                repository.registerImportedGame(
+                    importedGameRegistration(
+                        game = game,
+                        platform = resolvedPlatform,
+                        launchFile = importedFile,
+                        files = listOf(importedFile),
+                        sizeBytes = result.hashes.sizeBytes,
+                    ),
+                )
+                val cleanupDeferred = confirmRegistration(result.transactionId)
+                val sourceRemoved = removeSourceAfterSuccess && shouldDeleteImportedSource(cleanupDeferred) &&
+                    deleteImportedSource(context, uri)
+                DiscoveryImportOutcome(
+                    message = singleImportSuccessMessage(
+                        platform = resolvedPlatform,
+                        hash = result.hashes.sha256,
+                        cleanupDeferred = cleanupDeferred,
+                        sourceRemoved = sourceRemoved,
+                        sourceRemovalRequested = removeSourceAfterSuccess,
+                    ),
+                    succeeded = true,
+                    cleanupDeferred = cleanupDeferred,
+                )
+            }
+            RomImportResult.SourceUnavailable -> DiscoveryImportOutcome(
+                "The selected file is unavailable or its access expired. Choose it again.",
+                succeeded = false,
+            )
+            is RomImportResult.Rejected -> DiscoveryImportOutcome("Import rejected: ${result.reason}", succeeded = false)
+            is RomImportResult.Failed -> DiscoveryImportOutcome("Import failed: ${result.reason}", succeeded = false)
+        }
+    }
+
+    suspend fun importDiscSet(
+        sources: List<RomImportSource>,
+        onProgress: (RomImportProgress) -> Unit = {},
+    ): DiscoveryImportOutcome =
+        GameMutationGate.withGameLock(game.id.value) {
+            when (val result = importer.importSet(game.id, sources, platformName, onProgress = onProgress)) {
+                is RomImportSetResult.Imported -> completeRegistration(
+                    subject = "disc-set files",
+                    rollback = { importer.rollbackRegistration(game.id, result.transactionId) },
+                ) {
+                    val resolvedPlatform = RomImportPolicy.resolvedPlatform(
+                        platformName,
+                        result.launchFile.relativePath.substringAfterLast('/'),
+                    )
+                    val importedFiles = result.files.map { file ->
+                        LocalContentFile(
+                            relativePath = RomImportPolicy.importRootRelativePath(game.id, file.relativePath),
+                            sha256 = file.hashes.sha256,
+                            mimeType = file.mimeType,
+                        )
+                    }
+                    val launchPath = RomImportPolicy.importRootRelativePath(
+                        game.id,
+                        result.launchFile.relativePath,
+                    )
+                    val launchFile = requireNotNull(importedFiles.firstOrNull {
+                        it.relativePath == launchPath
+                    })
+                    repository.registerImportedGame(
+                        importedGameRegistration(
+                            game = game,
+                            platform = resolvedPlatform,
+                            launchFile = launchFile,
+                            files = importedFiles,
+                            sizeBytes = result.files.sumOf { it.hashes.sizeBytes },
+                        ),
+                    )
+                    val cleanupDeferred = confirmRegistration(result.transactionId)
+                    val archiveSources = sources.filter { shouldRemoveImportedArchive(it.displayName) }
+                    val archivesRemoved = if (shouldDeleteImportedSource(cleanupDeferred)) {
+                        archiveSources.count { deleteImportedSource(context, it.uri) }
+                    } else 0
+                    DiscoveryImportOutcome(buildString {
+                        append("${result.files.size}-file disc set verified and added to Library; ")
+                        if (cleanupDeferred && archiveSources.isNotEmpty()) {
+                            append("${archiveSources.size} original archive(s) retained because GameBox could not finish import cleanup")
+                        } else if (archiveSources.isEmpty()) {
+                            append("original disc files retained")
+                        } else {
+                            append("$archivesRemoved of ${archiveSources.size} selected archive(s) removed")
+                            if (archivesRemoved < archiveSources.size) append("; some archives could not be deleted")
+                            if (sources.size > archiveSources.size) append("; original disc files retained")
+                        }
+                        if (cleanupDeferred) append(". Delete retained archives only after verifying the Library copy.")
+                    }, succeeded = true, cleanupDeferred = cleanupDeferred)
+                }
+                RomImportSetResult.SourceUnavailable -> DiscoveryImportOutcome(
+                    "A selected file is unavailable or its access expired. Choose the files again.", false,
+                )
+                is RomImportSetResult.Rejected -> DiscoveryImportOutcome("Import rejected: ${result.reason}", false)
+                is RomImportSetResult.Failed -> DiscoveryImportOutcome("Import failed: ${result.reason}", false)
+            }
+        }
+
+    private suspend fun completeRegistration(
+        subject: String,
+        rollback: suspend () -> Unit,
+        operation: suspend () -> DiscoveryImportOutcome,
+    ): DiscoveryImportOutcome = try {
+        operation()
+    } catch (cancelled: CancellationException) {
+        withContext(NonCancellable) { runCatching { rollback() } }
+        throw cancelled
+    } catch (error: Exception) {
+        registrationFailureMessage(subject, error, rollback)
+    }
+
+    private suspend fun confirmRegistration(transactionId: String): Boolean = try {
+        importer.confirmRegistration(game.id, transactionId)
+        false
+    } catch (cancelled: CancellationException) {
+        throw cancelled
+    } catch (integrityFailure: ImportRegistrationIntegrityException) {
+        repository.setInstallStateAndAwait(game.id, InstallState.MISSING_FILES)
+        throw integrityFailure
+    } catch (_: Exception) {
+        true
+    }
+
+    private suspend fun registrationFailureMessage(
+        subject: String,
+        error: Throwable,
+        rollback: suspend () -> Unit,
+    ): DiscoveryImportOutcome {
+        val rolledBack = withContext(NonCancellable) { runCatching { rollback() }.isSuccess }
+        val detail = error.message?.take(140) ?: "unknown error"
+        val message = if (error is ImportRegistrationIntegrityException) {
+            if (rolledBack) {
+                "Import verification failed; $subject were rolled back and the Library entry needs repair: $detail"
+            } else {
+                "Import verification failed and recovery is pending; keep the source and restart GameBox: $detail"
+            }
+        } else if (rolledBack) {
+            "Library registration failed; $subject were rolled back safely: $detail"
+        } else {
+            "Library registration failed and recovery is pending; restart GameBox: $detail"
+        }
+        return DiscoveryImportOutcome(message, succeeded = false)
+    }
+
+    private fun singleImportSuccessMessage(
+        platform: String,
+        hash: String,
+        cleanupDeferred: Boolean,
+        sourceRemoved: Boolean,
+        sourceRemovalRequested: Boolean,
+    ): String = when {
+        cleanupDeferred ->
+            "$platform copy verified and added to Library. The original was retained because GameBox could not finish import cleanup; delete it only after verifying the Library copy."
+        sourceRemoved ->
+            "$platform download verified, moved to Library, and source removed. SHA-256 ${hash.take(12)}…"
+        sourceRemovalRequested ->
+            "$platform copy verified and added to Library, but Android denied deletion of the browser source. SHA-256 ${hash.take(12)}…"
+        else -> "$platform copy verified and added to Library. SHA-256 ${hash.take(12)}…"
+    }
+}
