+    /** "Quality: 720p" → 720; "4K"/"UHD" → 2160; none written → null. */
+    private fun resolution(info: String): Int? {
+        RES_P.find(info)?.let { return it.groupValues[1].toIntOrNull() }
+        if (RES_4K.containsMatchIn(info)) return 2160
+        return null
+    }
