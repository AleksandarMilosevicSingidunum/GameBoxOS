-    <string name="sentry_help_title">En quoi c’est utile</string>
-    <string name="sentry_help_body">Les rapports sont regroupés par version de l’application, modèle d’appareil, version d’Android et trace d’exécution, afin de corriger en priorité les plantages réels les plus fréquents.</string>
-    <string name="sentry_sent_title">Données envoyées</string>
