+                ) {
+                    Text(if (currentSettings.externalLibraryUri.isBlank()) "Choose folder" else "Change folder")
+                }
+                if (currentSettings.externalLibraryUri.isNotBlank()) {
+                    BlueprintOutlinedButton(
