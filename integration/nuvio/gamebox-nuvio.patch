-    <string name="playback_buffer_custom">Buffer-a të personalizuar të riprodhimit</string>
-    <string name="playback_buffer_custom_sub">Anashkalo buffer-in e parazgjedhur të Media3 me vlerat më poshtë. Kur është joaktiv, luajtësi përdor kohëzgjatjet standarde të buffer-it dhe madhësinë e synuar të Media3.</string>
-    <string name="playback_buffer_header">Buffer</string>
-    <string name="playback_buffer_warning">Këto cilësime ndikojnë në sjelljen e buffer-it. Vlerat e pasakta mund të shkaktojnë probleme riprodhimi.</string>
-    <string name="playback_buffer_min">Kohëzgjatja minimale e buffer-it</string>
-    <string name="playback_buffer_min_sub">Sasia minimale e medias për t’u ruajtur në buffer. Luajtësi do të përpiqet të sigurojë që të paktën kaq përmbajtje të jetë gjithmonë e ruajtur përpara pozicionit aktual të riprodhimit.</string>
-    <string name="playback_buffer_max">Kohëzgjatja maksimale e buffer-it</string>
-    <string name="playback_buffer_max_sub">Sasia maksimale e medias për t’u ruajtur në buffer. Duhet të jetë të paktën sa kohëzgjatja minimale e buffer-it. Vlerat më të larta përdorin më shumë memorie, por ofrojnë riprodhim më të rrjedhshëm në lidhje të paqëndrueshme.</string>
-    <string name="playback_buffer_value_same_as_min">%1$ds (njësoj si minimumi)</string>
-    <string name="playback_buffer_initial">Buffer-i fillestar</string>
-    <string name="playback_buffer_initial_sub">Sa përmbajtje duhet të ruhet në buffer para se të fillojë riprodhimi. Vlerat më të ulëta nisin më shpejt, por mund të shkaktojnë ngecje fillestare në lidhje të ngadalta.</string>
-    <string name="playback_buffer_after_rebuffer">Buffer pas ribuffer-it</string>
-    <string name="playback_buffer_after_rebuffer_sub">Sa përmbajtje të ruhet në buffer pasi riprodhimi ndalet për shkak të buffer-it. Vlerat më të larta zvogëlojnë ndërprerjet e përsëritura të buffer-it.</string>
-    <string name="playback_buffer_back">Kohëzgjatja e buffer-it të pasëm</string>
-    <string name="playback_buffer_back_sub">Sa përmbajtje tashmë e luajtur të mbahet në memorie. Mundëson kërkim të shpejtë prapa pa e shkarkuar përsëri. Cakto 0 për ta çaktivizuar dhe kursyer memorie.</string>
-    <string name="playback_buffer_back_reserve">Rezervon ~%1$dMB mbi Buffer-in e synuar. Rritja e Kohëzgjatjes maksimale të buffer-it e zvogëlon këtë pa humbur kohën e buffer-it të pasëm.</string>
-    <string name="playback_buffer_managed">Buxheti i menaxhuar i memories</string>
-    <string name="playback_buffer_managed_sub">Kufizon buffer-in në një pjesë të sigurt të memories së kësaj pajisjeje. Çaktivizoje për ta caktuar vetë Madhësinë e synuar të buffer-it (e avancuar — vlerat e mëdha mund të rrëzojnë pajisjet me pak memorie).</string>
-    <string name="playback_buffer_target">Madhësia e synuar e buffer-it</string>
-    <string name="playback_buffer_target_sub">RAM-i maksimal i përdorur për buffer-in përpara. Maksimumi llogaritet nga memoria e disponueshme e pajisjes (kufiri heap për aplikacion në Android), kështu që pajisjet me më shumë RAM zhbllokojnë automatikisht kufij më të mëdhenj.</string>
-    <string name="playback_buffer_target_managed_hint">Menaxhohet nga buxheti i memories së pajisjes. Çaktivizo Buxhetin e menaxhuar të memories për ta caktuar këtë.</string>
-    <string name="playback_buffer_target_warning">Paralajmërim: mbi kufirin e sigurt të pajisjes (%1$d MB). Aplikacioni mund të dështojë gjatë riprodhimit.</string>
-    <string name="playback_buffer_target_danger_warning">Rrezik: Mbi kufirin e paralajmërimit (%1$d MB). Rrezik i lartë dështimi.</string>
-    <string name="playback_buffer_allow_large">Lejo buffer të synuar më të madh</string>
-    <string name="playback_buffer_allow_large_sub">Heq kufirin e memories së pajisjes nga rrëshqitësi i Madhësisë së synuar të buffer-it, duke lejuar vlera deri në 2GB. Mund të shkaktojë dështim në pajisje me më pak se 2GB RAM.</string>
-    <string name="playback_cache_header">Cache-i i diskut</string>
-    <string name="playback_cache_vod">Cache-i VOD në disk</string>
-    <string name="playback_cache_vod_sub">Ruaj bajtat e shkarkuar në disk për transmetimin aktual. Zgjat kërkimin e menjëhershëm prapa përtej buffer-it të pasëm në memorie dhe mbijeton ndërprerje të shkurtra të rrjetit. Vlen vetëm për transmetime progresive (jo HLS/DASH).</string>
