+package com.nuvio.tv.livetv.data
+
+import com.nuvio.tv.livetv.model.LiveChannel
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class LegacyGameBoxChannelMatcherTest {
+    @Test
+    fun `indexes both old guide id and normalized channel name`() {
+        val channel = channel(tvgId = "RTS1.rs@serbia", name = "RTS 1 (1080p)")
+
+        val index = indexLegacyGameBoxChannels(listOf(channel))
+
+        assertEquals(listOf(channel), index["rts1.rs"])
+        assertEquals(listOf(channel), index["rts1"])
+    }
+
+    @Test
+    fun `name matching ignores punctuation and quality suffix`() {
+        val channel = channel(tvgId = null, name = "RTS-1 HD")
+
+        val index = indexLegacyGameBoxChannels(listOf(channel))
+
+        assertEquals(listOf(channel), index["rts1"])
+    }
+
+    private fun channel(tvgId: String?, name: String) = LiveChannel(
+        key = "source|$name",
+        sourceId = "source",
+        sourceName = "Test playlist",
+        name = name,
+        tvgId = tvgId,
+        tvgName = null,
+        logo = null,
+        groupId = "group",
+        group = "Channels",
+        number = 1,
+        url = "https://example.test/live.m3u8"
+    )
+}
