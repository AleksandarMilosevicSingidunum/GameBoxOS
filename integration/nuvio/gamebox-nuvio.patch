-    <string name="playback_buffer_max_sub">Quantité maximale de contenu à mettre en mémoire tampon. Doit être au moins égale à la durée minimale. Des valeurs plus élevées utilisent plus de mémoire, mais offrent une lecture plus fluide sur les connexions instables.</string>
-    <string name="playback_buffer_value_same_as_min">%1$d s (identique au minimum)</string>
-    <string name="playback_buffer_initial">Mémoire tampon initiale</string>
-    <string name="playback_buffer_initial_sub">Quantité de contenu à mettre en mémoire tampon avant le démarrage de la lecture. Des valeurs plus faibles accélèrent le démarrage, mais peuvent provoquer des saccades initiales sur les connexions lentes.</string>
-    <string name="playback_buffer_after_rebuffer">Mémoire tampon après interruption</string>
-    <string name="playback_buffer_after_rebuffer_sub">Quantité de contenu à mettre en mémoire tampon après une interruption de la lecture due à la mise en mémoire tampon. Des valeurs plus élevées réduisent les interruptions répétées.</string>
-    <string name="playback_buffer_back">Durée de la mémoire tampon arrière</string>
-    <string name="playback_buffer_back_sub">Quantité de contenu déjà lu à garder en mémoire. Permet un retour arrière rapide sans nouveau téléchargement. Mettez 0 pour désactiver et économiser de la mémoire.</string>
-    <string name="playback_buffer_back_reserve">Réserve environ %1$d Mo en plus de la taille de mémoire tampon cible. Augmenter la durée maximale de mémoire tampon réduit cette réserve sans perdre de durée de mémoire tampon arrière.</string>
-    <string name="playback_buffer_managed">Budget mémoire géré</string>
-    <string name="playback_buffer_managed_sub">Limite la mémoire tampon à une part sûre de la mémoire de cet appareil. Désactivez cette option pour définir vous-même la taille de mémoire tampon cible (avancé&#160;: des valeurs élevées peuvent faire planter les appareils à faible mémoire).</string>
-    <string name="playback_buffer_target">Taille de mémoire tampon cible</string>
-    <string name="playback_buffer_target_sub">RAM maximale utilisée pour la mise en mémoire tampon anticipée. Le maximum est calculé d’après la mémoire disponible de votre appareil (la limite de tas par application d’Android)&#160;; les appareils dotés de plus de RAM débloquent donc automatiquement des plafonds plus élevés.</string>
-    <string name="playback_buffer_target_managed_hint">Géré par le budget mémoire de l’appareil. Désactivez «&#160;Budget mémoire géré&#160;» pour définir cette valeur.</string>
-    <string name="playback_buffer_target_warning">Attention&#160;: au-dessus de la limite de sécurité de l’appareil (%1$d Mo). L’application peut planter pendant la lecture.</string>
-    <string name="playback_buffer_target_danger_warning">Danger&#160;: au-dessus de la limite d’avertissement (%1$d Mo). Risque élevé de plantage.</string>
-    <string name="playback_buffer_allow_large">Autoriser une mémoire tampon cible plus grande</string>
-    <string name="playback_buffer_allow_large_sub">Supprime le plafond lié à la mémoire de l’appareil sur le curseur de taille de mémoire tampon cible et autorise des valeurs jusqu’à 2 Go. Peut provoquer des plantages sur les appareils disposant de moins de 2 Go de RAM.</string>
-    <string name="playback_cache_header">Cache disque</string>
-    <string name="playback_cache_vod">Cache disque VOD</string>
-    <string name="playback_cache_vod_sub">Conserve sur le disque les octets téléchargés pour le flux en cours. Étend le retour arrière instantané au-delà de la mémoire tampon arrière et résiste aux brèves coupures réseau. S’applique uniquement aux flux progressifs (pas HLS/DASH).</string>
-    <string name="playback_cache_auto_size">Taille automatique</string>
-    <string name="playback_cache_auto_size_sub">Lorsque cette option est activée, la taille du cache est calculée d’après l’espace disque libre. Désactivez-la pour choisir une taille manuellement.</string>
-    <string name="playback_cache_vod_size">Taille du cache VOD</string>
