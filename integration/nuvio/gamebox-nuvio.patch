+                        title = "Clear Double Click Assignment",
+                        subtitle = "Set Double Click to Not Assigned",
+                        onClick = { onClearAction(ButtonPressType.DOUBLE_PRESS) }
+                    )
+                }
+            }
+
+            item(key = "edit_long") {
+                DialogOptionCard(
+                    title = "Long Press",
