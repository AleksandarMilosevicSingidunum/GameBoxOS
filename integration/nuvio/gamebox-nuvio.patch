-<string name="playback_external_send_skip_segments">Posielaj časové značky úvodu a záveru</string>
-<string name="playback_external_send_skip_segments_sub">Posielaj vyriešené časové značky preskakovania úvodu/záveru do externého prehrávača na automatické preskakovanie. Funguje iba v prehrávačoch, ktoré to podporujú; ostatné prehrávače to ignorujú.</string>
-<string name="video_section">Video</string>
-<string name="audio_force_optical_passthrough">Vynútiť transkódovanie do AC-3 (optika/SPDIF)</string>
-<string name="audio_force_optical_passthrough_sub">Transkóduje viackanálové formáty (TrueHD, DTS, AAC atď.) do Dolby Digital 5.1 v reálnom čase pre optické/SPDIF pripojenia.</string>
-<string name="dv7_handling_title">Spracovanie Dolby Vision</string>
-<string name="dv7_handling_dialog_subtitle">Vyberte, ako sa budú streamy Dolby Vision spracovávať počas prehrávania.</string>
-<string name="dv7_mode_auto">Automaticky (odporúčané)</string>
-<string name="dv7_mode_auto_desc">Rozpozná obrazovku a vybootuje najlepší režim. Ak sa vyskytnú problémy, skúste základnú vrstvu HDR10.</string>
-<string name="dv7_mode_hdr10_base_layer">Základná vrstva HDR10</string>
-<string name="dv7_mode_hdr10_base_layer_desc">Ignorovať údaje vylepšenia Dolby Vision. Môže pomôcť na zariadeniach, ktoré podporujú HDR, ale majú problémy s DV Profile 7.</string>
-<string name="dv7_mode_dv81_libdovi">Kovertovať na DV8.1</string>
-<string name="dv7_mode_dv81_libdovi_desc">Konvertovať DV7 na jednovrstvový profil DV8.1. Vyžaduje obrazovku s podporou Dolby Vision.</string>
-<string name="dv7_mode_off">Vypnuté (natívne)</string>
-<string name="dv7_mode_off_desc">Odosielať DV7 bez zmien. Môže zlyhať na hardvéri, ktorý nepodporuje DV Profile 7.</string>
-<string name="dv7_mode_strip_dv">Vždy odstrániť DV</string>
-<string name="dv7_mode_strip_dv_desc">Odstráni vrstvu Dolby Vision RPU zo všetkých streamov.</string>
-<string name="audio_dv5_to_dv81_title">Konvertovať DV5 na DV8.1</string>
-<string name="audio_dv5_to_dv81_sub">Označí streamy Profile 5 ako Profile 8.1 pre výstup kompatibilný s HDR10. Pomáha na zariadeniach bez natívneho dekodéra DV5.</string>
-<string name="audio_strip_hdr10plus_title">Odstrániť metadáta HDR10+</string>
-<string name="audio_strip_hdr10plus_sub">Odstráni dynamické metadáta HDR10+ zo streamov. Ak je zároveň zapnutá konverzia na DV8.1, odstránenie prebehne až po konverzii.</string>
-<string name="audio_dv7_preserve_mapping_title">Zachovať mapovanie DV (DV7 na DV8.1)</string>
-<string name="audio_dv7_preserve_mapping_sub">Zachováva pôvodné mapovanie tónov určené tvorcom za cenu mierne vyššej záťaže pri spracovaní snímok.</string>
-<string name="dv7_libdovi_mode_caption">Režim konverzie (vybraný automaticky). Vyberte pre vynútenie; Žiadny použije automatiku. Aktívne len pri spracovaní DV7 nastavenom na Konvertovať na DV8.1.</string>
-<string name="dv7_libdovi_mode_row_title">Režim konverzie</string>
-<string name="dv7_libdovi_mode_none_title">Žiadny</string>
-<string name="dv7_libdovi_mode_none_sub">Bez prepísania. Použije sa automaticky vybraný režim konverzie.</string>
-<string name="dv7_libdovi_mode_0_title">Režim 0 — Kopírovať (bez konverzie)</string>
-<string name="dv7_libdovi_mode_0_sub">Analyzovať RPU a zapísať ho späť bez zmien. Bez konverzie profilu.</string>
-<string name="dv7_libdovi_mode_1_title">Režim 1 — MEL</string>
-<string name="dv7_libdovi_mode_1_sub">Konvertovať RPU na tvar kompatibilný s MEL (Minimum Enhancement Layer).</string>
-<string name="dv7_libdovi_mode_2_title">Režim 2 — 8.1 (bez mapovacích operácií)</string>
-<string name="dv7_libdovi_mode_2_sub">Konvertovať na profil 8.1 s mapovaním jasu a chrominancie bez dodatočných operácií. Štandardná konverzia.</string>
-<string name="dv7_libdovi_mode_3_title">Režim 3 — Profile 5 na 8.1</string>
-<string name="dv7_libdovi_mode_3_sub">Konvertovať streamy Profile 5 (DV5) na Profile 8.1. Rovnaká konverzia, akú používa prepínač Konvertovať DV5 na DV8.1.</string>
-<string name="dv7_libdovi_mode_4_title">Režim 4 — 8.4 (statický)</string>
