+@Composable
+private fun InstalledAppOptionRow(
+    app: InstalledApp,
+    selected: Boolean,
+    modifier: Modifier = Modifier,
+    onClick: () -> Unit
+) {
+    val context = androidx.compose.ui.platform.LocalContext.current
+    val iconBitmap by androidx.compose.runtime.produceState<androidx.compose.ui.graphics.ImageBitmap?>(null, app.packageName) {
+        value = withContext(Dispatchers.Default) {
+            runCatching {
