+
+internal object HmacSha256 {
+    fun digest(key: ByteArray, value: String): ByteArray {
+        val mac = Mac.getInstance("HmacSHA256")
+        mac.init(SecretKeySpec(key, "HmacSHA256"))
+        return mac.doFinal(value.toByteArray(Charsets.UTF_8))
