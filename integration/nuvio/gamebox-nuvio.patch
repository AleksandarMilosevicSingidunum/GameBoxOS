-    <string name="playback_buffer_header">Buferis</string>
-    <string name="playback_buffer_warning">Šie nustatymai veikia buferio pildymą. Netinkamos reikšmės gali sukelti atkūrimo problemų.</string>
-    <string name="playback_buffer_min">Mažiausia buferio trukmė</string>
-    <string name="playback_buffer_min_sub">Mažiausias į buferį įkeliamo turinio kiekis. Leistuvas stengsis visada turėti bent tiek turinio į priekį nuo dabartinės atkūrimo vietos.</string>
-    <string name="playback_buffer_max">Didžiausia buferio trukmė</string>
-    <string name="playback_buffer_max_sub">Didžiausias į buferį įkeliamo turinio kiekis. Turi būti ne mažesnis už mažiausią buferio trukmę. Didesnės reikšmės naudoja daugiau atminties, tačiau užtikrina sklandesnį atkūrimą esant nestabiliam ryšiui.</string>
-    <string name="playback_buffer_value_same_as_min">%1$ds (tiek pat, kiek mažiausia)</string>
-    <string name="playback_buffer_initial">Pradinis buferis</string>
-    <string name="playback_buffer_initial_sub">Kiek turinio turi būti įkelta į buferį prieš pradedant atkurti. Mažesnės reikšmės leidžia pradėti greičiau, tačiau esant lėtam ryšiui iš pradžių vaizdas gali strigti.</string>
-    <string name="playback_buffer_after_rebuffer">Buferis po pakartotinio pildymo</string>
-    <string name="playback_buffer_after_rebuffer_sub">Kiek turinio įkelti į buferį, kai atkūrimas sustoja dėl buferio pildymo. Didesnės reikšmės sumažina pasikartojančius pertrūkius dėl buferio pildymo.</string>
-    <string name="playback_buffer_back">Atgalinio buferio trukmė</string>
-    <string name="playback_buffer_back_sub">Kiek jau atkurto turinio laikyti atmintyje. Leidžia greitai atsukti neatsisiunčiant iš naujo. Nustatykite 0, jei norite išjungti ir taupyti atmintį.</string>
-    <string name="playback_buffer_back_reserve">Papildomai prie tikslinio buferio rezervuojama ~%1$dMB. Padidinus didžiausią buferio trukmę, šis rezervas sumažėja neprarandant atgalinio buferio trukmės.</string>
-    <string name="playback_buffer_managed">Valdomas atminties limitas</string>
-    <string name="playback_buffer_managed_sub">Apriboja buferį iki saugios įrenginio atminties dalies. Išjunkite, jei norite patys nustatyti tikslinį buferio dydį (pažengusiems: nustačius dideles reikšmes, programa gali nulūžti įrenginiuose, kuriuose mažai atminties).</string>
-    <string name="playback_buffer_target">Tikslinis buferio dydis</string>
-    <string name="playback_buffer_target_sub">Didžiausias RAM kiekis turiniui į priekį buferizuoti. Riba apskaičiuojama pagal įrenginio atmintį (Android vienai programai nustatytą kaupo ribą), todėl daugiau RAM turinčiuose įrenginiuose automatiškai leidžiamos didesnės ribos.</string>
-    <string name="playback_buffer_target_managed_hint">Valdoma pagal įrenginio atminties limitą. Norėdami keisti, išjunkite valdomą atminties limitą.</string>
-    <string name="playback_buffer_target_warning">Įspėjimas: viršyta saugi įrenginio riba (%1$d MB). Atkuriant programa gali nulūžti.</string>
-    <string name="playback_buffer_target_danger_warning">Pavojus: viršyta įspėjimo riba (%1$d MB). Didelė programos strigties rizika.</string>
-    <string name="playback_buffer_allow_large">Leisti didesnį tikslinį buferį</string>
-    <string name="playback_buffer_allow_large_sub">Pašalina įrenginio atminties ribą nuo tikslinio buferio dydžio slankiklio ir leidžia pasirinkti iki 2GB. Programa gali nulūžti įrenginiuose, kuriuose mažiau nei 2GB RAM.</string>
-    <string name="playback_cache_header">Disko podėlis</string>
-    <string name="playback_cache_vod">VOD disko podėlis</string>
-    <string name="playback_cache_vod_sub">Išsaugo dabartinio srauto atsisiųstus baitus diske. Leidžia akimirksniu atsukti toliau nei atminties atgalinis buferis ir išlaiko duomenis trumpam nutrūkus ryšiui. Taikoma tik progresyviems srautams (ne HLS/DASH).</string>
