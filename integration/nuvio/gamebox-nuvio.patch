+package com.gamebox.os.companion
+
+/** Minimal, read-only library data suitable for a paired companion device. */
+data class CompanionLibraryItem(
+    val id: String,
+    val title: String,
+    val platform: String,
+    val installState: String,
+    val favorite: Boolean,
+    val minutesPlayed: Int,
+    val savePresent: Boolean,
+)
+
+object CompanionLibraryRoute {
+    const val PATH = "/v1/library"
+
+    fun handle(
+        method: String,
+        path: String,
+        authorization: String?,
+        pairingSecret: String?,
+        library: List<CompanionLibraryItem>,
+        nowUnixTimeSeconds: Long,
+    ): CompanionHttpResponse {
+        if (method.uppercase() != "GET" || path != PATH) return CompanionHttpResponse(404, """{"error":"not_found"}""")
+        if (pairingSecret.isNullOrBlank() ||
+            !CompanionProtocol.verifyAuthorization(pairingSecret, method, path, authorization, nowUnixTimeSeconds)
+        ) return CompanionHttpResponse(401, """{"error":"unauthorized"}""")
+        return CompanionHttpResponse(200, """{"protocolVersion":${CompanionProtocol.VERSION},"games":[${library.joinToString(",") { it.toJson() }}]}""")
+    }
+
+    private fun CompanionLibraryItem.toJson() =
+        """{"id":"${id.companionJsonEscape()}","title":"${title.companionJsonEscape()}","platform":"${platform.companionJsonEscape()}","installState":"${installState.companionJsonEscape()}","favorite":$favorite,"minutesPlayed":${minutesPlayed.coerceAtLeast(0)},"savePresent":$savePresent}"""
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/companion/CompanionProtocol.kt b/app/src/gamebox/java/com/gamebox/os/companion/CompanionProtocol.kt
new file mode 100644
index 0000000..5a6fd4b
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/companion/CompanionProtocol.kt
@@ -0,0 +1,101 @@
+package com.gamebox.os.companion
+
+import java.nio.charset.StandardCharsets
+import java.security.SecureRandom
+import java.util.LinkedHashMap
+import javax.crypto.Mac
+import javax.crypto.spec.SecretKeySpec
+
+/** Shared authenticated request format for the paired Windows companion endpoint. */
+object CompanionProtocol {
+    const val VERSION = 1
+    const val AUTHORIZATION_HEADER = "X-GameBox-Authorization"
+    private const val AUTHORIZATION_VERSION = 2
+    private val random = SecureRandom()
+
+    fun createAuthorization(
+        secret: String,
+        method: String,
+        requestPath: String,
+        unixTimeSeconds: Long,
+        bodySha256: String? = null,
+        nonce: String = newNonce(),
+    ): String {
+        require(validSecret(secret)) { "Pairing secret is invalid" }
+        require(method.isNotBlank()) { "Method is required" }
+        require(requestPath.startsWith('/') && !requestPath.contains("..")) {
+            "Request path must be absolute and traversal-free"
+        }
+        require(unixTimeSeconds > 0) { "Timestamp is required" }
+        require(bodySha256 == null || validSha256(bodySha256)) { "Body checksum is invalid" }
+        require(validNonce(nonce)) { "Request nonce is invalid" }
+        val basePayload = "v$AUTHORIZATION_VERSION\n${method.trim().uppercase()}\n$requestPath\n$unixTimeSeconds\n$nonce"
+        val payload = bodySha256?.let { "$basePayload\n${it.lowercase()}" } ?: basePayload
+        val mac = Mac.getInstance("HmacSHA256")
+        mac.init(SecretKeySpec(hexToBytes(secret), "HmacSHA256"))
+        return "v$AUTHORIZATION_VERSION:$unixTimeSeconds:$nonce:${mac.doFinal(payload.toByteArray(StandardCharsets.UTF_8)).toHex()}"
+    }
+
+    fun verifyAuthorization(
+        secret: String,
+        method: String,
+        requestPath: String,
+        authorization: String?,
+        nowUnixTimeSeconds: Long,
+        allowedSkewSeconds: Long = 120,
+        bodySha256: String? = null,
+        acceptNonce: (String, Long) -> Boolean = { _, _ -> true },
+    ): Boolean {
+        if (!validSecret(secret) || authorization == null || allowedSkewSeconds < 0) return false
+        val parts = authorization.split(':')
+        if (parts.size != 4 || parts[0] != "v$AUTHORIZATION_VERSION" || !validNonce(parts[2])) return false
+        val timestamp = parts[1].toLongOrNull() ?: return false
+        if (kotlin.math.abs(nowUnixTimeSeconds - timestamp) > allowedSkewSeconds) return false
+        val authenticated = runCatching {
+            val expected = createAuthorization(secret, method, requestPath, timestamp, bodySha256, parts[2])
+            constantTimeEquals(expected, authorization)
+        }.getOrDefault(false)
+        return authenticated && runCatching { acceptNonce(parts[2], timestamp) }.getOrDefault(false)
+    }
+
+    private fun newNonce(): String = ByteArray(16).also(random::nextBytes).toHex()
+
+    private fun validSecret(value: String): Boolean = value.length == 64 && value.all { it.isDigit() || it.lowercaseChar() in 'a'..'f' }
+    private fun validSha256(value: String): Boolean =
+        value.length == 64 && value.all { it.isDigit() || it.lowercaseChar() in 'a'..'f' }
+    private fun validNonce(value: String): Boolean =
+        value.length == 32 && value.all { it.isDigit() || it.lowercaseChar() in 'a'..'f' }
+
+    private fun hexToBytes(value: String): ByteArray = ByteArray(value.length / 2) { index ->
+        value.substring(index * 2, index * 2 + 2).toInt(16).toByte()
+    }
+
+    private fun ByteArray.toHex(): String = joinToString("") { "%02x".format(it.toInt() and 0xff) }
+
+    private fun constantTimeEquals(left: String, right: String): Boolean {
+        val leftBytes = left.toByteArray(StandardCharsets.UTF_8)
+        val rightBytes = right.toByteArray(StandardCharsets.UTF_8)
+        if (leftBytes.size != rightBytes.size) return false
+        var difference = 0
+        leftBytes.indices.forEach { index -> difference = difference or (leftBytes[index].toInt() xor rightBytes[index].toInt()) }
+        return difference == 0
+    }
+}
+
+/** Bounded per-service replay window; authenticated requests only consume a nonce once. */
+internal class CompanionAuthorizationReplayGuard(
+    private val maxEntries: Int = 4_096,
+) {
+    private val seen = LinkedHashMap<String, Long>()
+
+    init { require(maxEntries > 0) }
+
+    @Synchronized
+    fun accept(nonce: String, timestamp: Long, nowUnixTimeSeconds: Long): Boolean {
+        seen.entries.removeAll { it.value < nowUnixTimeSeconds - 120 }
+        if (nonce in seen || seen.size >= maxEntries) return false
+        seen[nonce] = timestamp
+        return true
+    }
+}
+
diff --git a/app/src/gamebox/java/com/gamebox/os/companion/CompanionRemotePairing.kt b/app/src/gamebox/java/com/gamebox/os/companion/CompanionRemotePairing.kt
new file mode 100644
index 0000000..ae1cf96
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/companion/CompanionRemotePairing.kt
@@ -0,0 +1,128 @@
+package com.gamebox.os.companion
+
+import java.security.SecureRandom
+import java.net.Inet4Address
+import java.net.Inet6Address
+import java.net.InetAddress
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.contentOrNull
+
+internal class CompanionRemotePairingWindow(
+    private val nowMillis: () -> Long = System::currentTimeMillis,
+    private val random: SecureRandom = SecureRandom(),
+) {
+    private var code: String? = null
+    private var expiresAtMillis = 0L
+    private var attempts = 0
+
+    @Synchronized
+    fun open(): String {
+        code = (random.nextInt(1_000_000)).toString().padStart(6, '0')
+        expiresAtMillis = nowMillis() + PAIRING_WINDOW_MILLIS
+        attempts = 0
+        return requireNotNull(code)
+    }
+
+    @Synchronized
+    fun remainingSeconds(): Long = ((expiresAtMillis - nowMillis()).coerceAtLeast(0) + 999) / 1_000
+
+    @Synchronized
+    fun close() = clear()
+
+    @Synchronized
+    fun consume(candidate: String): Boolean {
+        val expected = code ?: return false
+        if (nowMillis() >= expiresAtMillis || attempts >= MAX_ATTEMPTS) {
+            clear()
+            return false
+        }
+        attempts++
+        if (candidate != expected || candidate.length != 6 || candidate.any { !it.isDigit() }) {
+            if (attempts >= MAX_ATTEMPTS) clear()
+            return false
+        }
+        clear()
+        return true
+    }
+
+    @Synchronized
+    private fun clear() {
+        code = null
+        expiresAtMillis = 0L
+        attempts = 0
+    }
+
+    private companion object {
+        const val PAIRING_WINDOW_MILLIS = 120_000L
+        const val MAX_ATTEMPTS = 5
+    }
+}
+
+internal object ActiveCompanionRemotePairing {
+    internal val window = CompanionRemotePairingWindow()
+    fun open(): String = window.open()
+    fun remainingSeconds(): Long = window.remainingSeconds()
+    fun consume(code: String): Boolean = window.consume(code)
+    fun close() = window.close()
+}
+
+internal object CompanionRemoteControlRouteLock {
+    private val lock = Any()
+
+    fun <T> withLock(block: () -> T): T = synchronized(lock, block)
+}
+
+internal object CompanionPeerPolicy {
+    fun isLocalNetwork(address: InetAddress): Boolean {
+        if (address.isLoopbackAddress || address.isLinkLocalAddress) return true
+        return when (address) {
+            is Inet4Address -> {
+                val bytes = address.address.map { it.toInt() and 0xff }
+                bytes[0] == 10 || bytes[0] == 192 && bytes[1] == 168 ||
+                    bytes[0] == 172 && bytes[1] in 16..31
+            }
+            is Inet6Address -> (address.address[0].toInt() and 0xfe) == 0xfc
+            else -> false
+        }
+    }
+}
+
+internal object CompanionRemotePairRoute {
+    const val PATH = "/v1/pair/remote"
+    private val json = Json { ignoreUnknownKeys = false }
+
+    fun handle(
+        request: CompanionHttpRequest,
+        pairingWindow: CompanionRemotePairingWindow = ActiveCompanionRemotePairing.window,
+        createToken: () -> String,
+        revokeToken: () -> Unit = {},
+    ): CompanionHttpResponse {
+        if (request.path != PATH) {
+            return CompanionHttpResponse(404, """{"error":"not_found"}""")
+        }
+        if (request.method == "DELETE" && request.bodyLength == 0L) {
+            revokeToken()
+            return CompanionHttpResponse(200, """{"revoked":true}""")
+        }
+        if (request.method != "PUT" || request.bodyLength !in 1..128) {
+            return CompanionHttpResponse(400, """{"error":"invalid_pairing_request"}""")
+        }
+        val candidate = runCatching {
+                json.parseToJsonElement(request.body.toString(Charsets.UTF_8)).jsonObject
+                    .also { require(it.keys == setOf("code")) }
+                    .getValue("code").jsonPrimitive.contentOrNull.orEmpty()
+            }.getOrDefault("")
+        if (!pairingWindow.consume(candidate)) {
+            return CompanionHttpResponse(401, """{"error":"pairing_rejected"}""")
+        }
+        val token = runCatching(createToken).getOrElse {
+            return CompanionHttpResponse(500, """{"error":"pairing_failed"}""")
+        }
+        if (!token.matches(Regex("[0-9a-fA-F]{64}"))) {
+            return CompanionHttpResponse(500, """{"error":"pairing_failed"}""")
+        }
+        return CompanionHttpResponse(200, """{"token":"$token"}""")
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/companion/CompanionRemoteRoute.kt b/app/src/gamebox/java/com/gamebox/os/companion/CompanionRemoteRoute.kt
new file mode 100644
index 0000000..963ad30
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/companion/CompanionRemoteRoute.kt
@@ -0,0 +1,135 @@
+package com.gamebox.os.companion
+
+import android.view.KeyEvent
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.serialization.json.Json
+import kotlinx.serialization.json.jsonObject
+import kotlinx.serialization.json.jsonPrimitive
+import kotlinx.serialization.json.contentOrNull
+
+internal sealed interface CompanionRemoteCommand {
+    data class Key(val keyCode: Int) : CompanionRemoteCommand
+    data object Back : CompanionRemoteCommand
+    data class Text(val value: String) : CompanionRemoteCommand
+    data object Home : CompanionRemoteCommand
+    data object GameBox : CompanionRemoteCommand
+    data object Backspace : CompanionRemoteCommand
+}
+
+internal object CompanionRemoteCommandBus {
+    private data class Target(
+        val externalDisplay: Boolean,
+        val priority: Int,
+        val mutableCommands: MutableSharedFlow<CompanionRemoteCommand>,
+        var resumed: Boolean = false,
+        var textEntryAvailable: Boolean = false,
+    )
+
+    private val lock = Any()
+    private val targets = mutableMapOf<Any, Target>()
+
+    fun register(
+        owner: Any,
+        externalDisplay: Boolean,
+        commands: MutableSharedFlow<CompanionRemoteCommand>,
+        priority: Int = 0,
+    ) {
+        synchronized(lock) { targets[owner] = Target(externalDisplay, priority, commands) }
+    }
+
+    fun unregister(owner: Any) {
+        synchronized(lock) { targets.remove(owner) }
+    }
+
+    fun setHostState(owner: Any, resumed: Boolean, textEntryAvailable: Boolean) {
+        synchronized(lock) {
+            targets[owner]?.let {
+                it.resumed = resumed
+                it.textEntryAvailable = textEntryAvailable
+            }
+        }
+    }
+
+    fun isTextEntryAvailable(): Boolean = synchronized(lock) {
+        activeTarget()?.textEntryAvailable == true
+    }
+
+    fun publish(command: CompanionRemoteCommand): Boolean = synchronized(lock) {
+        val target = activeTarget() ?: return false
+        if ((command is CompanionRemoteCommand.Text || command == CompanionRemoteCommand.Backspace) &&
+            !target.textEntryAvailable
+        ) return false
+        target.mutableCommands.subscriptionCount.value > 0 && target.mutableCommands.tryEmit(command)
+    }
+
+    private fun activeTarget(): Target? = targets.values
+        .asSequence()
+        .filter(Target::resumed)
+        .maxWithOrNull(compareBy<Target>({ it.externalDisplay }, Target::priority))
+}
+
+internal object CompanionRemoteRoute {
+    const val PATH = "/v1/remote"
+    private const val MAX_TEXT_LENGTH = 128
+    private val json = Json { ignoreUnknownKeys = false }
+    private val keys = mapOf(
+        "up" to KeyEvent.KEYCODE_DPAD_UP,
+        "down" to KeyEvent.KEYCODE_DPAD_DOWN,
+        "left" to KeyEvent.KEYCODE_DPAD_LEFT,
+        "right" to KeyEvent.KEYCODE_DPAD_RIGHT,
+        "select" to KeyEvent.KEYCODE_DPAD_CENTER,
+        "play_pause" to KeyEvent.KEYCODE_MEDIA_PLAY_PAUSE,
+    )
+
+    fun handle(
+        request: CompanionHttpRequest,
+        pairingSecret: String?,
+        nowUnixTimeSeconds: Long,
+        acceptNonce: (String, Long) -> Boolean,
+        textEntryAvailable: () -> Boolean = { true },
+        publish: (CompanionRemoteCommand) -> Boolean,
+    ): CompanionHttpResponse {
+        if (request.path != PATH) {
+            return CompanionHttpResponse(404, """{"error":"not_found"}""")
+        }
+        if (request.method == "GET" && request.bodyLength == 0L) {
+            if (pairingSecret.isNullOrBlank() || !CompanionProtocol.verifyAuthorization(
+                    pairingSecret, request.method, request.path, request.authorization, nowUnixTimeSeconds,
+                    acceptNonce = acceptNonce,
+                )) return CompanionHttpResponse(401, """{"error":"unauthorized"}""")
+            return CompanionHttpResponse(200, """{"status":"ready"}""")
+        }
+        if (request.method != "PUT" || request.bodyLength !in 1..512) {
+            return CompanionHttpResponse(404, """{"error":"not_found"}""")
+        }
+        if (pairingSecret.isNullOrBlank() || !CompanionProtocol.verifyAuthorization(
+                pairingSecret, request.method, request.path, request.authorization,
+                nowUnixTimeSeconds, bodySha256 = request.bodySha256, acceptNonce = acceptNonce,
+            )) {
+            return CompanionHttpResponse(401, """{"error":"unauthorized"}""")
+        }
+        val command = runCatching {
+            val obj = json.parseToJsonElement(request.body.toString(Charsets.UTF_8)).jsonObject
+            require(obj.keys.all { it in setOf("action", "text") })
+            val action = obj["action"]?.jsonPrimitive?.contentOrNull ?: error("action required")
+            when (action) {
+                "back" -> CompanionRemoteCommand.Back
+                "home" -> CompanionRemoteCommand.Home
+                "gamebox" -> CompanionRemoteCommand.GameBox
+                "backspace" -> CompanionRemoteCommand.Backspace
+                "text" -> {
+                    val value = obj["text"]?.jsonPrimitive?.contentOrNull
+                        ?: error("text required")
+                    require(value.isNotEmpty() && value.length <= MAX_TEXT_LENGTH && value.none(Char::isISOControl))
+                    CompanionRemoteCommand.Text(value)
+                }
+                else -> CompanionRemoteCommand.Key(keys[action] ?: error("unsupported action"))
+            }
+        }.getOrNull() ?: return CompanionHttpResponse(400, """{"error":"invalid_command"}""")
+        if ((command is CompanionRemoteCommand.Text || command == CompanionRemoteCommand.Backspace) && !textEntryAvailable()) {
+            return CompanionHttpResponse(409, """{"error":"search_not_active","message":"Open a GameBox search field before editing text."}""")
+        }
+        return if (publish(command)) CompanionHttpResponse(200, """{"accepted":true}""")
+        else CompanionHttpResponse(503, """{"error":"gamebox_unavailable"}""")
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/companion/CompanionSaveRoute.kt b/app/src/gamebox/java/com/gamebox/os/companion/CompanionSaveRoute.kt
