+internal val LocalFocusDebugRegistry = staticCompositionLocalOf<FocusDebugRegistry?> { null }
+
+internal enum class FocusDirection(val label: String) {
+    UP("up"), DOWN("down"), LEFT("left"), RIGHT("right")
+}
+
+@Stable
+internal class FocusDebugRegistry {
+    private var nextId by mutableIntStateOf(1)
+    val nodes = mutableStateMapOf<Int, Rect>()
+    var focusedId by mutableStateOf<Int?>(null)
+        private set
+
+    fun allocateId(): Int = nextId++
+
+    fun update(id: Int, bounds: Rect) {
+        nodes[id] = bounds
+    }
+
+    fun focus(id: Int, focused: Boolean) {
+        if (focused) focusedId = id else if (focusedId == id) focusedId = null
+    }
+
+    fun remove(id: Int) {
+        nodes.remove(id)
+        if (focusedId == id) focusedId = null
+    }
+
+    fun neighbor(direction: FocusDirection): Int? {
+        val sourceId = focusedId ?: return null
+        val source = nodes[sourceId] ?: return null
+        val origin = source.center
+        return nodes.asSequence()
+            .filter { (id, bounds) ->
+                id != sourceId && when (direction) {
+                    FocusDirection.UP -> bounds.center.y < origin.y
+                    FocusDirection.DOWN -> bounds.center.y > origin.y
+                    FocusDirection.LEFT -> bounds.center.x < origin.x
+                    FocusDirection.RIGHT -> bounds.center.x > origin.x
+                }
+            }
+            .minByOrNull { (_, bounds) ->
+                val delta = bounds.center - origin
+                when (direction) {
+                    FocusDirection.UP, FocusDirection.DOWN -> abs(delta.y) + abs(delta.x) * 2f
+                    FocusDirection.LEFT, FocusDirection.RIGHT -> abs(delta.x) + abs(delta.y) * 2f
+                }
+            }?.key
+    }
+}
+
+internal fun Modifier.focusDebugTarget(): Modifier = composed {
+    val registry = LocalFocusDebugRegistry.current
+    if (registry == null) return@composed this
+    val id = androidx.compose.runtime.remember(registry) { registry.allocateId() }
+    DisposableEffect(registry, id) {
+        onDispose { registry.remove(id) }
+    }
+    this
+        .onGloballyPositioned { registry.update(id, it.boundsInRoot()) }
+        .onFocusChanged { registry.focus(id, it.isFocused) }
+}
+
+@Composable
+internal fun FocusDebugOverlay(registry: FocusDebugRegistry) {
+    val focusedId = registry.focusedId
+    val bounds = focusedId?.let(registry.nodes::get)
+    Box(
+        Modifier
+            .fillMaxSize()
+            .semantics { contentDescription = "Focus diagnostics overlay" }
+    ) {
+        if (bounds != null) {
+            Canvas(Modifier.fillMaxSize()) {
+                drawRect(
+                    color = Color(0xFFFFC857),
+                    topLeft = Offset(bounds.left, bounds.top),
+                    size = bounds.size,
+                    style = Stroke(width = 3.dp.toPx()),
+                )
+            }
+        }
+        Surface(
+            modifier = Modifier.align(Alignment.TopEnd).padding(12.dp),
+            color = Color(0xE6121724),
+            contentColor = Color.White,
+            shape = MaterialTheme.shapes.small,
+            shadowElevation = 8.dp,
+        ) {
+            val lines = if (focusedId == null || bounds == null) {
+                "FOCUS DEBUG\nNo focused Blueprint control"
+            } else {
+                buildString {
+                    append("FOCUS DEBUG  control-").append(focusedId)
+                    append("\nBounds: ")
+                    append(bounds.left.toInt()).append(", ").append(bounds.top.toInt())
+                    append("  ").append(bounds.width.toInt()).append("×").append(bounds.height.toInt())
+                    FocusDirection.entries.forEach { direction ->
+                        append("\n").append(direction.label.uppercase()).append(": ")
+                        append(registry.neighbor(direction)?.let { "control-$it" } ?: "—")
+                    }
+                }
+            }
+            Text(lines, modifier = Modifier.padding(12.dp), style = MaterialTheme.typography.labelSmall)
+        }
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/ui/GameBoxApp.kt b/app/src/gamebox/java/com/gamebox/os/ui/GameBoxApp.kt
new file mode 100644
index 0000000..eeafcb3
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/ui/GameBoxApp.kt
@@ -0,0 +1,363 @@
+@file:OptIn(androidx.compose.foundation.layout.ExperimentalLayoutApi::class)
+
+package com.gamebox.os.ui
+
+import androidx.activity.compose.BackHandler
+import androidx.activity.compose.LocalActivity
+import androidx.compose.foundation.layout.*
+import androidx.compose.material.icons.Icons
+import androidx.compose.material.icons.rounded.*
+import androidx.compose.material3.*
+import androidx.compose.runtime.*
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.platform.LocalContext
+import androidx.compose.ui.platform.LocalView
+import androidx.compose.ui.platform.LocalFocusManager
+import androidx.compose.ui.platform.LocalSoftwareKeyboardController
+import androidx.compose.ui.focus.FocusRequester
+import androidx.compose.ui.focus.onFocusChanged
+import androidx.compose.ui.Alignment
+import androidx.compose.ui.unit.dp
+import androidx.compose.ui.unit.sp
+import androidx.lifecycle.Lifecycle
+import androidx.lifecycle.LifecycleEventObserver
+import androidx.lifecycle.LifecycleOwner
+import android.view.KeyEvent
+import com.gamebox.os.data.AppContainer
+import com.gamebox.os.domain.GameId
+import com.gamebox.os.navigation.GameBoxNavigationRequest
+import kotlinx.coroutines.flow.MutableSharedFlow
+import kotlinx.coroutines.launch
+
+@Composable
+fun GameBoxApp(
+    container: AppContainer,
+    navigationRequest: GameBoxNavigationRequest? = null,
+    externalDisplayOverride: Boolean = false,
+    externalDisplayBottomInsetPx: Int = 0,
+    hostWindowHasFocus: Boolean = true,
+    textInputExitRequest: Int = 0,
+    initialDestinationOverride: String = Destination.HOME.name,
+    onDestinationSelected: ((String) -> Unit)? = null,
+) {
+    val focusManager = LocalFocusManager.current
+    val softwareKeyboard = LocalSoftwareKeyboardController.current
+    val repository = container.gameRepository
+    val gameLaunchController = container.gameLaunchController
+    val settingsRepository = container.settingsRepository
+    val games by repository.observeGames().collectAsState()
+    val appSettings by settingsRepository.settings.collectAsState(
+        initial = com.gamebox.os.settings.GameBoxSettings()
+    )
+    val context = LocalContext.current
+    val remoteInputView = LocalView.current
+    val hostActivity = LocalActivity.current
+    val browserDownloadStore = remember(context) {
+        (context.applicationContext as com.gamebox.os.GameBoxApplication).browserDownloadStore
+    }
+    val browserDownloadRecords by browserDownloadStore.records.collectAsState()
+    val downloadJobs by container.downloadRepository.observeJobs().collectAsState()
+    val downloadActivityCount = remember(downloadJobs, browserDownloadRecords) {
+        downloadActivityCount(
+            remoteStatuses = downloadJobs.map { it.status },
+            browserStatuses = browserDownloadRecords.map { it.status },
+        )
+    }
+    val allowDeveloperOptions = LocalContext.current.applicationInfo.flags and
+        android.content.pm.ApplicationInfo.FLAG_DEBUGGABLE != 0
+    val hostDisplayId = hostActivity?.window?.decorView?.display?.displayId
+        ?: LocalView.current.display?.displayId
+    // External HDMI/Desktop-mode surfaces are the living-room target even when
+    // the OEM reports them with the phone's high-density dp configuration.
+    val externalDisplay = externalDisplayOverride || (hostDisplayId != null &&
+        hostDisplayId != android.view.Display.DEFAULT_DISPLAY
+        )
+    val externalDisplayBottomInset = externalDisplayBottomInsetDp(
+        externalDisplay = externalDisplay,
+        bottomInsetPx = externalDisplayBottomInsetPx,
+        density = androidx.compose.ui.platform.LocalDensity.current.density,
+    ).dp
+    val runtimeDeviceStatus = rememberRuntimeDeviceStatus()
+    val controllerActions = remember { ControllerActionRegistry() }
+    val appScope = rememberCoroutineScope()
+    var showProfileSwitcher by remember { mutableStateOf(false) }
+    var showQuickActions by remember { mutableStateOf(false) }
+    var showSystemStatus by remember { mutableStateOf(false) }
+    var focusStoreSearchOnEnter by remember { mutableStateOf(false) }
+    val remoteTextOwner = remember { Any() }
+    val remoteCommands = remember {
+        MutableSharedFlow<com.gamebox.os.companion.CompanionRemoteCommand>(extraBufferCapacity = 32)
+    }
+    val hostLifecycle = (hostActivity as? LifecycleOwner)?.lifecycle
+    var hostResumed by remember(hostLifecycle) {
+        mutableStateOf(hostLifecycle?.currentState?.isAtLeast(Lifecycle.State.RESUMED) ?: true)
+    }
+    DisposableEffect(hostLifecycle) {
+        if (hostLifecycle == null) {
+            onDispose { }
+        } else {
+            val observer = LifecycleEventObserver { _, event ->
+                when (event) {
+                    Lifecycle.Event.ON_RESUME -> hostResumed = true
+                    Lifecycle.Event.ON_PAUSE, Lifecycle.Event.ON_STOP, Lifecycle.Event.ON_DESTROY -> hostResumed = false
+                    else -> Unit
+                }
+            }
+            hostLifecycle.addObserver(observer)
+            hostResumed = hostLifecycle.currentState.isAtLeast(Lifecycle.State.RESUMED)
+            onDispose { hostLifecycle.removeObserver(observer) }
+        }
+    }
+    DisposableEffect(remoteTextOwner, remoteCommands, externalDisplay) {
+        com.gamebox.os.companion.CompanionRemoteCommandBus.register(
+            remoteTextOwner,
+            externalDisplay,
+            remoteCommands,
+        )
+        onDispose { com.gamebox.os.companion.CompanionRemoteCommandBus.unregister(remoteTextOwner) }
+    }
+    SideEffect {
+        com.gamebox.os.companion.CompanionRemoteCommandBus.setHostState(
+            remoteTextOwner,
+            hostResumed,
+            false,
+        )
+    }
+    val selectedTabFocusRequester = remember { FocusRequester() }
+    val uiState = rememberGameBoxUiState(initialDestinationOverride)
+    val destination = runCatching { Destination.valueOf(uiState.destination) }
+        .getOrDefault(Destination.HOME)
+    fun openDestination(target: Destination) {
+        if (onDestinationSelected != null) onDestinationSelected(target.name)
+        else uiState.openDestination(target.name)
+    }
+    val selectedGameId = uiState.selectedGameId?.let(::GameId)
+    LaunchedEffect(remoteInputView, remoteCommands) {
+        remoteCommands.collect { command ->
+            when (command) {
+                is com.gamebox.os.companion.CompanionRemoteCommand.Key -> {
+                    val now = android.os.SystemClock.uptimeMillis()
+                    remoteInputView.dispatchKeyEvent(KeyEvent(now, now, KeyEvent.ACTION_DOWN, command.keyCode, 0))
+                    remoteInputView.dispatchKeyEvent(KeyEvent(now, android.os.SystemClock.uptimeMillis(), KeyEvent.ACTION_UP, command.keyCode, 0))
+                }
+                com.gamebox.os.companion.CompanionRemoteCommand.Back -> {
+                    val now = android.os.SystemClock.uptimeMillis()
+                    remoteInputView.dispatchKeyEvent(KeyEvent(now, now, KeyEvent.ACTION_DOWN, KeyEvent.KEYCODE_BUTTON_B, 0))
+                    remoteInputView.dispatchKeyEvent(KeyEvent(now, android.os.SystemClock.uptimeMillis(), KeyEvent.ACTION_UP, KeyEvent.KEYCODE_BUTTON_B, 0))
+                }
+                is com.gamebox.os.companion.CompanionRemoteCommand.Text,
+                com.gamebox.os.companion.CompanionRemoteCommand.Backspace -> Unit
+                com.gamebox.os.companion.CompanionRemoteCommand.Home -> {
+                    uiState.clearSelection()
+                    openDestination(Destination.HOME)
+                }
+                com.gamebox.os.companion.CompanionRemoteCommand.GameBox -> {
+                    uiState.clearSelection()
+                    openDestination(Destination.HOME)
+                }
+            }
+        }
+    }
+    fun handleBack(): Boolean {
+        return controllerActions.dispatchBack {
+            when (
+            gameBoxBackTarget(
+                showQuickActions = showQuickActions,
+                showSystemStatus = showSystemStatus,
+                showProfileSwitcher = showProfileSwitcher,
+                hasSelectedGame = selectedGameId != null,
+            )
+            ) {
+            GameBoxBackTarget.QUICK_ACTIONS -> { showQuickActions = false; true }
+            GameBoxBackTarget.SYSTEM_STATUS -> { showSystemStatus = false; true }
+            GameBoxBackTarget.PROFILE_SWITCHER -> { showProfileSwitcher = false; true }
+            GameBoxBackTarget.GAME_DETAILS -> { uiState.clearSelection(); true }
+            GameBoxBackTarget.NONE -> {
+                if (destination != Destination.HOME) openDestination(Destination.HOME)
+                true
+            }
+            }
+        }
+    }
+    BackHandler(onBack = { handleBack() })
+    val restorableGameId = uiState.restoreFocus(destination.name, games.map { it.id.value })?.let(::GameId)
+    val rememberGameFocus: (GameId) -> Unit = { focused ->
+        uiState.rememberFocus(destination.name, focused.value, games.map { it.id.value })
+    }
+
+    LaunchedEffect(navigationRequest?.requestId) {
+        navigationRequest?.let { request ->
+            val target = runCatching { Destination.valueOf(request.destination) }
+                .getOrDefault(Destination.HOME)
+            openDestination(target)
+            request.gameId?.let(uiState::openGame)
+        }
+    }
+
+    LaunchedEffect(textInputExitRequest) {
+        if (textInputExitRequest > 0) {
+            focusManager.clearFocus(force = true)
+            softwareKeyboard?.hide()
+        }
+    }
+
+    LaunchedEffect(destination, selectedGameId, hostWindowHasFocus) {
+        if (!hostWindowHasFocus) return@LaunchedEffect
+        if (destination != Destination.SETTINGS &&
+            destination != Destination.STORE &&
+            destination != Destination.DOWNLOADS &&
+            selectedGameId == null
+        ) {
+            selectedTabFocusRequester.requestFocus()
+        }
+    }
+
+    fun moveTab(offset: Int) {
+        openDestination(destinationAfterPrimaryTabMove(destination, offset))
+    }
+
+    BlueprintViewport(
+        safeAreaPercent = appSettings.safeAreaPercent,
+        reducedMotion = appSettings.reducedMotion,
+        uiSoundEffectsEnabled = appSettings.uiSoundEffectsEnabled,
+        focusDebugOverlayEnabled = appSettings.focusDebugOverlayEnabled && allowDeveloperOptions,
+        controllerActions = controllerActions,
+        uiState = uiState,
+        runtimeDeviceStatus = runtimeDeviceStatus,
+    ) {
+    val soundView = LocalView.current
+    val uiSoundsEnabled = LocalUiSoundEffects.current
+    BoxWithConstraints(
+        Modifier.fillMaxSize()
+            .onGameBoxRootInput(
+                soundsEnabled = uiSoundsEnabled,
+                playSoundEffect = soundView::playSoundEffect,
+                controllerActions = controllerActions,
+                movePrimaryTab = ::moveTab,
+                openQuickActions = { showQuickActions = true },
+                openSystemStatus = { showSystemStatus = true },
+                fallbackX = { openDestination(Destination.STORE) },
+                fallbackY = { openDestination(Destination.SETTINGS) },
+                handleBack = ::handleBack,
+            )
+    ) {
+        val compact = if (externalDisplay) {
+            false
+        } else {
+            shouldUseCompactLayout(
+                mode = com.gamebox.os.settings.effectiveDeveloperLayoutMode(
+                    appSettings.developerLayoutMode,
+                    allowDeveloperOptions,
+                ),
+                widthDp = maxWidth.value,
+                heightDp = maxHeight.value,
+            )
+        }
+        BlueprintBackdrop(compact)
+        Column(
+            Modifier.fillMaxSize()
+                // Keep backgrounds full-bleed, but inset controls from persistent OEM
+                // taskbar/navigation overlays reported by the external display.
+                .externalDisplaySystemOverlayInsets(externalDisplay, externalDisplayBottomInset)
+                .padding(
+                    start = if (compact) 16.dp else 24.dp,
+                    end = if (compact) 16.dp else 24.dp,
+                    top = if (compact) 10.dp else 14.dp,
+                    // Leave a small breathing gap after any reported system overlay inset.
+                    bottom = if (compact) 10.dp else 14.dp,
+                )
+        ) {
+            TopNav(
+                selected = destination,
+                compact = compact,
+                downloadActivityCount = downloadActivityCount,
+                onSelect = ::openDestination,
+                onSearch = {
+                    focusStoreSearchOnEnter = true
+                    openDestination(Destination.STORE)
+                },
+                selectedFocusRequester = selectedTabFocusRequester,
+                unifiedNavigation = onDestinationSelected != null,
+            )
+            SessionRecoveryBanner(gameLaunchController)
+            Spacer(Modifier.height(if (compact) 14.dp else 12.dp))
+
+            Box(Modifier.weight(1f).fillMaxWidth()) {
+                GameBoxDestinationContent(
+                    container = container,
+                    state = GameBoxRouteState(
+                        destination = destination,
+                        selectedGameId = selectedGameId,
+                        games = games,
+                        restorableGameId = restorableGameId,
+                        rememberGameFocus = rememberGameFocus,
+                        compact = compact,
+                        uiState = uiState,
+                        settings = appSettings,
+                        focusStoreSearchOnEnter = focusStoreSearchOnEnter,
+                        hostDisplayId = hostDisplayId,
+                        externalDisplay = externalDisplay,
+                        hostWindowHasFocus = hostWindowHasFocus,
+                        homeDownloadActivity = homeDownloadActivity(downloadJobs, browserDownloadRecords),
+                    ),
+                    actions = GameBoxRouteActions(
+                        openGame = { uiState.openGame(it.id.value) },
+                        openDownloads = { openDestination(Destination.DOWNLOADS) },
+                        backFromDetails = uiState::clearSelection,
+                        openProfileSwitcher = { showProfileSwitcher = true },
+                        requestStoreSearchFocus = { focusStoreSearchOnEnter = true },
+                        onSearchFocusHandled = { focusStoreSearchOnEnter = false },
+                    ),
+                )
+            }
+
+            if (!compact) {
+                Spacer(Modifier.height(8.dp))
+                ControllerFooter(controllerActions.xLabel, controllerActions.yLabel, appSettings.activeProfileName)
+            }
+        }
+        if (showQuickActions) {
+            QuickActionsDialog(
+                destination = destination,
+                xLabel = controllerActions.xLabel,
+                yLabel = controllerActions.yLabel,
+                onX = {
+                    showQuickActions = false
+                    if (!controllerActions.invokeX()) openDestination(Destination.STORE)
+                },
+                onY = {
+                    showQuickActions = false
+                    if (!controllerActions.invokeY()) openDestination(Destination.SETTINGS)
+                },
+                onHome = {
+                    showQuickActions = false
+                    openDestination(Destination.HOME)
+                },
+                onDownloads = {
+                    showQuickActions = false
+                    openDestination(Destination.DOWNLOADS)
+                },
+                onSettings = {
+                    showQuickActions = false
+                    openDestination(Destination.SETTINGS)
+                },
+                onDismiss = { showQuickActions = false },
+                autoFocusFirstAction = !compact,
+            )
+        }
+        if (showSystemStatus) {
+            SystemStatusDialog(onDismiss = { showSystemStatus = false })
+        }
+        if (showProfileSwitcher) {
+            ProfileSwitcherDialog(
+                activeProfile = appSettings.activeProfileName,
+                onDismiss = { showProfileSwitcher = false },
+                onSelect = { profile ->
+                    appScope.launch { settingsRepository.setActiveProfileName(profile) }
+                    showProfileSwitcher = false
+                },
+            )
+        }
+    }
+}
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/ui/GameBoxDestinationContent.kt b/app/src/gamebox/java/com/gamebox/os/ui/GameBoxDestinationContent.kt
new file mode 100644
index 0000000..8f174b8
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/ui/GameBoxDestinationContent.kt
@@ -0,0 +1,175 @@
+package com.gamebox.os.ui
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.runtime.remember
+import com.gamebox.os.data.AppContainer
+import com.gamebox.os.domain.Game
+import com.gamebox.os.domain.GameId
+import com.gamebox.os.domain.belongsToLibrary
+import com.gamebox.os.settings.GameBoxSettings
+
+internal data class GameBoxRouteState(
+    val destination: Destination,
+    val selectedGameId: GameId?,
+    val games: List<Game>,
+    val restorableGameId: GameId?,
+    val rememberGameFocus: (GameId) -> Unit,
+    val compact: Boolean,
+    val uiState: GameBoxUiState,
+    val settings: GameBoxSettings,
+    val focusStoreSearchOnEnter: Boolean,
+    val hostDisplayId: Int?,
+    val externalDisplay: Boolean,
+    val hostWindowHasFocus: Boolean,
+    val homeDownloadActivity: HomeDownloadActivity? = null,
+)
+
+internal data class GameBoxRouteActions(
+    val openGame: (Game) -> Unit,
+    val openDownloads: () -> Unit,
+    val backFromDetails: () -> Unit,
+    val openProfileSwitcher: () -> Unit,
+    val requestStoreSearchFocus: () -> Unit,
+    val onSearchFocusHandled: () -> Unit,
+)
+
+@Composable
+internal fun GameBoxDestinationContent(
+    container: AppContainer,
+    state: GameBoxRouteState,
+    actions: GameBoxRouteActions,
+) {
+    BlueprintScreenTransition(
+        route = BlueprintScreenRoute(state.destination, state.selectedGameId?.value),
+    ) { animatedRoute ->
+        val animatedState = state.copy(
+            destination = animatedRoute.destination,
+            selectedGameId = animatedRoute.selectedGameId?.let(::GameId),
+        )
+        val repository = container.gameRepository
+        val settingsRepository = container.settingsRepository
+        val saveControllerFactory = remember(container) { container::createSaveSafetyController }
+        val selected = animatedState.selectedGameId?.let(repository::game)
+        if (selected != null) {
+            DetailsScreen(
+                selected,
+                repository,
+                settingsRepository,
+                container.downloadRepository,
+                container.authorizedDownloadController,
+                container.remoteDownloadController,
+                container.gameLaunchController,
+                container.saveSafetyController,
+                container.managedSaveDiscovery,
+                discoveryRepository = container.catalogDiscoveryRepository,
+                lookupScreenshots = container::gameScreenshots,
+                importer = container.authorizedRomImporter,
+                saveControllerFactory = saveControllerFactory,
+                hostDisplayId = animatedState.hostDisplayId,
+                compact = animatedState.compact,
+                onDownloads = actions.openDownloads,
+                onOpenStore = {
+                    animatedState.uiState.requestStoreVimmSearch()
+                    animatedState.uiState.openDestination(Destination.STORE.name)
+                },
+                onBack = actions.backFromDetails,
+            )
+        } else {
+            when (animatedState.destination) {
+                Destination.HOME -> HomeScreen(
+                    animatedState.games,
+                    animatedState.restorableGameId,
+                    animatedState.rememberGameFocus,
+                    animatedState.compact,
+                    hostWindowHasFocus = animatedState.hostWindowHasFocus,
+                    openPc = { animatedState.uiState.openDestination(Destination.PC.name) },
+                    openStore = {
+                        animatedState.uiState.requestStoreVimmSearch()
+                        animatedState.uiState.openDestination(Destination.STORE.name)
+                    },
+                    openSearch = {
+                        actions.requestStoreSearchFocus()
+                        animatedState.uiState.openDestination(Destination.STORE.name)
+                    },
+                    openProfileSwitcher = actions.openProfileSwitcher,
+                    allowDefaultHomeSetupPrompt = !animatedState.externalDisplay,
+                    open = actions.openGame,
+                    openStorageSettings = { animatedState.uiState.openSettings(SettingsSection.STORAGE) },
+                    openControllerSettings = { animatedState.uiState.openSettings(SettingsSection.CONTROLLERS) },
+                    downloadActivity = animatedState.homeDownloadActivity,
+                    openDownloads = actions.openDownloads,
+                )
+
+                Destination.LIBRARY -> CollectionScreen(
+                    "Your Library",
+                    "Installed games and retained imports",
+                    animatedState.games.filter { it.belongsToLibrary() },
+                    animatedState.restorableGameId,
+                    animatedState.rememberGameFocus,
+                    animatedState.compact,
+                    animatedState.uiState,
+                    controllerKeyboard = !animatedState.compact,
+                    onStore = { animatedState.uiState.openDestination(Destination.STORE.name) },
+                    open = actions.openGame,
+                )
+
+                Destination.STORE -> CatalogScreen(
+                    container.gameRepository,
+                    container.catalogDiscoveryRepository,
+                    container.authorizedRomImporter,
+                    animatedState.games,
+                    animatedState.restorableGameId,
+                    animatedState.rememberGameFocus,
+                    animatedState.compact,
+                    settingsRepository = settingsRepository,
+                    gameSources = animatedState.settings.gameSources,
+                    uiState = animatedState.uiState,
+                    focusSearchOnEnter = animatedState.focusStoreSearchOnEnter,
+                    hostWindowHasFocus = animatedState.hostWindowHasFocus,
+                    onSearchFocusHandled = actions.onSearchFocusHandled,
+                    controllerKeyboard = !animatedState.compact,
+                    open = actions.openGame,
+                    onOpenDownloads = actions.openDownloads,
+                )
+
+                Destination.DOWNLOADS -> DownloadsScreen(
+                    container.gameRepository,
+                    container.downloadRepository,
+                    container.remoteDownloadController,
+                    animatedState.compact,
+                    onStore = { animatedState.uiState.openDestination(Destination.STORE.name) },
+                    onSettings = { animatedState.uiState.openDestination(Destination.SETTINGS.name) },
+                )
+
+                Destination.MEDIA -> AppHubScreen(
+                    "Media",
+                    "Launch your living-room apps and return to GameBox",
+                    mediaShortcuts,
+                    animatedState.compact,
+                    settingsRepository,
+                    AppHubKind.MEDIA,
+                )
+
+                Destination.PC -> AppHubScreen(
+                    "PC Hub",
+                    "Streaming, Windows, Linux, files, browser, and desktop tools",
+                    pcShortcuts,
+                    animatedState.compact,
+                    settingsRepository,
+                    AppHubKind.PC,
+                )
+
+                Destination.SETTINGS -> SettingsScreen(
+                    animatedState.compact,
+                    settingsRepository,
+                    container.gameRepository,
+                    container.downloadRepository,
+                    container.catalogProvider,
+                    requestedSection = animatedState.uiState.requestedSettingsSection(),
+                    onSectionRequestConsumed = animatedState.uiState::consumeSettingsSectionRequest,
+                )
+            }
+        }
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/ui/GameBoxRootInput.kt b/app/src/gamebox/java/com/gamebox/os/ui/GameBoxRootInput.kt
new file mode 100644
index 0000000..317f92a
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/ui/GameBoxRootInput.kt
@@ -0,0 +1,107 @@
+package com.gamebox.os.ui
+
+import android.view.KeyEvent
+import android.view.SoundEffectConstants
+import androidx.compose.ui.Modifier
+import androidx.compose.ui.input.key.KeyEventType
+import androidx.compose.ui.input.key.onPreviewKeyEvent
+import androidx.compose.ui.input.key.type
+
+internal sealed interface GameBoxRootInput {
+    data class MovePrimaryTab(val offset: Int) : GameBoxRootInput
+    data object OpenQuickActions : GameBoxRootInput
+    data object OpenSystemStatus : GameBoxRootInput
+    data object InvokeX : GameBoxRootInput
+    data object InvokeY : GameBoxRootInput
+    data object Back : GameBoxRootInput
+}
+
+internal enum class GameBoxBackTarget {
+    QUICK_ACTIONS,
+    SYSTEM_STATUS,
+    PROFILE_SWITCHER,
+    GAME_DETAILS,
+    NONE,
+}
+
+/** One dismissal order shared by Android Back and controller B. */
+internal fun gameBoxBackTarget(
+    showQuickActions: Boolean,
+    showSystemStatus: Boolean,
+    showProfileSwitcher: Boolean,
+    hasSelectedGame: Boolean,
+): GameBoxBackTarget = when {
+    showQuickActions -> GameBoxBackTarget.QUICK_ACTIONS
+    showSystemStatus -> GameBoxBackTarget.SYSTEM_STATUS
+    showProfileSwitcher -> GameBoxBackTarget.PROFILE_SWITCHER
+    hasSelectedGame -> GameBoxBackTarget.GAME_DETAILS
+    else -> GameBoxBackTarget.NONE
+}
+
+internal fun gameBoxRootInputForKey(keyCode: Int): GameBoxRootInput? = when (keyCode) {
+    KeyEvent.KEYCODE_BUTTON_L1 -> GameBoxRootInput.MovePrimaryTab(-1)
+    KeyEvent.KEYCODE_BUTTON_R1 -> GameBoxRootInput.MovePrimaryTab(1)
+    KeyEvent.KEYCODE_BUTTON_START, KeyEvent.KEYCODE_MENU -> GameBoxRootInput.OpenQuickActions
+    KeyEvent.KEYCODE_BUTTON_SELECT -> GameBoxRootInput.OpenSystemStatus
+    KeyEvent.KEYCODE_BUTTON_X -> GameBoxRootInput.InvokeX
+    KeyEvent.KEYCODE_BUTTON_Y -> GameBoxRootInput.InvokeY
+    KeyEvent.KEYCODE_BACK, KeyEvent.KEYCODE_BUTTON_B -> GameBoxRootInput.Back
+    else -> null
+}
+
+internal fun shouldHandleGameBoxRootKey(keyCode: Int, repeatCount: Int): Boolean =
+    repeatCount == 0 || gameBoxRootInputForKey(keyCode) == null
+
+internal fun gameBoxNavigationSoundForKey(keyCode: Int): Int? = when (keyCode) {
+    KeyEvent.KEYCODE_DPAD_LEFT -> SoundEffectConstants.NAVIGATION_LEFT
+    KeyEvent.KEYCODE_DPAD_RIGHT -> SoundEffectConstants.NAVIGATION_RIGHT
+    KeyEvent.KEYCODE_DPAD_UP -> SoundEffectConstants.NAVIGATION_UP
+    KeyEvent.KEYCODE_DPAD_DOWN -> SoundEffectConstants.NAVIGATION_DOWN
+    else -> null
+}
+
+/** Applies the shell-level controller contract while leaving navigation state in the app host. */
+internal fun Modifier.onGameBoxRootInput(
+    soundsEnabled: Boolean,
+    playSoundEffect: (Int) -> Unit,
+    controllerActions: ControllerActionRegistry,
+    movePrimaryTab: (Int) -> Unit,
+    openQuickActions: () -> Unit,
+    openSystemStatus: () -> Unit,
+    fallbackX: () -> Unit,
+    fallbackY: () -> Unit,
+    handleBack: () -> Boolean,
+): Modifier = onPreviewKeyEvent { event ->
+    if (event.type != KeyEventType.KeyDown) return@onPreviewKeyEvent false
+    val keyCode = event.nativeKeyEvent.keyCode
+    if (!shouldHandleGameBoxRootKey(keyCode, event.nativeKeyEvent.repeatCount)) {
+        return@onPreviewKeyEvent true
+    }
+    if (soundsEnabled && event.nativeKeyEvent.repeatCount == 0) {
+        gameBoxNavigationSoundForKey(keyCode)?.let(playSoundEffect)
+    }
+    when (val input = gameBoxRootInputForKey(keyCode)) {
+        is GameBoxRootInput.MovePrimaryTab -> {
+            movePrimaryTab(input.offset)
+            true
+        }
+        GameBoxRootInput.OpenQuickActions -> {
+            openQuickActions()
+            true
+        }
+        GameBoxRootInput.OpenSystemStatus -> {
+            openSystemStatus()
+            true
+        }
+        GameBoxRootInput.InvokeX -> {
+            if (!controllerActions.invokeX()) fallbackX()
+            true
+        }
+        GameBoxRootInput.InvokeY -> {
+            if (!controllerActions.invokeY()) fallbackY()
+            true
+        }
+        GameBoxRootInput.Back -> handleBack()
+        null -> false
+    }
+}
