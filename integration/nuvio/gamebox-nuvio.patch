+    private fun applyExternalDisplayFullscreen() {
+        val targetWindow = window ?: return
+        val targetDisplay = targetWindow.decorView.display ?: return
+        if (targetDisplay.displayId == android.view.Display.DEFAULT_DISPLAY) return
+
+        @Suppress("DEPRECATION")
+        targetWindow.decorView.systemUiVisibility = (
+            android.view.View.SYSTEM_UI_FLAG_FULLSCREEN or
+                android.view.View.SYSTEM_UI_FLAG_HIDE_NAVIGATION or
+                android.view.View.SYSTEM_UI_FLAG_IMMERSIVE_STICKY or
+                android.view.View.SYSTEM_UI_FLAG_LAYOUT_STABLE or
+                android.view.View.SYSTEM_UI_FLAG_LAYOUT_FULLSCREEN or
+                android.view.View.SYSTEM_UI_FLAG_LAYOUT_HIDE_NAVIGATION
+            )
+
+        if (android.os.Build.VERSION.SDK_INT >= android.os.Build.VERSION_CODES.R) {
+            targetWindow.setFlags(
+                android.view.WindowManager.LayoutParams.FLAG_FULLSCREEN,
+                android.view.WindowManager.LayoutParams.FLAG_FULLSCREEN
+            )
+            targetWindow.insetsController?.let { controller ->
+                val bars = android.view.WindowInsets.Type.statusBars() or
+                    android.view.WindowInsets.Type.navigationBars() or
+                    android.view.WindowInsets.Type.captionBar()
+                controller.hide(bars)
+                controller.systemBarsBehavior =
+                    android.view.WindowInsetsController.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+            }
+        }
+    }
