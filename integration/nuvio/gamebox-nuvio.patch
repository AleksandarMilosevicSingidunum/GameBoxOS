+package com.gamebox.os.diagnostics
+
+import java.io.ByteArrayOutputStream
+import java.nio.charset.StandardCharsets
+import java.util.zip.ZipEntry
+import java.util.zip.ZipOutputStream
+
+const val MAX_DIAGNOSTICS_BUNDLE_BYTES: Int = 2 * 1024 * 1024
+
+fun buildDiagnosticsRecoveryBundle(
+    report: String,
+    events: List<DiagnosticEvent>,
+    maxBytes: Int = MAX_DIAGNOSTICS_BUNDLE_BYTES,
+): ByteArray {
+    require(maxBytes > 0) { "Bundle limit must be positive" }
+    val eventsText = buildString {
+        appendLine("GameBox OS diagnostic events")
+        events.forEach { event ->
+            appendLine("${event.timestampMillis} ${event.level.name} ${sanitizeDiagnosticToken(event.code)}: ${sanitizeDiagnosticToken(event.message)}")
+        }
+    }
+    require(report.toByteArray(StandardCharsets.UTF_8).size + eventsText.toByteArray(StandardCharsets.UTF_8).size <= maxBytes) {
+        "Diagnostics recovery bundle exceeds the size limit"
+    }
+    val output = ByteArrayOutputStream()
+    ZipOutputStream(output).use { zip ->
+        fun add(name: String, value: String) {
+            zip.putNextEntry(ZipEntry(name))
+            zip.write(value.toByteArray(StandardCharsets.UTF_8))
+            zip.closeEntry()
+        }
+        add("diagnostics.txt", report)
+        add("events.txt", eventsText)
+    }
+    return output.toByteArray().also {
+        require(it.size <= maxBytes) { "Diagnostics recovery bundle exceeds the size limit" }
+    }
+}
+
+internal fun sanitizeDiagnosticToken(value: String): String = value
+    .replace(Regex("https?://\\S+"), "<url>")
+    .replace(
+        Regex("(?i)(password|secret|token|api[_-]?key|access[_-]?key|secret[_-]?key)\\s*[:=]\\s*[^\\s,;]+")
+    ) { match ->
+        match.value.substringBefore("=").substringBefore(":").trimEnd() + "=<redacted>"
+    }
+    .replace(Regex("(?i)\\b(?:authorization\\s*:\\s*)?bearer\\s+[^\\s,;]+"), "Bearer <redacted>")
+    .replace(Regex("(?i)\\b[a-f0-9]{64}\\b"), "<checksum>")
+    .replace(Regex("(?i)(?:[a-z]:\\\\|/)(?:[^\\s]+)"), "<path>")
diff --git a/app/src/gamebox/java/com/gamebox/os/diagnostics/DiagnosticsReport.kt b/app/src/gamebox/java/com/gamebox/os/diagnostics/DiagnosticsReport.kt
new file mode 100644
index 0000000..2588dda
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/diagnostics/DiagnosticsReport.kt
@@ -0,0 +1,90 @@
+package com.gamebox.os.diagnostics
+
+import com.gamebox.os.domain.DownloadJob
+import com.gamebox.os.domain.Game
+import com.gamebox.os.domain.InstallState
+import com.gamebox.os.settings.GameBoxSettings
+import java.net.URI
+import java.time.Instant
+import java.util.Locale
+
+data class DiagnosticsDevice(
+    val manufacturer: String,
+    val model: String,
+    val sdk: Int,
+    val appVersion: String,
+    val usableBytes: Long,
+    val totalBytes: Long
+)
+
+data class DiagnosticsRuntime(
+    val controllerCount: Int,
+    val audioOutput: String,
+    val networkTransport: String,
+    val networkState: String,
+    val externalDisplayCount: Int,
+    val externalDisplaySummary: String,
+    val batteryPercent: Int?,
+    val powerState: String,
+)
+
+fun buildDiagnosticsReport(
+    device: DiagnosticsDevice,
+    settings: GameBoxSettings,
+    games: List<Game>,
+    downloads: List<DownloadJob>,
+    runtime: DiagnosticsRuntime? = null,
+    generatedAt: Instant = Instant.now()
+): String {
+    val providerHost = settings.catalogUrl.takeIf { it.isNotBlank() }?.let { value ->
+        runCatching { URI(value).host }.getOrNull()?.takeIf { it.isNotBlank() }
+    } ?: "bundled-offline"
+    val installed = games.count {
+        it.state == InstallState.INSTALLED || it.state == InstallState.UPDATE_AVAILABLE
+    }
+    val favoriteCount = games.count { it.favorite }
+    val downloadStates = downloads.groupingBy { it.status.name }.eachCount().toSortedMap()
+
+    return buildString {
+        appendLine("GameBox OS diagnostics")
+        appendLine("Generated: ${generatedAt}")
+        appendLine("App version: ${device.appVersion}")
+        appendLine("Device: ${device.manufacturer} ${device.model}")
+        appendLine("Android SDK: ${device.sdk}")
+        appendLine("Storage usable: ${formatDiagnosticBytes(device.usableBytes)}")
+        appendLine("Storage total: ${formatDiagnosticBytes(device.totalBytes)}")
+        runtime?.let { status ->
+            appendLine("Controllers connected: " + status.controllerCount.coerceAtLeast(0))
+            appendLine("Audio output: " + status.audioOutput.take(120))
+            appendLine("Network transport: " + status.networkTransport.take(80))
+            appendLine("Network state: " + status.networkState.take(80))
+            appendLine("External displays: " + status.externalDisplayCount.coerceAtLeast(0))
+            appendLine("External display status: " + status.externalDisplaySummary.take(240))
+            appendLine(
+                "Battery: " + (status.batteryPercent?.coerceIn(0, 100)?.toString()?.plus("%")
+                    ?: "unavailable")
+            )
+            appendLine("Power: " + status.powerState.take(120))
+        }
+        appendLine("Catalog provider host: ${providerHost}")
+        appendLine("Catalog seeded: ${settings.catalogSeededAtEpochMs ?: "not recorded"}")
+        appendLine("Catalog refreshed: ${settings.catalogRefreshedAtEpochMs ?: "not recorded"}")
+        appendLine("Games total: ${games.size}")
+        appendLine("Games installed: ${installed}")
+        appendLine("Favorites: ${favoriteCount}")
+        appendLine("Download jobs: ${downloads.size}")
+        appendLine(
+            "Download states: " +
+                if (downloadStates.isEmpty()) "none"
+                else downloadStates.entries.joinToString { (state, count) -> "${state}=${count}" }
+        )
+        appendLine()
+        appendLine("Privacy note: catalog paths, query strings, credentials, game source URLs,")
+        appendLine("checksums, file paths, and save contents are intentionally excluded.")
+    }
+}
+
+private fun formatDiagnosticBytes(bytes: Long): String {
+    val gib = bytes.coerceAtLeast(0L).toDouble() / (1024.0 * 1024.0 * 1024.0)
+    return String.format(Locale.US, "%.1f GB", gib)
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/display/BorderlessWindowPolicy.kt b/app/src/gamebox/java/com/gamebox/os/display/BorderlessWindowPolicy.kt
new file mode 100644
index 0000000..f246f6a
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/display/BorderlessWindowPolicy.kt
@@ -0,0 +1,182 @@
+package com.gamebox.os.display
+
+import android.app.Activity
+import android.os.OutcomeReceiver
+import android.os.Build
+import android.util.Log
+import android.view.Display
+import android.view.Window
+import android.view.WindowManager
+import androidx.core.view.WindowCompat
+import androidx.core.view.WindowInsetsCompat
+import androidx.core.view.WindowInsetsControllerCompat
+
+/** Shared edge-to-edge policy for GameBox's Home and external-display hosts. */
+internal fun applyBorderlessFullscreenWindow(window: Window) {
+    WindowCompat.setDecorFitsSystemWindows(window, false)
+    // System bars are hidden with WindowInsetsControllerCompat below. Avoid
+    // legacy fullscreen flags so window state has one modern source of truth.
+    window.addFlags(WindowManager.LayoutParams.FLAG_LAYOUT_NO_LIMITS)
+    if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+        window.attributes = window.attributes.apply {
+            layoutInDisplayCutoutMode =
+                WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_ALWAYS
+        }
+    } else if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.P) {
+        window.attributes = window.attributes.apply {
+            layoutInDisplayCutoutMode =
+                WindowManager.LayoutParams.LAYOUT_IN_DISPLAY_CUTOUT_MODE_SHORT_EDGES
+        }
+    }
+    window.setLayout(
+        WindowManager.LayoutParams.MATCH_PARENT,
+        WindowManager.LayoutParams.MATCH_PARENT,
+    )
+}
+
+internal fun hideSystemBars(window: Window) {
+    applyBorderlessFullscreenWindow(window)
+    WindowCompat.getInsetsController(window, window.decorView).apply {
+        systemBarsBehavior = WindowInsetsControllerCompat.BEHAVIOR_SHOW_TRANSIENT_BARS_BY_SWIPE
+        hide(WindowInsetsCompat.Type.systemBars())
+    }
+    // Request a fresh dispatch so Compose can account for persistent OEM
+    // navigation/taskbar bounds while immersive mode hides standard bars.
+    androidx.core.view.ViewCompat.requestApplyInsets(window.decorView)
+}
+
+/** Returns the Activity's routed display on all supported Android versions. */
+internal fun Activity.currentDisplayId(): Int {
+    window.decorView.display?.displayId?.let { return it }
+    return if (Build.VERSION.SDK_INT >= Build.VERSION_CODES.R) {
+        display?.displayId ?: Display.DEFAULT_DISPLAY
+    } else {
+        Display.DEFAULT_DISPLAY
+    }
+}
+
+internal fun shouldRequestExternalFullscreenOnFocus(
+    displayId: Int,
+    hasFocus: Boolean,
+): Boolean =
+    hasFocus && isExternalDisplayId(displayId)
+
+internal fun shouldRequestPrimaryFullscreenOnFocus(
+    displayId: Int,
+    hasFocus: Boolean,
+    isInMultiWindowMode: Boolean,
+): Boolean =
+    displayId == Display.DEFAULT_DISPLAY && hasFocus && isInMultiWindowMode
+
+/** Retry after the desktop shell has completed its focus/window-mode transition. */
+internal fun Activity.requestExternalFullscreenAfterFocus(delayMillis: Long = 300L) {
+    if (!hasWindowFocus() || !isExternalDisplayId(currentDisplayId())) return
+    window.decorView.postDelayed({
+        if (
+            !isFinishing && hasWindowFocus() &&
+            shouldRequestExternalFullscreenOnFocus(
+                currentDisplayId(),
+                hasFocus = true,
+            )
+        ) {
+            requestExternalActivityFullscreen(this)
+        }
+    }, delayMillis)
+}
+
+/** Promote a windowed launcher on the primary display into the TV-style full-screen surface. */
+internal fun Activity.requestPrimaryFullscreenAfterFocus(delayMillis: Long = 300L) {
+    val displayId = currentDisplayId()
+    if (!shouldRequestPrimaryFullscreenOnFocus(displayId, hasWindowFocus(), isInMultiWindowMode)) return
+    window.decorView.postDelayed({
+        if (
+            !isFinishing && currentDisplayId() == displayId && hasWindowFocus() &&
+            shouldRequestPrimaryFullscreenOnFocus(
+                displayId,
+                hasFocus = true,
+                isInMultiWindowMode = isInMultiWindowMode,
+            )
+        ) {
+            requestPrimaryActivityFullscreen(this)
+        }
+    }, delayMillis)
+}
+
+internal fun externalFullscreenRetryDelayMillis(retryIndex: Int): Long? =
+    when (retryIndex) {
+        0 -> 500L
+        1 -> 1_200L
+        else -> null
+    }
+
+/** Ask desktop-mode window managers to promote an external-display host to fullscreen. */
+internal fun requestExternalActivityFullscreen(activity: Activity, retryIndex: Int = 0): Boolean {
+    val displayId = activity.currentDisplayId()
+    if (!isExternalDisplayId(displayId)) return false
+    return requestFullscreenModeOnDisplay(activity, displayId, retryIndex)
+}
+
+internal fun requestPrimaryActivityFullscreen(activity: Activity, retryIndex: Int = 0): Boolean {
+    val displayId = activity.currentDisplayId()
+    if (
+        !shouldRequestPrimaryFullscreenOnFocus(
+            displayId,
+            hasFocus = activity.hasWindowFocus(),
+            isInMultiWindowMode = activity.isInMultiWindowMode,
+        )
+    ) return false
+    return requestFullscreenModeOnDisplay(activity, displayId, retryIndex, requireMultiWindow = true)
+}
+
+private fun requestFullscreenModeOnDisplay(
+    activity: Activity,
+    displayId: Int,
+    retryIndex: Int,
+    requireMultiWindow: Boolean = false,
+): Boolean {
+    Log.d(
+        "GameBoxDisplay",
+        "Fullscreen request check: sdk=${Build.VERSION.SDK_INT}, display=$displayId, multiWindow=${activity.isInMultiWindowMode}",
+    )
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.UPSIDE_DOWN_CAKE) return false
+
+    runCatching {
+        activity.requestFullscreenMode(
+            Activity.FULLSCREEN_MODE_REQUEST_ENTER,
+            object : OutcomeReceiver<Void, Throwable> {
+                override fun onResult(result: Void?) {
+                    Log.i("GameBoxDisplay", "Fullscreen request accepted on display $displayId")
+                }
+
+                override fun onError(error: Throwable) {
+                    Log.w("GameBoxDisplay", "Fullscreen request rejected on display $displayId", error)
+                    if (isRetryableExternalFullscreenError(error)) {
+                        externalFullscreenRetryDelayMillis(retryIndex)?.let { delayMillis ->
+                            activity.window.decorView.postDelayed({
+                                if (
+                                    !activity.isFinishing && activity.hasWindowFocus() &&
+                                    activity.currentDisplayId() == displayId &&
+                                    (!requireMultiWindow || activity.isInMultiWindowMode)
+                                ) {
+                                    requestFullscreenModeOnDisplay(
+                                        activity,
+                                        displayId,
+                                        retryIndex + 1,
+                                        requireMultiWindow,
+                                    )
+                                }
+                            }, delayMillis)
+                        }
+                    }
+                }
+            },
+        )
+    }.onFailure { error ->
+        Log.w("GameBoxDisplay", "Fullscreen request failed on display $displayId", error)
+    }
+    return true
+}
+
+internal fun isRetryableExternalFullscreenError(error: Throwable): Boolean =
+    error is IllegalStateException &&
+        error.message?.contains("not the top focused window", ignoreCase = true) == true
diff --git a/app/src/gamebox/java/com/gamebox/os/display/ExternalDisplayLauncher.kt b/app/src/gamebox/java/com/gamebox/os/display/ExternalDisplayLauncher.kt
new file mode 100644
index 0000000..9ed75c4
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/display/ExternalDisplayLauncher.kt
@@ -0,0 +1,124 @@
+package com.gamebox.os.display
+
+import android.app.Activity
+import android.app.ActivityOptions
+import android.content.Context
+import android.content.ContextWrapper
+import android.content.Intent
+import android.hardware.display.DisplayManager
+import android.os.Bundle
+import android.view.Display
+import java.util.Locale
+import androidx.core.app.ActivityOptionsCompat
+import com.gamebox.os.ExternalDisplayActivity
+
+internal data class ExternalDisplayTarget(
+    val displayId: Int,
+    val name: String,
+    val width: Int = 0,
+    val height: Int = 0,
+    val isVirtual: Boolean = false,
+)
+
+internal val externalDisplayActivityClass = ExternalDisplayActivity::class.java
+
+// Best-effort desktop-shell launch hint. The public Activity fullscreen request
+// is also used by the destination on Android versions that expose it.
+private const val fullscreenWindowingMode = 1
+private const val launchWindowingModeKey = "android.activity.windowingMode"
+
+internal fun ActivityOptions.toGameBoxFullscreenLaunchBundle(): Bundle =
+    // Android documents null launch bounds as an explicit fullscreen request.
+    setLaunchBounds(null).toBundle().apply {
+        // This is a best-effort hint for OEM desktop shells. Android's public
+        // fullscreen request is also made by the destination Activity where supported.
+        putInt(launchWindowingModeKey, fullscreenWindowingMode)
+    }
+
+/** Carry the external-display/fullscreen launch hint through ActivityResult pickers. */
+internal fun externalDisplayActivityResultOptions(context: Context): ActivityOptionsCompat? {
+    val activity = generateSequence(context as Context?) { current ->
+        (current as? ContextWrapper)?.baseContext
+    }.filterIsInstance<Activity>().firstOrNull() ?: return null
+    val displayId = activity.currentDisplayId()
+    if (!isExternalDisplayId(displayId)) return null
+
+    val bundle = ActivityOptions.makeBasic().apply {
+        launchDisplayId = displayId
+    }.toGameBoxFullscreenLaunchBundle()
+    return BundleBackedActivityOptionsCompat(bundle)
+}
+
+private class BundleBackedActivityOptionsCompat(bundle: Bundle) : ActivityOptionsCompat() {
+    private val launchOptions = Bundle(bundle)
+
+    override fun toBundle(): Bundle = Bundle(launchOptions)
+}
+
+internal fun firstPresentationDisplayTarget(targets: List<ExternalDisplayTarget>): ExternalDisplayTarget? =
+    targets.firstOrNull { !it.isVirtual } ?: targets.firstOrNull()
+
+internal fun isLikelyVirtualPresentationDisplay(name: String): Boolean {
+    val normalized = name.lowercase(Locale.ROOT)
+    return listOf("android studio", "screen sharing", "screen.sharing", "virtual", "capture")
+        .any(normalized::contains)
+}
+
+internal fun externalDisplayLaunchRequestedMessage(target: ExternalDisplayTarget): String =
+    "GameBox TV mode requested on ${target.name}; confirm the display switch if prompted"
+
+internal fun isExternalDisplayId(displayId: Int): Boolean = displayId > Display.DEFAULT_DISPLAY
+
+/** Keep phone content clear of system UI while letting a fullscreen TV host use every pixel. */
+internal fun shouldFinishExternalDisplayActivityForRemovedDisplay(
+    currentDisplayId: Int,
+    removedDisplayId: Int,
+): Boolean =
+    isExternalDisplayId(currentDisplayId) && currentDisplayId == removedDisplayId
+
+internal fun shouldReapplyExternalDisplayWindowPolicyForChangedDisplay(
+    currentDisplayId: Int,
+    changedDisplayId: Int,
+): Boolean =
+    isExternalDisplayId(currentDisplayId) && currentDisplayId == changedDisplayId
+
+internal fun presentationDisplayTargets(context: Context): List<ExternalDisplayTarget> =
+    context.getSystemService(DisplayManager::class.java)
+        // Honor Desktop Mode exposes a wired HDMI panel as a normal external
+        // display rather than in DISPLAY_CATEGORY_PRESENTATION. Enumerate the
+        // complete display inventory so the real TV handoff is not lost on OEM
+        // desktop shells; firstPresentationDisplayTarget still prefers a
+        // physical panel over screen-sharing/capture displays.
+        ?.getDisplays()
+        .orEmpty()
+        .filter { it.displayId != Display.DEFAULT_DISPLAY }
+        .map { display ->
+            val mode = display.mode
+            ExternalDisplayTarget(
+                displayId = display.displayId,
+                name = display.name.ifBlank { "External display" },
+                width = mode.physicalWidth,
+                height = mode.physicalHeight,
+                isVirtual = isLikelyVirtualPresentationDisplay(display.name),
+            )
+        }
+
+internal fun launchGameBoxOnExternalDisplay(activity: Activity): String {
+    val target = firstPresentationDisplayTarget(presentationDisplayTargets(activity))
+        ?: return "No external display detected"
+    return runCatching {
+        val options = ActivityOptions.makeBasic().apply {
+            launchDisplayId = target.displayId
+            // Keep launch bounds null: a display-sized rectangle can make
+            // desktop shells create a captioned freeform task.
+        }
+        val launchOptions = options.toGameBoxFullscreenLaunchBundle()
+        // Reuse the dedicated external-display task without touching the phone's Home task.
+        val launchIntent = Intent(activity, externalDisplayActivityClass)
+            .addFlags(Intent.FLAG_ACTIVITY_NEW_TASK)
+        activity.startActivity(launchIntent, launchOptions)
+        externalDisplayLaunchRequestedMessage(target)
+    }.getOrElse { error ->
+        "Could not open GameBox on ${target.name}: ${error.message ?: "display launch failed"}"
+    }
+}
