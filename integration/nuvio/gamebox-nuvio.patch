-    <string name="playback_buffer_custom_sub">Timpa buffering default Media3 dengan nilai di bawah. Saat nonaktif, pemutar menggunakan durasi buffer dan ukuran target bawaan Media3.</string>
-    <string name="playback_buffer_header">Buffer</string>
-    <string name="playback_buffer_warning">Pengaturan ini memengaruhi perilaku buffering. Nilai yang salah dapat menyebabkan masalah pemutaran.</string>
-    <string name="playback_buffer_min">Durasi Buffer Minimum</string>
-    <string name="playback_buffer_min_sub">Jumlah media minimum yang di-buffer. Pemutar akan berusaha memastikan setidaknya sejumlah konten ini selalu di-buffer di depan posisi pemutaran saat ini.</string>
-    <string name="playback_buffer_max">Durasi Buffer Maksimum</string>
-    <string name="playback_buffer_max_sub">Jumlah media maksimum yang di-buffer. Harus minimal sama dengan durasi buffer minimum. Nilai lebih tinggi menggunakan lebih banyak memori tetapi memberikan pemutaran lebih lancar pada koneksi tidak stabil.</string>
-    <string name="playback_buffer_value_same_as_min">%1$ds (sama dengan min)</string>
-    <string name="playback_buffer_initial">Buffer Awal</string>
-    <string name="playback_buffer_initial_sub">Berapa banyak konten yang harus di-buffer sebelum pemutaran dimulai. Nilai lebih rendah memulai lebih cepat tetapi dapat menyebabkan tersendat di awal pada koneksi lambat.</string>
-    <string name="playback_buffer_after_rebuffer">Buffer Setelah Rebuffer</string>
-    <string name="playback_buffer_after_rebuffer_sub">Berapa banyak konten yang di-buffer setelah pemutaran terhenti karena buffering. Nilai lebih tinggi mengurangi gangguan buffering berulang.</string>
-    <string name="playback_buffer_back">Durasi Buffer Belakang</string>
-    <string name="playback_buffer_back_sub">Berapa banyak konten yang sudah diputar tetap disimpan di memori. Memungkinkan mundur cepat tanpa mengunduh ulang. Setel ke 0 untuk menonaktifkan dan menghemat memori.</string>
-    <string name="playback_buffer_back_reserve">Menyediakan ~%1$dMB di atas Buffer Target. Menaikkan Durasi Buffer Maksimum akan menyusutkannya tanpa kehilangan waktu buffer belakang.</string>
-    <string name="playback_buffer_managed">Anggaran Memori Terkelola</string>
-    <string name="playback_buffer_managed_sub">Membatasi buffer ke porsi aman dari memori perangkat ini. Nonaktifkan untuk mengatur Ukuran Buffer Target sendiri (lanjutan — nilai besar dapat membuat perangkat bermemori rendah crash).</string>
-    <string name="playback_buffer_target">Ukuran Buffer Target</string>
-    <string name="playback_buffer_target_sub">RAM maksimum yang digunakan untuk buffer ke depan. Batas maksimum dihitung dari memori tersedia perangkat Anda (batas heap per aplikasi Android), sehingga perangkat dengan RAM lebih besar otomatis mendapat batas lebih tinggi.</string>
-    <string name="playback_buffer_target_managed_hint">Dikelola oleh anggaran memori perangkat. Nonaktifkan Anggaran Memori Terkelola untuk mengaturnya.</string>
-    <string name="playback_buffer_target_warning">Peringatan: melebihi batas aman perangkat (%1$d MB). Aplikasi mungkin crash saat pemutaran.</string>
-    <string name="playback_buffer_target_danger_warning">Bahaya: Melebihi batas peringatan (%1$d MB). Risiko crash tinggi.</string>
-    <string name="playback_buffer_allow_large">Izinkan Buffer Target Lebih Besar</string>
-    <string name="playback_buffer_allow_large_sub">Menghapus batas memori perangkat pada slider Ukuran Buffer Target, memungkinkan nilai hingga 2GB. Mungkin crash pada perangkat dengan RAM kurang dari 2GB.</string>
-    <string name="playback_cache_header">Cache Disk</string>
-    <string name="playback_cache_vod">Cache Disk VOD</string>
-    <string name="playback_cache_vod_sub">Simpan byte yang diunduh ke disk untuk stream saat ini. Memperluas mundur instan melampaui buffer belakang di memori dan bertahan saat jaringan sempat terputus. Hanya berlaku untuk stream progresif (bukan HLS/DASH).</string>
-    <string name="playback_cache_auto_size">Ukuran Otomatis</string>
-    <string name="playback_cache_auto_size_sub">Saat aktif, ukuran cache dihitung dari ruang disk yang tersedia. Nonaktifkan untuk memilih ukuran secara manual.</string>
-    <string name="playback_cache_vod_size">Ukuran Cache VOD</string>
-    <string name="playback_cache_vod_size_sub">Penggunaan disk maksimum untuk cache VOD progresif (dihapus berdasarkan LRU).</string>
-    <string name="playback_cache_info_range">Rentang: %1$d-%2$d MB.</string>
