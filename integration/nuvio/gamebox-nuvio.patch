-    <string name="playback_buffer_min">Thời lượng bộ đệm tối thiểu</string>
-    <string name="playback_buffer_min_sub">Lượng phương tiện tối thiểu cần đệm. Trình phát sẽ cố gắng luôn duy trì ít nhất lượng phương tiện này phía trước vị trí phát lại hiện tại.</string>
-    <string name="playback_buffer_max">Thời lượng bộ đệm tối đa</string>
-    <string name="playback_buffer_max_sub">Lượng phương tiện tối đa cần đệm. Giá trị này phải ít nhất bằng thời lượng bộ đệm tối thiểu. Giá trị cao hơn sử dụng nhiều bộ nhớ hơn nhưng giúp phát mượt hơn khi kết nối không ổn định.</string>
