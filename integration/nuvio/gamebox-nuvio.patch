@@ -0,0 +1,27 @@
+package com.nuvio.tv.livetv.data
+
+import com.nuvio.tv.livetv.model.LiveChannel
+
+private val legacyChannelQualitySuffix = Regex(
+    "\\s*(?:\\(\\s*(?:\\d{3,4}p|\\d{3,4}\\s*[x×]\\s*\\d{3,4}|hd|sd|fhd|uhd|[48]k)\\s*\\)|(?:\\d{3,4}p|\\d{3,4}\\s*[x×]\\s*\\d{3,4}|hd|sd|fhd|uhd|[48]k))\\s*$",
+    RegexOption.IGNORE_CASE
+)
+
+/** Index by both old identifier forms so either an XMLTV id or a displayed name can migrate. */
+internal fun indexLegacyGameBoxChannels(channels: List<LiveChannel>): Map<String, List<LiveChannel>> {
+    val index = LinkedHashMap<String, MutableList<LiveChannel>>()
+    channels.forEach { channel ->
+        val ids = buildSet {
+            channel.tvgId?.substringBefore('@')?.trim()?.lowercase()
+                ?.takeIf(String::isNotBlank)?.let(::add)
+            channel.name.trim()
+                .replace(legacyChannelQualitySuffix, "")
+                .trimEnd(' ', '-', '–', '—', '|', '·')
+                .lowercase()
+                .replace(Regex("[^\\p{L}\\p{N}]"), "")
+                .takeIf(String::isNotBlank)?.let(::add)
+        }
+        ids.forEach { key -> index.getOrPut(key, ::mutableListOf).add(channel) }
+    }
+    return index
+}
