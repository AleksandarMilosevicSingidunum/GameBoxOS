+package com.gamebox.os.importer
+
+import android.content.Context
+import com.gamebox.os.data.DiscoveryGame
+import kotlinx.coroutines.flow.MutableStateFlow
+import kotlinx.coroutines.flow.StateFlow
+import kotlinx.coroutines.flow.asStateFlow
+import kotlinx.serialization.Serializable
+import kotlinx.serialization.decodeFromString
+import kotlinx.serialization.encodeToString
+import kotlinx.serialization.json.Json
+import com.gamebox.os.settings.AndroidKeystoreSecretStore
+
+@Serializable
+data class BrowserDownloadRecord(
+    val downloadId: Long,
+    val stagedName: String,
+    val displayName: String,
+    val gameId: String,
+    val title: String,
+    val platformName: String,
+    val platformId: String,
+    val region: String? = null,
+    val releaseDate: String? = null,
+    val description: String? = null,
+    val players: String? = null,
+    val rating: Double? = null,
+    val coverUrl: String? = null,
+    val backgroundUrl: String? = null,
+    val logoUrl: String? = null,
+    val downloadUrl: String? = null,
+    val transferJobId: Int? = null,
+    val userAgent: String? = null,
+    val mimeType: String? = null,
+    val referer: String? = null,
+    val status: BrowserDownloadStatus = BrowserDownloadStatus.QUEUED,
+    val totalBytes: Long = 0L,
+    val downloadedBytes: Long = 0L,
+    val bytesPerSecond: Long = 0L,
+    val importStage: String? = null,
+    val importBytesProcessed: Long = 0L,
+    val importTotalBytes: Long? = null,
+    val importFileIndex: Int = 0,
+    val importFileCount: Int = 0,
+    val error: String? = null,
+    val manualImport: Boolean = false,
+    val sourceUris: List<String> = emptyList(),
+    val sourceNames: List<String> = emptyList(),
+    val sourceGrantFlags: Int = 0,
+    val createdAtMillis: Long = 0L,
+    val favorite: Boolean = false,
+)
+
+@Serializable
+enum class BrowserDownloadStatus {
+    QUEUED,
+    DOWNLOADING,
+    PAUSED,
+    IMPORTING,
+    IMPORTED,
+    FAILED,
+    CANCELLED,
+}
+
+internal val ACTIVE_BROWSER_DOWNLOAD_STATUSES = setOf(
+    BrowserDownloadStatus.QUEUED,
+    BrowserDownloadStatus.DOWNLOADING,
+    BrowserDownloadStatus.PAUSED,
+    BrowserDownloadStatus.IMPORTING,
+)
+private const val MAX_BROWSER_DOWNLOAD_RECORDS = 100
+
+private fun BrowserDownloadRecord.sortTimestamp() = createdAtMillis.takeIf { it > 0L } ?: downloadId
+
+internal fun retainRecentBrowserDownloads(records: List<BrowserDownloadRecord>): List<BrowserDownloadRecord> {
+    val active = records.filter { it.status in ACTIVE_BROWSER_DOWNLOAD_STATUSES }
+    val terminal = records.asSequence()
+        .filterNot { it.status in ACTIVE_BROWSER_DOWNLOAD_STATUSES }
+        .sortedByDescending(BrowserDownloadRecord::sortTimestamp)
+        .take((MAX_BROWSER_DOWNLOAD_RECORDS - active.size).coerceAtLeast(0))
+        .toList()
+    return (active + terminal).sortedByDescending(BrowserDownloadRecord::sortTimestamp)
+}
+
+/** Durable transfer and import state shared by Download Manager and background workers. */
+class BrowserDownloadStore(context: Context) {
+    private val appContext = context.applicationContext
+    private val preferences = appContext
+        .getSharedPreferences(PREFERENCES_NAME, Context.MODE_PRIVATE)
+    private val secrets = AndroidKeystoreSecretStore(appContext)
+    private val lock = Any()
+    private val json = Json { ignoreUnknownKeys = true }
+    private val mutableRecords = MutableStateFlow(readRecords())
+    val records: StateFlow<List<BrowserDownloadRecord>> = mutableRecords.asStateFlow()
+
+    fun add(record: BrowserDownloadRecord) = mutate { current ->
+        (current.filterNot { it.downloadId == record.downloadId } + record)
+            .sortedByDescending(BrowserDownloadRecord::sortTimestamp)
+    }
+
+    fun replace(oldDownloadId: Long, replacement: BrowserDownloadRecord) = mutate { current ->
+        (current.filterNot { it.downloadId == oldDownloadId || it.downloadId == replacement.downloadId } + replacement)
+            .sortedByDescending(BrowserDownloadRecord::sortTimestamp)
+    }
+
+    fun setRetryCookie(downloadId: Long, cookie: String?) =
+        secrets.put(retryCookieKey(downloadId), cookie)
+
+    fun retryCookie(downloadId: Long): String? = secrets.get(retryCookieKey(downloadId))
+
+    private fun retryCookieKey(downloadId: Long) = "browser_download_cookie_$downloadId"
+
+    fun update(downloadId: Long, transform: (BrowserDownloadRecord) -> BrowserDownloadRecord) =
+        mutate { current -> current.map { if (it.downloadId == downloadId) transform(it) else it } }
+
+    fun get(downloadId: Long): BrowserDownloadRecord? =
+        records.value.firstOrNull { it.downloadId == downloadId }
+
+    fun dismiss(downloadId: Long): BrowserDownloadRecord? {
+        val removed = synchronized(lock) {
+            val record = mutableRecords.value.firstOrNull { it.downloadId == downloadId }
+                ?: return null
+            if (record.status != BrowserDownloadStatus.FAILED &&
+                record.status != BrowserDownloadStatus.CANCELLED
+            ) return null
+            val updated = mutableRecords.value.filterNot { it.downloadId == downloadId }
+            check(preferences.edit().putString(KEY_RECORDS, json.encodeToString(updated)).commit()) {
+                "Could not persist browser download state"
+            }
+            mutableRecords.value = updated
+            record
+        }
+        secrets.put(retryCookieKey(downloadId), null)
+        return removed
+    }
+
+    private fun mutate(transform: (List<BrowserDownloadRecord>) -> List<BrowserDownloadRecord>) {
+        synchronized(lock) {
+            val updated = retainRecentBrowserDownloads(transform(mutableRecords.value))
+            check(preferences.edit().putString(KEY_RECORDS, json.encodeToString(updated)).commit()) {
+                "Could not persist browser download state"
+            }
+            mutableRecords.value = updated
+        }
+    }
+
+    private fun readRecords(): List<BrowserDownloadRecord> = runCatching {
+        json.decodeFromString<List<BrowserDownloadRecord>>(
+            preferences.getString(KEY_RECORDS, "[]") ?: "[]",
+        ).let(::retainRecentBrowserDownloads)
+    }.getOrDefault(emptyList())
+
+    private companion object {
+        const val PREFERENCES_NAME = "tracked_browser_downloads"
+        const val KEY_RECORDS = "records"
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/importer/BrowserDownloadTracker.kt b/app/src/gamebox/java/com/gamebox/os/importer/BrowserDownloadTracker.kt
new file mode 100644
index 0000000..e88bc1f
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/importer/BrowserDownloadTracker.kt
@@ -0,0 +1,101 @@
+package com.gamebox.os.importer
+
+import android.app.DownloadManager
+import android.content.Context
+import android.net.Uri
+import android.os.Environment
+import kotlinx.coroutines.Dispatchers
+import kotlinx.coroutines.delay
+import kotlinx.coroutines.withContext
+import kotlinx.coroutines.withTimeout
+import java.io.File
+import java.io.IOException
+
+data class BrowserDownloadCandidate(val uri: Uri, val displayName: String)
+data class BrowserDownloadProgress(
+    val downloadedBytes: Long,
+    val totalBytes: Long,
+    val percent: Int?,
+    val status: BrowserDownloadStatus,
+)
+
+internal fun browserDownloadTransferStatus(androidStatus: Int): BrowserDownloadStatus = when (androidStatus) {
+    DownloadManager.STATUS_PENDING -> BrowserDownloadStatus.QUEUED
+    DownloadManager.STATUS_PAUSED -> BrowserDownloadStatus.PAUSED
+    else -> BrowserDownloadStatus.DOWNLOADING
+}
+
+internal fun hasRecoverableStagedDownload(stagedFile: File): Boolean =
+    stagedFile.isFile && stagedFile.length() > 0L
+
+/** Watches only the DownloadManager request that GameBox itself queued. */
+class BrowserDownloadTracker(context: Context) {
+    private val applicationContext = context.applicationContext
+    private val downloadManager = applicationContext.getSystemService(DownloadManager::class.java)
+
+    suspend fun awaitCompletedDownload(
+        id: Long,
+        stagedName: String,
+        displayName: String,
+        onProgress: (BrowserDownloadProgress) -> Unit,
+        timeoutMillis: Long = 60 * 60_000L,
+    ): BrowserDownloadCandidate = withTimeout(timeoutMillis) {
+        require(stagedName.matches(Regex("[0-9a-f-]{36}\\.[a-z0-9]+"))) {
+            "Invalid download staging name"
+        }
+        val directory = applicationContext.getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)
+            ?: throw IOException("App download storage is unavailable")
+        val stagedFile = File(directory, stagedName)
+        while (true) {
+            val state = withContext(Dispatchers.IO) { query(id) }
+            if (state == null) {
+                // Android can prune a completed DownloadManager row while the
+                // app-owned staged file is still present. Recover that completion
+                // instead of marking it failed and making the user start over.
+                if (hasRecoverableStagedDownload(stagedFile)) {
+                    return@withTimeout BrowserDownloadCandidate(Uri.fromFile(stagedFile), displayName)
+                }
+                throw IOException("Download disappeared from Android's queue before a staged file was available")
+            }
+            when (state.status) {
+                DownloadManager.STATUS_SUCCESSFUL -> {
+                    if (!stagedFile.isFile) throw IOException("Completed download file is missing")
+                    return@withTimeout BrowserDownloadCandidate(Uri.fromFile(stagedFile), displayName)
+                }
+                DownloadManager.STATUS_FAILED -> throw IOException("Android download failed (code ${state.reason})")
+            }
+            onProgress(
+                BrowserDownloadProgress(
+                    downloadedBytes = state.downloadedBytes,
+                    totalBytes = state.totalBytes,
+                    percent = if (state.totalBytes > 0) {
+                        (state.downloadedBytes * 100 / state.totalBytes).coerceIn(0, 99).toInt()
+                    } else null,
+                    status = browserDownloadTransferStatus(state.status),
+                ),
+            )
+            delay(1_000L)
+        }
+        @Suppress("UNREACHABLE_CODE")
+        throw IllegalStateException("Download polling stopped")
+    }
+
+    private fun query(id: Long): State? = downloadManager.query(
+        DownloadManager.Query().setFilterById(id),
+    )?.use { cursor ->
+        if (!cursor.moveToFirst()) return@use null
+        State(
+            status = cursor.getInt(cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_STATUS)),
+            reason = cursor.getInt(cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_REASON)),
+            totalBytes = cursor.getLong(cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_TOTAL_SIZE_BYTES)),
+            downloadedBytes = cursor.getLong(cursor.getColumnIndexOrThrow(DownloadManager.COLUMN_BYTES_DOWNLOADED_SO_FAR)),
+        )
+    }
+
+    private data class State(
+        val status: Int,
+        val reason: Int,
+        val totalBytes: Long,
+        val downloadedBytes: Long,
+    )
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/importer/BrowserDownloadTransferJobService.kt b/app/src/gamebox/java/com/gamebox/os/importer/BrowserDownloadTransferJobService.kt
new file mode 100644
index 0000000..637d84d
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/importer/BrowserDownloadTransferJobService.kt
@@ -0,0 +1,207 @@
+package com.gamebox.os.importer
+
+import android.app.job.JobParameters
+import android.app.job.JobService
+import android.app.NotificationChannel
+import android.app.NotificationManager
+import androidx.annotation.RequiresApi
+import android.content.Intent
+import android.net.Uri
+import android.os.Build
+import android.os.Environment
+import androidx.core.app.NotificationCompat
+import com.gamebox.os.GameBoxApplication
+import java.io.File
+import java.net.HttpURLConnection
+import java.net.URI
+import java.net.URL
+import java.util.concurrent.ConcurrentHashMap
+import java.util.concurrent.Executors
+import kotlinx.coroutines.runBlocking
+
+class BrowserDownloadTransferJobService : JobService() {
+    private data class RunningTransfer(
+        @Volatile var thread: Thread? = null,
+        @Volatile var connection: HttpURLConnection? = null,
+        @Volatile var stopped: Boolean = false,
+    )
+
+    private val executor = Executors.newCachedThreadPool()
+    private val running = ConcurrentHashMap<Int, RunningTransfer>()
+
+    override fun onStartJob(params: JobParameters): Boolean {
+        if (Build.VERSION.SDK_INT < Build.VERSION_CODES.UPSIDE_DOWN_CAKE) return false
+        val app = application as? GameBoxApplication ?: return false
+        val downloadId = params.extras.getLong(EXTRA_DOWNLOAD_ID, -1L)
+        val record = app.browserDownloadStore.get(downloadId)?.takeIf {
+            it.transferJobId == params.jobId && it.status in ACTIVE_BROWSER_DOWNLOAD_STATUSES
+        }
+            ?: return false
+        ensureNotificationChannel()
+        updateNotification(params, record, 0L, -1L)
+        val task = RunningTransfer()
+        running[params.jobId] = task
+        executor.execute {
+            task.thread = Thread.currentThread()
+            try {
+                val staged = getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)?.let {
+                    File(it, record.stagedName)
+                }?.takeIf(::hasRecoverableStagedDownload)
+                val file = if (staged != null) staged
+                else download(app, record, task) { bytes, total ->
+                    app.browserDownloadStore.update(downloadId) {
+                        it.copy(
+                            status = BrowserDownloadStatus.DOWNLOADING,
+                            downloadedBytes = bytes,
+                            totalBytes = total,
+                        )
+                    }
+                    updateNotification(params, record, bytes, total)
+                }
+                if (task.stopped) return@execute
+                app.browserDownloadStore.update(downloadId) {
+                    it.copy(status = BrowserDownloadStatus.IMPORTING, bytesPerSecond = 0L)
+                }
+                runBlocking {
+                    app.browserDownloadCoordinator.importStagedBrowserDownload(
+                        downloadId,
+                        BrowserDownloadCandidate(Uri.fromFile(file), record.displayName),
+                    )
+                }
+                if (!task.stopped) jobFinished(params, false)
+            } catch (error: Exception) {
+                if (!task.stopped) {
+                    app.browserDownloadStore.update(downloadId) {
+                        it.copy(
+                            status = BrowserDownloadStatus.FAILED,
+                            bytesPerSecond = 0L,
+                            error = error.message?.take(180) ?: "Download failed",
+                        )
+                    }
+                    jobFinished(params, false)
+                }
+            } finally {
+                running.remove(params.jobId, task)
+            }
+        }
+        return true
+    }
+
+    override fun onStopJob(params: JobParameters): Boolean {
+        val task = running.remove(params.jobId) ?: return true
+        task.stopped = true
+        task.connection?.disconnect()
+        task.thread?.interrupt()
+        (application as? GameBoxApplication)?.browserDownloadStore?.update(
+            params.extras.getLong(EXTRA_DOWNLOAD_ID, -1L),
+        ) { it.copy(status = browserDownloadStatusAfterTransferStop(it.status), bytesPerSecond = 0L) }
+        return true
+    }
+
+    private fun download(
+        app: GameBoxApplication,
+        record: BrowserDownloadRecord,
+        task: RunningTransfer,
+        onProgress: (Long, Long) -> Unit,
+    ): File {
+        require(record.stagedName.matches(Regex("[0-9a-f-]{36}\\.[a-z0-9]+"))) { "Invalid staging name" }
+        val directory = getExternalFilesDir(Environment.DIRECTORY_DOWNLOADS)
+            ?: throw IllegalStateException("GameBox download storage is unavailable")
+        if (!directory.exists() && !directory.mkdirs()) throw IllegalStateException("Could not create download folder")
+        val destination = File(directory, record.stagedName)
+        val partial = File(directory, record.stagedName + ".part")
+        val source = URI.create(requireNotNull(record.downloadUrl) { "Download URL is missing" })
+        require(source.scheme == "https" && !source.host.isNullOrBlank()) { "Only HTTPS downloads are supported" }
+        val cookie = app.browserDownloadStore.retryCookie(record.downloadId)
+        var offset = partial.length().coerceAtMost(MAX_DOWNLOAD_BYTES)
+        var current = source
+        var redirects = 0
+        while (true) {
+            if (task.stopped || Thread.currentThread().isInterrupted) throw InterruptedException("Download stopped")
+            require(current.scheme == "https" && !current.host.isNullOrBlank()) { "Download URL is unsafe" }
+            val connection = (URL(current.toString()).openConnection() as HttpURLConnection).apply {
+                connectTimeout = 20_000
+                readTimeout = 60_000
+                instanceFollowRedirects = false
+                requestMethod = "GET"
+                setRequestProperty("Accept", "*/*")
+                record.userAgent?.takeIf(String::isNotBlank)?.let { setRequestProperty("User-Agent", it) }
+                if (browserDownloadMayForwardCredentials(source, current)) {
+                    cookie?.takeIf(String::isNotBlank)?.let { setRequestProperty("Cookie", it) }
+                    record.referer?.takeIf(String::isNotBlank)?.let { setRequestProperty("Referer", it) }
+                }
+                if (offset > 0L) setRequestProperty("Range", "bytes=$offset-")
+            }
+            task.connection = connection
+            val code = connection.responseCode
+            if (code in 300..399) {
+                if (++redirects > MAX_REDIRECTS) throw IllegalStateException("Too many download redirects")
+                val location = connection.getHeaderField("Location")
+                    ?: throw IllegalStateException("Download redirect had no destination")
+                current = resolveSecureBrowserDownloadRedirect(current, location)
+                connection.disconnect()
+                continue
+            }
+            if (code == 416 && offset > 0L) {
+                connection.disconnect()
+                partial.delete()
+                offset = 0L
+                current = source
+                redirects = 0
+                continue
+            }
+            if (code != HttpURLConnection.HTTP_OK && code != HttpURLConnection.HTTP_PARTIAL) {
+                throw IllegalStateException("Download server returned HTTP $code")
+            }
+            if (connection.contentType.orEmpty().substringBefore(';').trim().equals("text/html", true)) {
+                throw IllegalStateException("The source returned a web page instead of the game file")
+            }
+            if (offset > 0L && code == HttpURLConnection.HTTP_OK) offset = 0L
+            val range = if (code == HttpURLConnection.HTTP_PARTIAL) {
+                parseBrowserDownloadRange(connection.getHeaderField("Content-Range"), offset)
+            } else null
+            val total = range?.total ?: connection.contentLengthLong
+            require(total <= MAX_DOWNLOAD_BYTES) { "Download exceeds GameBox’s 64 GiB import limit" }
+            val receivedBytes = receiveBrowserDownload(
+                connection = connection,
+                partial = partial,
+                append = code == HttpURLConnection.HTTP_PARTIAL && offset > 0L,
+                offset = offset,
+                totalBytes = total,
+                maxBytes = MAX_DOWNLOAD_BYTES,
+                shouldStop = { task.stopped || Thread.currentThread().isInterrupted },
+                onProgress = onProgress,
+            )
+            range?.let { validateBrowserDownloadRangeBody(it, receivedBytes, partial) }
+            return finalizeBrowserDownload(partial, destination, total)
+        }
+    }
+
+    @RequiresApi(Build.VERSION_CODES.UPSIDE_DOWN_CAKE)
+    private fun updateNotification(params: JobParameters, record: BrowserDownloadRecord, bytes: Long, total: Long) {
+        val determinate = total > 0L
+        val percent = if (determinate) (bytes * 100L / total).toInt().coerceIn(0, 99) else 0
+        val notification = NotificationCompat.Builder(this, CHANNEL_ID)
+            .setSmallIcon(android.R.drawable.stat_sys_download)
+            .setContentTitle("Downloading ${record.title}")
+            .setContentText(if (bytes > 0L) "${bytes / (1024 * 1024)} MB downloaded" else "Connecting to source…")
+            .setProgress(100, percent, !determinate)
+            .setOngoing(true)
+            .setOnlyAlertOnce(true)
+            .build()
+        setNotification(params, params.jobId, notification, JOB_END_NOTIFICATION_POLICY_REMOVE)
+    }
+
+    private fun ensureNotificationChannel() {
+        getSystemService(NotificationManager::class.java).createNotificationChannel(
+            NotificationChannel(CHANNEL_ID, "GameBox downloads", NotificationManager.IMPORTANCE_LOW),
+        )
+    }
+
+    companion object {
+        const val EXTRA_DOWNLOAD_ID = "gamebox_browser_download_id"
+        private const val CHANNEL_ID = "gamebox_user_downloads"
+        private const val MAX_REDIRECTS = 8
+        private const val MAX_DOWNLOAD_BYTES = 64L * 1024L * 1024L * 1024L
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/importer/BrowserDownloadTransferScheduler.kt b/app/src/gamebox/java/com/gamebox/os/importer/BrowserDownloadTransferScheduler.kt
new file mode 100644
index 0000000..b0c7b51
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/importer/BrowserDownloadTransferScheduler.kt
@@ -0,0 +1,122 @@
+package com.gamebox.os.importer
+
+import android.app.job.JobInfo
+import android.app.job.JobScheduler
+import android.content.ComponentName
+import android.content.Context
+import android.os.Build
+import android.os.PersistableBundle
+import java.io.File
+import java.io.FileOutputStream
+import java.net.URI
+import java.net.HttpURLConnection
+import java.util.UUID
+
+internal fun newBrowserTransferJobId(): Int = (UUID.randomUUID().hashCode() and 0x3fffffff).coerceAtLeast(1)
+
+internal fun resolveSecureBrowserDownloadRedirect(current: URI, location: String): URI =
+    current.resolve(location).also {
+        require(it.scheme == "https" && !it.host.isNullOrBlank()) { "Download redirected to an unsafe URL" }
+    }
+
+internal fun browserDownloadMayForwardCredentials(source: URI, destination: URI): Boolean =
+    source.host.equals(destination.host, ignoreCase = true)
+
+internal fun browserDownloadStatusAfterTransferStop(status: BrowserDownloadStatus): BrowserDownloadStatus =
+    if (status == BrowserDownloadStatus.QUEUED || status == BrowserDownloadStatus.DOWNLOADING ||
+        status == BrowserDownloadStatus.PAUSED
+    ) BrowserDownloadStatus.QUEUED else status
+
+internal fun validateBrowserDownloadLength(receivedBytes: Long, expectedBytes: Long) {
+    if (expectedBytes >= 0L && receivedBytes != expectedBytes) {
+        throw IllegalStateException("Download size mismatch: received $receivedBytes of $expectedBytes bytes")
+    }
+}
+
+internal data class BrowserDownloadRange(val start: Long, val end: Long, val total: Long)
+
+internal fun parseBrowserDownloadRange(contentRange: String?, requestedOffset: Long): BrowserDownloadRange {
+    val match = Regex("^bytes (\\d+)-(\\d+)/(\\d+)$").matchEntire(contentRange.orEmpty())
+        ?: throw IllegalStateException("Download server returned an invalid resume range")
+    val range = BrowserDownloadRange(
+        start = match.groupValues[1].toLong(),
+        end = match.groupValues[2].toLong(),
+        total = match.groupValues[3].toLong(),
+    )
+    require(range.start == requestedOffset) { "Download resume range did not match" }
+    require(range.end >= range.start && range.total > range.end) { "Download server returned an invalid resume range" }
+    return range
+}
+
+internal fun validateBrowserDownloadRangeBody(range: BrowserDownloadRange, receivedBytes: Long, partial: File) {
+    if (receivedBytes != range.end - range.start + 1L) {
+        partial.delete()
+        throw IllegalStateException("Download response did not match the requested byte range")
+    }
+}
+
+internal fun finalizeBrowserDownload(partial: File, destination: File, totalBytes: Long): File {
+    if (!partial.isFile || partial.length() == 0L) throw IllegalStateException("Download returned an empty file")
+    validateBrowserDownloadLength(partial.length(), totalBytes)
+    if (destination.exists() && !destination.delete()) throw IllegalStateException("Could not replace staged download")
+    if (!partial.renameTo(destination)) throw IllegalStateException("Could not finalize staged download")
+    return destination
+}
+
+internal fun receiveBrowserDownload(
+    connection: HttpURLConnection,
+    partial: File,
+    append: Boolean,
+    offset: Long,
+    totalBytes: Long,
+    maxBytes: Long,
+    shouldStop: () -> Boolean,
+    onProgress: (Long, Long) -> Unit,
+): Long {
+    var receivedBytes = 0L
+    try {
+        connection.inputStream.use { input ->
+            FileOutputStream(partial, append).use { output ->
+                var transferred = offset
+                var lastReported = 0L
+                val buffer = ByteArray(DEFAULT_BUFFER_SIZE)
+                while (true) {
+                    if (shouldStop()) throw InterruptedException("Download stopped")
+                    val count = input.read(buffer)
+                    if (count < 0) break
+                    if (count == 0) continue
+                    transferred += count
+                    receivedBytes += count
+                    require(transferred <= maxBytes) { "Download exceeds GameBox’s 64 GiB import limit" }
+                    output.write(buffer, 0, count)
+                    if (transferred - lastReported >= 256L * 1024L) {
+                        onProgress(transferred, totalBytes)
+                        lastReported = transferred
+                    }
+                }
+                output.flush()
+                onProgress(transferred, totalBytes)
+            }
+        }
+    } finally {
+        connection.disconnect()
+    }
+    return receivedBytes
+}
+
+internal fun scheduleBrowserTransfer(context: Context, record: BrowserDownloadRecord): Boolean {
+    val jobId = record.transferJobId ?: return false
+    if (Build.VERSION.SDK_INT < Build.VERSION_CODES.UPSIDE_DOWN_CAKE) return false
+    val job = JobInfo.Builder(
+        jobId,
+        ComponentName(context, BrowserDownloadTransferJobService::class.java),
+    )
+        .setRequiredNetworkType(JobInfo.NETWORK_TYPE_ANY)
+        .setUserInitiated(true)
+        .setPersisted(true)
+        .setExtras(PersistableBundle().apply {
+            putLong(BrowserDownloadTransferJobService.EXTRA_DOWNLOAD_ID, record.downloadId)
+        })
+        .build()
+    return context.getSystemService(JobScheduler::class.java).schedule(job) == JobScheduler.RESULT_SUCCESS
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/importer/ByteProgressThrottle.kt b/app/src/gamebox/java/com/gamebox/os/importer/ByteProgressThrottle.kt
new file mode 100644
index 0000000..b428d86
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/importer/ByteProgressThrottle.kt
@@ -0,0 +1,39 @@
+package com.gamebox.os.importer
+
+/** Coalesces byte callbacks while always allowing callers to publish final progress. */
+internal class ByteProgressThrottle(
+    private val onProgress: (Long) -> Unit,
+    private val intervalBytes: Long = DEFAULT_INTERVAL_BYTES,
+) {
+    private var lastReportedBytes = 0L
+    private var lastObservedBytes = 0L
+
+    init {
+        require(intervalBytes > 0L)
+    }
+
+    fun onBytesProcessed(bytesProcessed: Long) {
+        observe(bytesProcessed)
+        if (bytesProcessed - lastReportedBytes >= intervalBytes) {
+            onProgress(bytesProcessed)
+            lastReportedBytes = bytesProcessed
+        }
+    }
+
+    fun finish(bytesProcessed: Long) {
+        observe(bytesProcessed)
+        if (bytesProcessed != lastReportedBytes) {
+            onProgress(bytesProcessed)
+            lastReportedBytes = bytesProcessed
+        }
+    }
+
+    private fun observe(bytesProcessed: Long) {
+        require(bytesProcessed >= lastObservedBytes) { "Progress bytes cannot move backwards" }
+        lastObservedBytes = bytesProcessed
+    }
+
+    private companion object {
+        const val DEFAULT_INTERVAL_BYTES = 1024L * 1024L
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/importer/DiscSetPolicy.kt b/app/src/gamebox/java/com/gamebox/os/importer/DiscSetPolicy.kt
new file mode 100644
index 0000000..aa15516
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/importer/DiscSetPolicy.kt
@@ -0,0 +1,61 @@
+package com.gamebox.os.importer
+
+import java.io.File
+
+internal object DiscSetPolicy {
+    fun selectLaunchFile(directory: File, names: List<String>): String {
+        val descriptors = names.filter {
+            it.substringAfterLast('.', "").lowercase() in setOf("cue", "gdi", "mds", "ccd")
+        }
+        require(descriptors.size <= 1) { "Select one disc descriptor (.CUE, .GDI, .MDS, or .CCD) per import" }
+        if (descriptors.isNotEmpty()) {
+            validateDescriptor(directory.resolve(descriptors.single()), names)
+            return descriptors.single()
+        }
+        require(names.size == 1) {
+            "Multiple track files require one .CUE, .GDI, .MDS, or .CCD descriptor"
+        }
+        return names.single()
+    }
+
+    private fun validateDescriptor(descriptor: File, selectedNames: List<String>) {
+        require(descriptor.isFile) { "Disc descriptor is missing" }
+        require(descriptor.length() <= 2L * 1024 * 1024) { "Disc descriptor is too large" }
+        val selected = selectedNames.mapTo(mutableSetOf()) { it.lowercase() }
+        val references = when (descriptor.extension.lowercase()) {
+            "cue" -> cueReferences(descriptor)
+            "gdi" -> gdiReferences(descriptor)
+            "mds" -> listOf(descriptor.nameWithoutExtension + ".mdf")
+            "ccd" -> listOf(descriptor.nameWithoutExtension + ".img")
+            else -> emptyList()
+        }
+        references.forEach { reference ->
+            require('/' !in reference && '\\' !in reference && reference != "." && reference != "..") {
+                "Disc descriptor contains an unsafe track path"
+            }
+            require(reference.lowercase() in selected) {
+                "Disc descriptor references a file that was not selected: $reference"
+            }
+        }
+    }
+
+    private fun cueReferences(descriptor: File): List<String> {
+        val pattern = Regex("""(?im)^\s*FILE\s+(?:\"([^\"]+)\"|(\S+))""")
+        return pattern.findAll(descriptor.readText()).map { match ->
+            match.groupValues[1].ifEmpty { match.groupValues[2] }
+        }.toList().also {
+            require(it.isNotEmpty()) { "CUE descriptor does not reference any track files" }
+        }
+    }
+
+    private fun gdiReferences(descriptor: File): List<String> {
+        val pattern = Regex("""^\s*\d+\s+\d+\s+\d+\s+\d+\s+(?:\"([^\"]+)\"|(\S+))\s+\d+\s*$""")
+        return descriptor.readLines().drop(1).mapNotNull { line ->
+            pattern.matchEntire(line)?.let { match ->
+                match.groupValues[1].ifEmpty { match.groupValues[2] }
+            }
+        }.also {
+            require(it.isNotEmpty()) { "GDI descriptor does not reference any track files" }
+        }
+    }
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/importer/DiscoveryImportWorkflow.kt b/app/src/gamebox/java/com/gamebox/os/importer/DiscoveryImportWorkflow.kt
