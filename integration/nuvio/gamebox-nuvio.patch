+        name = name,
+        tvgId = null,
+        tvgName = null,
+        logo = g.addon.logo,
+        groupId = SOURCE_ID,
+        group = g.addon.displayName,
+        number = 0,
+        url = s.url,
+        headers = s.headers
+    )
