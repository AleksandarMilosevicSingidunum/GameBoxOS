+                                    ) "No verified installer is configured. Use Import your copy below."
+                                    else "Install this authorized title below to make it ready to play.",
+                                    color = MaterialTheme.colorScheme.onSurfaceVariant,
+                                    fontSize = 11.sp,
+                                )
+                            }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
