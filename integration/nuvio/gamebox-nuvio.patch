+    } else {
+        Modifier.semantics {
+            role = Role.Button
+            disabled()
+        }
+    }
+    Box(
+        modifier = actionModifier
+            .heightIn(min = 40.dp)
+            .then(contentDescription?.let { description ->
+                Modifier.semantics { this.contentDescription = description }
+            } ?: Modifier)
+            .semantics { role = Role.Button },
+        contentAlignment = Alignment.Center,
