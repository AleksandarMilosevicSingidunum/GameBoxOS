-    <!-- Playback — Buffer & Network settings -->
-    <string name="playback_section_buffer_network">Buffer &amp; netværk</string>
-    <string name="playback_section_buffer_network_desc">Hvor meget indhold der holdes i hukommelsen, og hvordan streams hentes.</string>
-    <string name="playback_buffer_custom">Brugerdefinerede afspilningsbuffere</string>
-    <string name="playback_buffer_custom_sub">Tilsidesæt Media3\'s standardbuffering med værdierne nedenfor. Når slået fra, bruger afspilleren Media3\'s standardbuffervarigheder og målstørrelse.</string>
-    <string name="playback_buffer_header">Buffer</string>
-    <string name="playback_buffer_warning">Disse indstillinger påvirker bufferadfærden. Forkerte værdier kan forårsage afspilningsproblemer.</string>
-    <string name="playback_buffer_min">Min. buffervarighed</string>
-    <string name="playback_buffer_min_sub">Minimum mængde medie der skal bufres. Afspilleren vil forsøge at sikre, at mindst så meget indhold altid er bufret forud for den aktuelle afspilningsposition.</string>
-    <string name="playback_buffer_max">Maks. buffervarighed</string>
-    <string name="playback_buffer_max_sub">Maksimal mængde medie der skal bufres. Skal mindst svare til den minimale buffervarighed. Højere værdier bruger mere hukommelse, men giver mere stabil afspilning ved ustabile forbindelser.</string>
-    <string name="playback_buffer_value_same_as_min">%1$ds (samme som min.)</string>
-    <string name="playback_buffer_initial">Indledende buffer</string>
-    <string name="playback_buffer_initial_sub">Hvor meget indhold der skal bufres, inden afspilning starter. Lavere værdier starter hurtigere, men kan forårsage hakken ved opstart på langsomme forbindelser.</string>
-    <string name="playback_buffer_after_rebuffer">Buffer efter genbuffering</string>
-    <string name="playback_buffer_after_rebuffer_sub">Hvor meget indhold der skal bufres, efter afspilningen stopper på grund af buffering. Højere værdier reducerer gentagne bufferingsafbrydelser.</string>
-    <string name="playback_buffer_back">Tilbagebuffer-varighed</string>
-    <string name="playback_buffer_back_sub">Hvor meget allerede afspillet indhold der holdes i hukommelsen. Muliggør hurtig tilbagesøgning uden gendownload. Sæt til 0 for at deaktivere og spare hukommelse.</string>
-    <string name="playback_buffer_back_reserve">Reserverer ~%1$dMB oven i målbufferen. Øgning af maks. buffervarighed reducerer dette uden at miste tilbagebuffertid.</string>
-    <string name="playback_buffer_managed">Administreret hukommelsesbudget</string>
-    <string name="playback_buffer_managed_sub">Begrænser bufferen til en sikker andel af enhedens hukommelse. Slå fra for selv at indstille målbufferstørrelsen (avanceret — store værdier kan crashe enheder med lav hukommelse).</string>
-    <string name="playback_buffer_target">Målbufferstørrelse</string>
-    <string name="playback_buffer_target_sub">Maksimal RAM brugt til foradbuffering. Maksimum beregnes ud fra enhedens tilgængelige hukommelse (Androids per-app heap-grænse), så enheder med mere RAM låser automatisk op for større grænser.</string>
-    <string name="playback_buffer_target_managed_hint">Administreres af enhedens hukommelsesbudget. Slå administreret hukommelsesbudget fra for at indstille dette.</string>
-    <string name="playback_buffer_target_warning">Advarsel: over enhedens sikre grænse (%1$d MB). Appen kan crashe under afspilning.</string>
-    <string name="playback_buffer_allow_large">Tillad større målbuffer</string>
-    <string name="playback_buffer_allow_large_sub">Fjerner enhedshukommelsesgrænsen på målbufferstørrelsesskyderen, hvilket tillader værdier op til 2GB. Kan crashe på enheder med mindre end 2GB RAM.</string>
-    <string name="playback_cache_header">Diskcache</string>
-    <string name="playback_cache_vod">VOD-diskcache</string>
-    <string name="playback_cache_vod_sub">Gem downloadede data på disken for den aktuelle stream. Udvider øjeblikkelig tilbagesøgning ud over den interne tilbagebuffer og overlever kortvarige netværksudfald. Gælder kun progressive streams (ikke HLS/DASH).</string>
-    <string name="playback_cache_auto_size">Automatisk størrelse</string>
-    <string name="playback_cache_auto_size_sub">Når slået til, bestemmes cachestørrelsen ud fra ledig diskplads. Slå fra for manuelt at vælge en størrelse.</string>
-    <string name="playback_cache_vod_size">VOD-cachestørrelse</string>
-    <string name="playback_cache_vod_size_sub">Maksimal diskbrug for progressiv VOD-cache (LRU-udryddet).</string>
-    <string name="playback_cache_info_range">Interval: %1$d-%2$d MB.</string>
-    <string name="playback_cache_info_auto">Automatisk tilstand sigter mod ca. 10% af ledig plads.</string>
-    <string name="playback_cache_info_manual_headroom">Manuel tilstand holder ca. %1$dMB frirum.</string>
-    <string name="playback_cache_info_free_disk">Ledig diskplads: %1$s.</string>
-    <string name="playback_cache_info_restart">Ny cachegrænse træder i kraft efter genstart af appen, når der skiftes mellem tilstande/størrelser.</string>
-    <string name="playback_reset_to_default">Nulstil til standard</string>
-    <string name="playback_net_custom">Brugerdefineret netværk</string>
-    <string name="playback_net_custom_sub">Brug flere parallelle forbindelser til at hente progressive streams. Når slået fra, bruges en enkelt forbindelse.</string>
-    <string name="playback_net_parallel">Parallelle forbindelser</string>
-    <string name="playback_net_parallel_sub">Brug flere forbindelser parallelt til at hente streams. Aktivér, hvis du oplever buffering, selvom din downloadhastighed er mere end tilstrækkelig.</string>
-    <string name="playback_net_connection_count">Antal forbindelser</string>
-    <string name="playback_net_connection_count_sub">Antal parallelle TCP-forbindelser. Højere værdier øger hukommelsesforbrug og gennemstrømning, men med aftagende udbytte.</string>
-    <string name="playback_net_chunk_size">Chunkstørrelse</string>
-    <string name="playback_net_chunk_size_sub">Størrelsen på hvert download-chunk per forbindelse. Større chunks reducerer overhead, men bruger mere hukommelse.</string>
