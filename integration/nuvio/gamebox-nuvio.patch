+        BlueprintOutlinedButton(
+            onClick = onClick,
+            enabled = enabled,
+            modifier = Modifier
+                .bringFocusedControlIntoView()
+                .focusProperties { canFocus = enabled }
+                .semantics {
+                    this.contentDescription = contentDescription ?: label
+                },
+        ) {
+            Text(label)
