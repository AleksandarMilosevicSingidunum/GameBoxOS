-    <string name="licenses_attributions_nuvio_body">Kodi burimor dhe kushtet e licencës janë të disponueshme në depon e projektit. Licencuar sipas GNU General Public License v3.0.</string>
-    <string name="licenses_attributions_tmdb_title">The Movie Database (TMDB)</string>
-    <string name="licenses_attributions_tmdb_body">Nuvio përdor API-në TMDB për metadata të filmave dhe serialeve, grafika, trailera, aktorë, detaje produksioni, koleksione dhe rekomandime. Ky produkt përdor API-në TMDB, por nuk mbështetet ose certifikohet nga TMDB.</string>
-    <string name="licenses_attributions_trakt_title">Trakt</string>
-    <string name="licenses_attributions_trakt_body">Nuvio lidhet me Trakt për autentifikimin e llogarisë, historikun e shikimit, sinkronizimin e progresit, të dhënat e bibliotekës, vlerësimet, listat dhe komentet. Nuvio nuk është i lidhur me dhe as i mbështetur nga Trakt.</string>
-    <string name="licenses_attributions_simkl_title">Simkl</string>
-    <string name="licenses_attributions_simkl_body">Nuvio lidhet me Simkl për autentifikimin e llogarisë, listat e shikimit, historikun e shikimit, progresin e riprodhimit dhe scrobbling. Të dhënat e gjurmimit për filma, seriale dhe anime ofrohen nga Simkl. Nuvio nuk është i lidhur me dhe as i mbështetur nga Simkl.</string>
-    <string name="licenses_attributions_premiumize_title">Premiumize</string>
-    <string name="licenses_attributions_premiumize_body">Nuvio lidhet me Premiumize për autentifikimin e llogarisë, qasjen në bibliotekën cloud, kontrollet e cache-it dhe veçoritë e riprodhimit nga cloud. Nuvio nuk është i lidhur me dhe as i mbështetur nga Premiumize.</string>
-    <string name="licenses_attributions_torbox_title">TorBox</string>
-    <string name="licenses_attributions_torbox_body">Nuvio lidhet me TorBox për autentifikimin e llogarisë, qasjen në bibliotekën cloud, kontrollet e cache-it dhe veçoritë e riprodhimit nga cloud. Nuvio nuk është i lidhur me dhe as i mbështetur nga TorBox.</string>
-    <string name="licenses_attributions_mdblist_title">MDBList</string>
-    <string name="licenses_attributions_mdblist_body">Nuvio përdor MDBList për vlerësime dhe të dhëna nga ofrues të jashtëm të pikëve. Nuvio nuk është i lidhur me dhe as i mbështetur nga MDBList.</string>
-    <string name="licenses_attributions_introdb_title">IntroDB</string>
-    <string name="licenses_attributions_introdb_body">Nuvio përdor API-në IntroDB për kohëshënuesit e hyrjes, përmbledhjes, krediteve dhe pamjes paraprake të ofruara nga komuniteti, të cilët përdoren nga kontrollet e kapërcimit. Nuvio nuk është i lidhur me dhe as i mbështetur nga IntroDB.</string>
-    <string name="licenses_attributions_imdb_title">IMDb Non-Commercial Datasets</string>
-    <string name="licenses_attributions_imdb_body">Nuvio përdor IMDb Non-Commercial Datasets, përfshirë title.ratings.tsv.gz, për vlerësimet IMDb dhe numrin e votave. Informacioni ofrohet me mirësjellje nga IMDb (https://www.imdb.com). Përdoret me leje. Të dhënat e IMDb janë për përdorim personal dhe jokomercial sipas kushteve të IMDb.</string>
-    <string name="licenses_attributions_exoplayer_title">AndroidX Media3 ExoPlayer 1.8.0</string>
-    <string name="licenses_attributions_exoplayer_body">Përdoret si motor riprodhimi në Android. Licencuar sipas Apache License, Version 2.0.</string>
-    <string name="licenses_attributions_libmpv_title">libmpv / libmpv-android</string>
-    <string name="licenses_attributions_libmpv_body">Përdoret si motor riprodhimi në Android. Mbështjellësi libmpv-android licencohet sipas licencës MIT; mpv/libmpv dhe komponentët native të përfshirë ruajnë kushtet e licencave të tyre burimore.</string>
