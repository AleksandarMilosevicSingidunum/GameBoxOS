+    <string name="licenses_attributions_tmdb_title">The Movie Database (TMDB)</string>
+    <string name="licenses_attributions_tmdb_body">O Nuvio usa a API do TMDB para metadados de filmes e séries, grafismo, trailers, elenco, detalhes de produção, coleções e recomendações. Este produto usa a API do TMDB, mas não é aprovado nem certificado pelo TMDB.</string>
+    <string name="licenses_attributions_trakt_title">Trakt</string>
+    <string name="licenses_attributions_trakt_body">O Nuvio liga-se ao Trakt para autenticação de conta, histórico de visualizações, sincronização de progresso, dados da biblioteca, classificações, listas e comentários. O Nuvio não é afiliado nem aprovado pelo Trakt.</string>
+    <string name="licenses_attributions_simkl_title">Simkl</string>
+    <string name="licenses_attributions_simkl_body">O Nuvio liga-se ao Simkl para autenticação de conta, listas de interesses, histórico de visualizações, progresso de reprodução e scrobbling. Os dados de acompanhamento de filmes, séries e anime são fornecidos pelo Simkl. O Nuvio não é afiliado nem aprovado pelo Simkl.</string>
+    <string name="licenses_attributions_premiumize_title">Premiumize</string>
+    <string name="licenses_attributions_premiumize_body">O Nuvio liga-se ao Premiumize para autenticação de conta, acesso à biblioteca na nuvem, verificações de cache e funcionalidades de reprodução na nuvem. O Nuvio não é afiliado nem aprovado pelo Premiumize.</string>
+    <string name="licenses_attributions_torbox_title">TorBox</string>
+    <string name="licenses_attributions_torbox_body">O Nuvio liga-se ao TorBox para autenticação de conta, acesso à biblioteca na nuvem, verificações de cache e funcionalidades de reprodução na nuvem. O Nuvio não é afiliado nem aprovado pelo TorBox.</string>
+    <string name="licenses_attributions_mdblist_title">MDBList</string>
+    <string name="licenses_attributions_mdblist_body">O Nuvio usa o MDBList para classificações, histórico de visualizações e acompanhamento de reprodução. O Nuvio não é afiliado nem aprovado pelo MDBList.</string>
+    <string name="licenses_attributions_introdb_title">IntroDB</string>
+    <string name="licenses_attributions_introdb_body">O Nuvio usa a API do IntroDB para marcas temporais fornecidas pela comunidade de introduções, resumos, créditos e pré-visualizações usadas nos controlos para ignorar. O Nuvio não é afiliado nem aprovado pelo IntroDB.</string>
+    <string name="licenses_attributions_imdb_title">IMDb Non-Commercial Datasets</string>
+    <string name="licenses_attributions_imdb_body">O Nuvio usa conjuntos de dados não comerciais do IMDb, incluindo title.ratings.tsv.gz, para classificações e contagens de votos do IMDb. Informação cortesia do IMDb (https://www.imdb.com). Usado com permissão. Os dados do IMDb destinam-se a uso pessoal e não comercial ao abrigo dos termos do IMDb.</string>
