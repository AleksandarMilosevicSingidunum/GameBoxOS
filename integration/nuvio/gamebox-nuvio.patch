+    /** Copies a persisted document URI from the old GameBox picker into Nuvio's managed cache. */
+    private suspend fun downloadContentUri(
+        uri: Uri,
+        target: File,
+        progressLabel: ((Context) -> String)?,
+        reportAs: String?,
+        checkPlaylist: Boolean,
+    ): Boolean {
+        val tmp = File(target.parentFile, target.name + ".tmp")
+        try {
+            val raw = context.contentResolver.openInputStream(uri)
+                ?: error("The saved playlist file is no longer available. Select it again in Live TV settings.")
+            raw.use { stream ->
+                val input = BufferedInputStream(stream, 64 * 1024)
+                if (checkPlaylist) notAPlaylist(input)?.let { throw NotAPlaylistException(it) }
+                input.mark(2)
+                val alreadyZipped = input.read() == 0x1f && input.read() == 0x8b
+                input.reset()
+                (if (alreadyZipped) tmp.outputStream() else fastGzip(tmp.outputStream())).use { out ->
+                    val buffer = ByteArray(64 * 1024)
+                    var read = 0L
+                    var shownAt = 0L
+                    while (true) {
+                        val count = input.read(buffer)
+                        if (count < 0) break
+                        out.write(buffer, 0, count)
+                        read += count
+                        if (progressLabel != null && System.currentTimeMillis() - shownAt > 750) {
+                            shownAt = System.currentTimeMillis()
+                            setStatus(loading = true, message = downloadProgressMessage(progressLabel, read, null))
+                        }
+                    }
+                }
+            }
+            if (tmp.length() == 0L) error("The selected playlist file is empty")
+            if (target.exists()) {
+                val same = if (isGzip(target) == isGzip(tmp)) {
+                    target.length() == tmp.length() && sameContent(target, tmp)
+                } else sameDecoded(target, tmp)
+                if (same) {
+                    tmp.delete()
+                    target.setLastModified(System.currentTimeMillis())
+                    reportAs?.let { LIVE_REPORT.add("Guide \"$it\": selected file is unchanged; kept the cached copy") }
+                    return false
+                }
+            }
+            if (!tmp.renameTo(target)) {
+                tmp.copyTo(target, overwrite = true)
+                tmp.delete()
+            }
+            File(target.parentFile, target.name + ".meta").delete()
+            markChanged(target)
+            reportAs?.let { LIVE_REPORT.add("Guide \"$it\": imported ${sizeLabel(target.length())} from the saved file") }
+            return true
+        } catch (error: Throwable) {
+            tmp.delete()
+            throw error
+        }
+    }
