+                id TEXT NOT NULL PRIMARY KEY,
+                gameId TEXT NOT NULL,
+                title TEXT NOT NULL,
+                status TEXT NOT NULL,
+                totalBytes INTEGER NOT NULL,
+                downloadedBytes INTEGER NOT NULL,
+                errorReason TEXT
+            )
+            """.trimIndent()
+        )
+    }
+}
