-            accent = String.format(java.util.Locale.US, "#%06X", accentArgb and 0xFFFFFF)
-        ) { body ->
-            pending.value = body
-            phoneTexts.received
-        }
-        handle = h
-        noNetwork = h == null
-        onDispose { h?.stop() }
-    }
-    LaunchedEffect(Unit) {
-        pending.collect { body ->
