-    <!-- Playback — Buffer & Network settings -->
-<string name="playback_section_buffer_network">Buffer e rete</string>
-<string name="playback_section_buffer_network_desc">Quanto contenuto tenere in memoria e come recuperare i flussi.</string>
-<string name="playback_net_device_memory_info">Memoria del dispositivo: %1$s | Limite di sicurezza consigliato: %2$d MB</string>
-<string name="playback_net_nuvio_performance_mode">Memoria nativa ExoPlayer</string>
-<string name="playback_net_nuvio_performance_mode_sub">Abilita l\'allocatore nativo off-heap e le ottimizzazioni di pulizia.</string>
-<string name="playback_net_nuvio_performance_mode_not_supported">Questa funzionalità non è supportata dal tuo dispositivo.</string>
-<string name="playback_buffer_custom">Buffer di riproduzione personalizzati</string>
-<string name="playback_buffer_custom_sub">Sostituisce il buffering predefinito di Media3 con i valori qui sotto. Quando è disattivato, il player usa le durate di buffer e la dimensione target standard di Media3.</string>
-<string name="playback_buffer_header">Buffer</string>
-<string name="playback_buffer_warning">Queste impostazioni influenzano il comportamento del buffering. Valori errati possono causare problemi di riproduzione.</string>
-<string name="playback_buffer_min">Durata minima buffer</string>
-<string name="playback_buffer_min_sub">Quantità minima di contenuto da mettere in buffer. Il player cercherà di mantenere sempre almeno questa quantità di contenuto già bufferizzata davanti alla posizione corrente di riproduzione.</string>
-<string name="playback_buffer_max">Durata massima buffer</string>
-<string name="playback_buffer_max_sub">Quantità massima di contenuto da mettere in buffer. Deve essere almeno la durata minima del buffer. Valori più alti usano più memoria ma garantiscono una riproduzione più fluida su connessioni instabili.</string>
-<string name="playback_buffer_value_same_as_min">%1$ds (uguale al minimo)</string>
-<string name="playback_buffer_initial">Buffer iniziale</string>
-<string name="playback_buffer_initial_sub">Quanto contenuto deve essere bufferizzato prima che inizi la riproduzione. Valori più bassi avviano più velocemente ma possono causare scatti iniziali su connessioni lente.</string>
-<string name="playback_buffer_after_rebuffer">Buffer dopo rebuffer</string>
-<string name="playback_buffer_after_rebuffer_sub">Quanto contenuto bufferizzare dopo che la riproduzione si ferma a causa del buffering. Valori più alti riducono le interruzioni ripetute del buffering.</string>
-<string name="playback_buffer_back">Durata back buffer</string>
-<string name="playback_buffer_back_sub">Quanto contenuto già riprodotto tenere in memoria. Consente di tornare indietro velocemente senza riscaricare. Imposta 0 per disattivarlo e risparmiare memoria.</string>
-<string name="playback_buffer_back_reserve">Riserva ~%1$dMB in aggiunta al buffer target. Aumentare la durata massima del buffer riduce questa riserva senza perdere il tempo di back buffer.</string>
-<string name="playback_buffer_managed">Budget memoria gestito</string>
-<string name="playback_buffer_managed_sub">Limita il buffer a una quota sicura della memoria del dispositivo. Disattivalo per impostare manualmente la dimensione del buffer target (avanzato - valori grandi possono mandare in crash i dispositivi con poca memoria).</string>
-<string name="playback_buffer_target">Dimensione buffer target</string>
-<string name="playback_buffer_target_sub">RAM massima usata per il buffering in avanti. Il massimo viene calcolato dalla memoria disponibile del dispositivo (heap limit per app di Android), quindi i dispositivi con più RAM sbloccano automaticamente limiti più alti.</string>
-<string name="playback_buffer_target_managed_hint">Gestito dal budget di memoria del dispositivo. Disattiva Budget memoria gestito per impostarlo manualmente.</string>
-<string name="playback_buffer_target_warning">Avviso: sopra il limite di sicurezza del dispositivo (%1$d MB). L\'app potrebbe bloccarsi durante la riproduzione.</string>
-<string name="playback_buffer_target_danger_warning">Pericolo: sopra il limite di avviso (%1$d MB). Alto rischio di crash.</string>
-<string name="playback_buffer_allow_large">Consenti buffer target più grandi</string>
-<string name="playback_buffer_allow_large_sub">Rimuove il limite imposto dalla memoria del dispositivo sul cursore della dimensione buffer target, consentendo valori fino a 2GB. Può causare crash su dispositivi con meno di 2GB di RAM.</string>
-<string name="playback_cache_header">Cache su disco</string>
-<string name="playback_cache_vod">Cache VOD su disco</string>
-<string name="playback_cache_vod_sub">Mantiene su disco i byte scaricati per lo stream corrente. Estende il seek-back istantaneo oltre il back buffer in memoria e resiste a brevi cadute di rete. Si applica solo ai flussi progressivi (no HLS/DASH).</string>
-<string name="playback_cache_auto_size">Dimensione automatica</string>
-<string name="playback_cache_auto_size_sub">Quando attivo, la cache viene dimensionata in base allo spazio libero su disco. Disattivalo per scegliere una dimensione manualmente.</string>
-<string name="playback_cache_vod_size">Dimensione cache VOD</string>
-<string name="playback_cache_vod_size_sub">Utilizzo massimo su disco per la cache VOD progressiva (evict LRU).</string>
-<string name="playback_cache_info_range">Intervallo: %1$d-%2$d MB.</string>
-<string name="playback_cache_info_auto">La modalità automatica punta a circa il 10% dello spazio libero.</string>
-<string name="playback_cache_info_manual_headroom">La modalità manuale mantiene circa %1$dMB di margine.</string>
-<string name="playback_cache_info_free_disk">Spazio libero disponibile: %1$s.</string>
-<string name="playback_cache_info_restart">Il nuovo limite cache si applica dopo il riavvio dell\'app quando si cambia modalità o dimensione.</string>
-<string name="playback_reset_to_default">Ripristina predefinito</string>
-<string name="playback_net_custom">Rete personalizzata</string>
-<string name="playback_net_custom_sub">Usa più connessioni parallele per recuperare flussi progressivi. Quando è disattivato, viene usata una sola connessione.</string>
-<string name="playback_net_parallel">Connessioni parallele</string>
-<string name="playback_net_parallel_sub">Usa più connessioni in parallelo per recuperare i flussi. Attivalo se hai buffering anche se la tua velocità di download è chiaramente sufficiente.</string>
-<string name="playback_net_connection_count">Numero connessioni</string>
-<string name="playback_net_connection_count_sub">Numero di connessioni TCP parallele. Valori più alti aumentano l\'uso di memoria e la capacità, ma con rendimenti decrescenti.</string>
-<string name="playback_net_chunk_size">Dimensione chunk</string>
-<string name="playback_net_chunk_size_sub">Dimensione di ogni chunk di download per connessione. Chunk più grandi riducono l\'overhead ma usano più memoria.</string>
