+    <string name="playback_buffer_after_rebuffer_sub">Lượng nội dung cần đệm sau khi phát lại bị dừng do thiếu bộ đệm. Giá trị cao hơn giúp giảm tình trạng gián đoạn do đệm lặp lại.</string>
+    <string name="playback_buffer_back">Thời lượng bộ đệm ngược</string>
+    <string name="playback_buffer_back_sub">Lượng nội dung đã phát cần giữ trong bộ nhớ. Cho phép tua nhanh về trước mà không cần tải lại. Đặt thành 0 để tắt và tiết kiệm bộ nhớ.</string>
+    <string name="playback_buffer_back_reserve">Dự trữ khoảng %1$d MB trên mức bộ đệm mục tiêu. Tăng thời lượng bộ đệm tối đa sẽ thu nhỏ phần dự trữ này mà không làm mất thời gian bộ đệm ngược</string>
+    <string name="playback_buffer_managed">Quản lý ngân sách bộ nhớ</string>
+    <string name="playback_buffer_managed_sub">Giới hạn bộ đệm ở mức an toàn dựa trên bộ nhớ của thiết bị. Tắt tùy chọn này để tự đặt kích thước bộ đệm mục tiêu (nâng cao — giá trị lớn có thể làm thiết bị ít bộ nhớ bị lỗi).</string>
+    <string name="playback_buffer_target">Dung lượng bộ đệm mục tiêu</string>
+    <string name="playback_buffer_target_sub">Lượng RAM tối đa được sử dụng để đệm nội dung phía trước. Mức tối đa được tính dựa trên bộ nhớ khả dụng của thiết bị (giới hạn vùng lưu cho mỗi ứng dụng của Android), vì vậy thiết bị có nhiều RAM hơn sẽ tự động có giới hạn cao hơn.</string>
+    <string name="playback_buffer_target_managed_hint">Được quản lý theo ngân sách bộ nhớ của thiết bị. Tắt Quản lý ngân sách bộ nhớ để thay đổi mục này.</string>
+    <string name="playback_buffer_target_warning">Cảnh báo: vượt quá giới hạn an toàn của thiết bị (%1$d MB). Ứng dụng có thể bị lỗi khi phát lại.</string>
+    <string name="playback_buffer_target_danger_warning">Nguy hiểm: vượt quá giới hạn cảnh báo (%1$d MB). Nguy cơ lỗi rất cao.</string>
+    <string name="playback_buffer_allow_large">Cho phép bộ đệm mục tiêu lớn hơn</string>
+    <string name="playback_buffer_allow_large_sub">Gỡ bỏ giới hạn bộ nhớ thiết bị trên thanh trượt dung lượng bộ đệm mục tiêu, cho phép các giá trị lên đến 2 GB. Có thể gây lỗi trên thiết bị có dưới 2 GB RAM.</string>
