-    <string name="licenses_attributions_subtitle">Poskytovatelé dat, servisní kredity a licence pro přehrávání Android používané Nuvio TV.</string>
-    <string name="licenses_attributions_section_app">LICENCE APLIKACE</string>
-    <string name="licenses_attributions_section_data">DATA A SLUŽBY</string>
-    <string name="licenses_attributions_section_playback">LICENCE PRO PŘEHRÁVÁNÍ ANDROID</string>
-    <string name="licenses_attributions_nuvio_title">Nuvio TV</string>
-    <string name="licenses_attributions_nuvio_body">Zdrojový kód a licenční podmínky jsou dostupné v repozitáři projektu. Licencováno pod GNU General Public License v3.0.</string>
-    <string name="licenses_attributions_tmdb_title">The Movie Database (TMDB)</string>
-    <string name="licenses_attributions_tmdb_body">Nuvio používá API TMDB pro metadata filmů a seriálů, artwork, trailery, obsazení, produkční detaily, kolekce a doporučení. Tento produkt používá API TMDB, ale není schválen ani certifikován TMDB.</string>
-    <string name="licenses_attributions_trakt_title">Trakt</string>
-    <string name="licenses_attributions_trakt_body">Nuvio se připojuje k Trakt pro autentizaci účtu, historii sledování, synchronizaci postupu, data knihovny, hodnocení, seznamy a komentáře. Nuvio není spojen ani schválen Trakt.</string>
-    <string name="licenses_attributions_premiumize_title">Premiumize</string>
-    <string name="licenses_attributions_premiumize_body">Nuvio se připojuje k Premiumize kvůli ověření účtu, přístupu ke cloudové knihovně, kontrole cache a funkcím cloudového přehrávání. Nuvio není s Premiumize spjaté ani jím podporované.</string>
-    <string name="licenses_attributions_torbox_title">TorBox</string>
-    <string name="licenses_attributions_torbox_body">Nuvio se připojuje k TorBox kvůli ověření účtu, přístupu ke cloudové knihovně, kontrole cache a funkcím cloudového přehrávání. Nuvio není s TorBox spjaté ani jím podporované.</string>
-    <string name="licenses_attributions_mdblist_title">MDBList</string>
-    <string name="licenses_attributions_mdblist_body">Nuvio používá MDBList pro hodnocení a data externích poskytovatelů skóre. Nuvio není spojen ani schválen MDBList.</string>
-    <string name="licenses_attributions_introdb_title">IntroDB</string>
-    <string name="licenses_attributions_introdb_body">Nuvio používá API IntroDB pro komunitně poskytované časové značky intra, rekapitulace, titulků a náhledů používané ovládacími prvky přeskočení. Nuvio není spojen ani schválen IntroDB.</string>
-    <string name="licenses_attributions_imdb_title">IMDb nekomerční datové sady</string>
-    <string name="licenses_attributions_imdb_body">Nuvio používá IMDb nekomerční datové sady, včetně title.ratings.tsv.gz, pro hodnocení IMDb a počty hlasů. Informace s laskavým svolením IMDb (https://www.imdb.com). Použito se svolením. Data IMDb jsou pro osobní a nekomerční použití podle podmínek IMDb.</string>
-    <string name="licenses_attributions_exoplayer_title">AndroidX Media3 ExoPlayer 1.8.0</string>
-    <string name="licenses_attributions_exoplayer_body">Používá se jako přehrávací engine Android. Licencováno pod Apache License, Version 2.0.</string>
-    <string name="licenses_attributions_libmpv_title">libmpv / libmpv-android</string>
-    <string name="licenses_attributions_libmpv_body">Používá se jako přehrávací engine Android. Obal libmpv-android je licencován pod MIT licencí; mpv/libmpv a přibalené nativní komponenty si ponechávají své upstream licenční podmínky.</string>
