+    <string name="playback_buffer_header">Búfer</string>
+    <string name="playback_buffer_warning">Estos ajustes afectan al comportamiento del búfer. Valores incorrectos pueden causar problemas de reproducción.</string>
+    <string name="playback_buffer_min">Duración mínima del búfer</string>
+    <string name="playback_buffer_min_sub">Cantidad mínima de contenido a almacenar en búfer. El reproductor intentará asegurar que siempre haya al menos esta cantidad de contenido en búfer por delante de la posición de reproducción actual.</string>
+    <string name="playback_buffer_max">Duración máxima del búfer</string>
+    <string name="playback_buffer_max_sub">Cantidad máxima de contenido a almacenar en búfer. Debe ser al menos la duración mínima del búfer. Valores más altos usan más memoria, pero ofrecen una reproducción más fluida en conexiones inestables.</string>
+    <string name="playback_buffer_value_same_as_min">%1$ds (igual que el mínimo)</string>
+    <string name="playback_buffer_initial">Búfer inicial</string>
+    <string name="playback_buffer_initial_sub">Cuánto contenido debe almacenarse en búfer antes de que comience la reproducción. Valores más bajos empiezan más rápido, pero pueden causar cortes iniciales en conexiones lentas.</string>
+    <string name="playback_buffer_after_rebuffer">Búfer tras un corte</string>
+    <string name="playback_buffer_after_rebuffer_sub">Cuánto contenido almacenar en búfer después de que la reproducción se detenga por falta de búfer. Valores más altos reducen las interrupciones repetidas por carga de búfer.</string>
+    <string name="playback_buffer_back">Duración del búfer de retroceso</string>
+    <string name="playback_buffer_back_sub">Cuánto contenido ya reproducido mantener en memoria. Permite retroceder rápidamente sin volver a descargar. Ponlo en 0 para desactivarlo y ahorrar memoria.</string>
+    <string name="playback_buffer_back_reserve">Reserva ~%1$dMB además del búfer objetivo. Aumentar la duración máxima del búfer reduce esto sin perder tiempo de búfer de retroceso.</string>
+    <string name="playback_buffer_managed">Presupuesto de memoria gestionado</string>
+    <string name="playback_buffer_managed_sub">Limita el búfer a una parte segura de la memoria de este dispositivo. Desactívalo para establecer tú mismo el tamaño del búfer objetivo (avanzado: valores grandes pueden bloquear dispositivos con poca memoria).</string>
+    <string name="playback_buffer_target">Tamaño del búfer objetivo</string>
+    <string name="playback_buffer_target_sub">RAM máxima usada para el búfer anticipado. El máximo se calcula a partir de la memoria disponible de tu dispositivo (el límite de heap por aplicación de Android), por lo que los dispositivos con más RAM desbloquean límites mayores automáticamente.</string>
+    <string name="playback_buffer_target_managed_hint">Gestionado por el presupuesto de memoria del dispositivo. Desactiva Presupuesto de memoria gestionado para configurarlo.</string>
+    <string name="playback_buffer_target_warning">Advertencia: por encima del límite seguro del dispositivo (%1$d MB). La aplicación puede bloquearse durante la reproducción.</string>
+    <string name="playback_buffer_target_danger_warning">Peligro: por encima del límite de advertencia (%1$d MB). Alto riesgo de bloqueo.</string>
+    <string name="playback_buffer_allow_large">Permitir búfer objetivo mayor</string>
+    <string name="playback_buffer_allow_large_sub">Elimina el límite de memoria del dispositivo en el control del tamaño del búfer objetivo, permitiendo valores de hasta 2GB. Puede bloquearse en dispositivos con menos de 2GB de RAM.</string>
