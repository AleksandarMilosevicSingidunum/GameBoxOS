+@OptIn(ExperimentalTvMaterial3Api::class)
+@Composable
+private fun LegacySidebarScaffold(
+    longPressBackHeld: MutableState<Boolean>,
+    navController: NavHostController,
+    startDestination: String,
+    currentRoute: String?,
+    rootRoutes: Set<String>,
+    drawerItems: List<DrawerItem>,
+    selectedDrawerRoute: String?,
+    sidebarCollapsed: Boolean,
+    hideBuiltInHeaders: Boolean,
+    activeProfileName: String,
+    activeProfileColorHex: String,
+    activeProfileAvatarImageUrl: String?,
+    showProfileSelector: Boolean,
+    onSwitchProfile: () -> Unit,
+    onNavigate: (String) -> Unit,
+    onExitApp: () -> Unit,
+    launcherMode: () -> Boolean = { false },
+    onToggleLiveTvGroup: () -> Unit = {},
+    onSidebarExpandedChange: (Boolean) -> Unit = {}
+) {
+    val drawerState = rememberDrawerState(initialValue = DrawerValue.Closed)
+    val drawerItemFocusRequesters = rememberDrawerItemFocusRequesters(drawerItems)
+    val keyboardController = androidx.compose.ui.platform.LocalSoftwareKeyboardController.current
+    // Live TV fork: full screen now happens inside the Live TV screen (one video view that just
+    // grows), which is one of the menu's pages, so the menu has to step aside for it.
+    val liveTvFullscreen by com.nuvio.tv.livetv.ui.LiveTvFullscreen.active.collectAsState()
+    val showSidebar = currentRoute in rootRoutes && !liveTvFullscreen &&
+        !com.nuvio.tv.livetv.ui.LiveTvFullscreen.pending
+
+    val sidebarTokens = NuvioComponents.tokens.sidebar
+    val closedDrawerWidth = if (sidebarCollapsed) NuvioTheme.spacing.none else sidebarTokens.legacyCollapsedWidth
+    val openDrawerWidth = sidebarTokens.legacyExpandedWidth
+    val openDrawerItemWidth = sidebarTokens.itemWidth
+
+    val focusManager = LocalFocusManager.current
+    val isRtl = androidx.compose.ui.platform.LocalLayoutDirection.current == androidx.compose.ui.unit.LayoutDirection.Rtl
+    val contentFocusRequester = remember { FocusRequester() }
+    var pendingContentFocusTransfer by remember { mutableStateOf(false) }
+    var pendingSidebarFocusRequest by remember { mutableStateOf(false) }
+    var drawerHasFocus by remember { mutableStateOf(false) }
+    // Bumped on every key event the drawer sees so the auto-collapse timer
+    // resets while the user navigates between drawer items.
+    var legacyDrawerInteractionVersion by remember { mutableStateOf(0) }
+
+    LaunchedEffect(currentRoute) {
+        longPressBackHeld.value = false
+        drawerState.setValue(DrawerValue.Closed)
+    }
+
+    BackHandler(
+        enabled = currentRoute in rootRoutes &&
+            currentRoute != Screen.Music.route &&
+            drawerState.currentValue == DrawerValue.Closed &&
+            !com.nuvio.tv.livetv.ui.LiveTvGuideBack.reorderActive
+    ) {
+        if (System.currentTimeMillis() < com.nuvio.tv.livetv.ui.LiveTvGuideBack.suppressMenuUntilMs) {
+            com.nuvio.tv.livetv.ui.LiveTvGuideBack.suppressMenuUntilMs = 0L
+            return@BackHandler
+        }
+        // Home: Back is the app-exit prompt. Every other section: Back opens the side menu
+        // first; with the menu open, the next Back is the exit prompt.
+        if (currentRoute == Screen.Home.route && !launcherMode()) {
+            onExitApp()
+        } else {
+            pendingSidebarFocusRequest = true
+            drawerState.setValue(DrawerValue.Open)
+        }
+    }
+
+    BackHandler(enabled = currentRoute in rootRoutes && drawerState.currentValue == DrawerValue.Open) {
+        if (longPressBackHeld.value) return@BackHandler
+        if (launcherMode()) {
+            // As the Home app, Back must never leave: just close the sidebar.
+            pendingContentFocusTransfer = true
+            drawerState.setValue(DrawerValue.Closed)
+        } else {
+            onExitApp()
+        }
+    }
+
+    // Live TV fork: back from the menu to Home, the Live TV row gets the highlight back only if
+    // it had it when the menu opened (otherwise Nuvio returns to the row you were on).
+    LaunchedEffect(drawerState.currentValue) {
+        if (drawerState.currentValue == DrawerValue.Open) com.nuvio.tv.livetv.home.LiveTvHomeFocus.menuOpened()
+        else if (currentRoute == Screen.Home.route) com.nuvio.tv.livetv.home.LiveTvHomeFocus.menuClosed()
+        onSidebarExpandedChange(drawerState.currentValue == DrawerValue.Open)
+    }
+
+    // Live TV fork: Back in the Live TV list returns to the main menu.
+    val liveTvListShowing = drawerItems.any { it.isGroup && it.groupOpen }
+    BackHandler(enabled = currentRoute in rootRoutes && drawerState.currentValue == DrawerValue.Open && liveTvListShowing) {
+        if (longPressBackHeld.value) return@BackHandler
+        onToggleLiveTvGroup()
+    }
+    // Live TV fork: opening the Live TV list puts the highlight on its first page (or the one
+    // you're on).
+    var pendingLiveTvListFocus by remember { mutableStateOf(false) }
+    LaunchedEffect(drawerItems, pendingLiveTvListFocus) {
+        if (!pendingLiveTvListFocus) return@LaunchedEffect
+        val pages = drawerItems.filter { it.isChild }
+        if (pages.isEmpty()) return@LaunchedEffect
+        val target = pages.firstOrNull { it.route == selectedDrawerRoute } ?: pages.first()
+        repeat(2) { withFrameNanos { } }
+        runCatching { drawerItemFocusRequesters[target.route]?.requestFocus() }
+        pendingLiveTvListFocus = false
+    }
+
+    LaunchedEffect(drawerState.currentValue, pendingContentFocusTransfer) {
+        if (!pendingContentFocusTransfer || drawerState.currentValue != DrawerValue.Closed) {
+            return@LaunchedEffect
+        }
+        repeat(2) { withFrameNanos { } }
+        runCatching { contentFocusRequester.requestFocus() }
+        pendingContentFocusTransfer = false
+    }
+
+    LaunchedEffect(showSidebar, drawerState.currentValue, selectedDrawerRoute) {
+        if (!showSidebar || drawerState.currentValue == DrawerValue.Open) return@LaunchedEffect
+        val route = selectedDrawerRoute ?: return@LaunchedEffect
+        repeat(2) { withFrameNanos { } }
+        runCatching { drawerItemFocusRequesters[route]?.requestFocus() }
+    }
+
+    LaunchedEffect(drawerState.currentValue, selectedDrawerRoute, showSidebar, pendingSidebarFocusRequest) {
+        if (!showSidebar || !pendingSidebarFocusRequest || drawerState.currentValue != DrawerValue.Open) {
+            return@LaunchedEffect
+        }
+        val targetRoute = selectedDrawerRoute ?: drawerItems.firstOrNull()?.route ?: run {
+            pendingSidebarFocusRequest = false
+            return@LaunchedEffect
+        }
+        val requester = drawerItemFocusRequesters[targetRoute] ?: run {
+            pendingSidebarFocusRequest = false
+            return@LaunchedEffect
+        }
+        repeat(2) { withFrameNanos { } }
+        runCatching { requester.requestFocus() }
+        pendingSidebarFocusRequest = false
+    }
+
+    SidebarFocusRecoveryEffect(
+        drawerItems = drawerItems,
+        selectedDrawerRoute = selectedDrawerRoute,
+        drawerItemFocusRequesters = drawerItemFocusRequesters,
+        sidebarOwnsFocus = showSidebar && drawerState.currentValue == DrawerValue.Open,
+        sidebarHasFocus = drawerHasFocus
+    )
+
+    ModalNavigationDrawer(
+        drawerState = drawerState,
+        drawerContent = { drawerValue ->
+            if (showSidebar) {
+                val drawerWidth = if (drawerValue == DrawerValue.Open) openDrawerWidth else closedDrawerWidth
+                Box(
+                    modifier = Modifier
+                        .fillMaxHeight()
+                        .width(drawerWidth)
+                        .background(NuvioTheme.colors.Background)
+                        .padding(NuvioTheme.spacing.card.outer)
+                        .selectableGroup()
+                        .onFocusChanged { drawerHasFocus = it.hasFocus }
+                        .onPreviewKeyEvent { keyEvent ->
+                            if (keyEvent.type == KeyEventType.KeyDown) {
+                                legacyDrawerInteractionVersion++
+                            }
+                            if (keyEvent.key == Key.Back) {
+                                if (keyEvent.type == KeyEventType.KeyUp) {
+                                    if (longPressBackHeld.value) longPressBackHeld.value = false
+                                    // Consume the release too: otherwise the drawer's own
+                                    // handler still sees it and closes the menu.
+                                    if (drawerValue == DrawerValue.Open) return@onPreviewKeyEvent true
+                                }
+                                if (keyEvent.type == KeyEventType.KeyDown && drawerValue == DrawerValue.Open) {
+                                    // The menu is open: Back belongs to the exit confirmation, not
+                                    // to closing the drawer. Closing here made the second Back land
+                                    // on the startup page again.
+                                    if (!longPressBackHeld.value) {
+                                        if (liveTvListShowing) onToggleLiveTvGroup() else onExitApp()
+                                    }
+                                    return@onPreviewKeyEvent true
+                                }
+                            }
+                            val closeKey = if (isRtl) Key.DirectionLeft else Key.DirectionRight
+                            if (keyEvent.key == closeKey && keyEvent.type == KeyEventType.KeyDown) {
+                                drawerState.setValue(DrawerValue.Closed)
+                                pendingContentFocusTransfer = false
+                                true
+                            } else {
+                                false
+                            }
+                        }
+                ) {
+                    val isExpanded = drawerValue == DrawerValue.Open
+                    val itemWidth by animateDpAsState(
+                        targetValue = if (isExpanded) openDrawerItemWidth else NuvioTheme.sizes.avatars.md,
+                        animationSpec = tween(durationMillis = NuvioMotion.tokens.durations.fast, easing = NuvioMotion.tokens.easings.standard),
+                        label = "legacySidebarItemWidth"
+                    )
+
+                    if (isExpanded) {
+                        Column(
+                            modifier = Modifier
+                                .align(Alignment.TopStart)
+                                .fillMaxWidth()
+                        ) {
+                            Spacer(modifier = Modifier.height(30.dp))
+                            if (showProfileSelector && activeProfileName.isNotEmpty()) {
+                                var isProfileFocused by remember { mutableStateOf(false) }
+                                val profileItemShape = NuvioTheme.shapes.navItem
+                                val profileLeadingInset = NuvioTheme.spacing.lg + NuvioTheme.spacing.xxs
+                                val profileAvatarSize = NuvioTheme.sizes.sidebar.leadingVisual
+                                val profileLabelStart = 60.dp
+                                val profileGapAfterAvatar =
+                                    (profileLabelStart - profileLeadingInset - profileAvatarSize).coerceAtLeast(NuvioTheme.spacing.none)
+                                val profileBgColor = if (isProfileFocused) NuvioTheme.colors.FocusBackground else Color.Transparent
+                                Box(
+                                    modifier = Modifier.fillMaxWidth(),
+                                    contentAlignment = Alignment.Center
+                                ) {
+                                    Row(
+                                        modifier = Modifier
+                                            .width(itemWidth)
+                                            .height(sidebarTokens.itemHeight)
+                                            .background(color = profileBgColor, shape = profileItemShape)
+                                            .onFocusChanged { isProfileFocused = it.isFocused }
+                                            .clickable {
+                                                onSwitchProfile()
+                                                drawerState.setValue(DrawerValue.Closed)
+                                            }
+                                            .semantics { role = Role.Button },
+                                        verticalAlignment = Alignment.CenterVertically
+                                    ) {
+                                        Spacer(modifier = Modifier.width(profileLeadingInset))
+                                        ProfileAvatarCircle(
+                                            name = activeProfileName,
+                                            colorHex = activeProfileColorHex,
+                                            size = profileAvatarSize,
+                                            avatarImageUrl = activeProfileAvatarImageUrl,
+                                            imageCrossfade = false
+                                        )
+                                        Spacer(modifier = Modifier.width(profileGapAfterAvatar))
+                                        Text(
+                                            text = activeProfileName,
+                                            color = if (isProfileFocused) NuvioTheme.colors.TextPrimary else NuvioTheme.colors.TextSecondary,
+                                            maxLines = 1,
+                                            overflow = TextOverflow.Ellipsis,
+                                            textAlign = TextAlign.Start,
+                                            fontWeight = FontWeight.SemiBold
+                                        )
+                                    }
+                                }
+                            } else {
+                                BrandWordmark(
+                                    contentDescription = stringResource(R.string.app_name),
+                                    modifier = Modifier
+                                        .fillMaxWidth()
+                                        .height(42.dp)
+                                )
+                            }
+                        }
+                    } else if (showProfileSelector && activeProfileName.isNotEmpty()) {
+                        // Collapsed rail: the profile's picture above Home, so you can see whose Home it is without
+                        // opening the sidebar. Display only (the expanded row is the one that switches profile), so it
+                        // never takes the focus when the rail opens.
+                        Box(
+                            modifier = Modifier
+                                .align(Alignment.TopStart)
+                                .padding(top = 30.dp)
+                                .offset(x = NuvioTheme.spacing.md)
+                                .width(itemWidth)
+                                .height(sidebarTokens.itemHeight)
+                                .focusProperties { canFocus = false }
+                                .semantics { contentDescription = activeProfileName },
+                            contentAlignment = Alignment.Center
+                        ) {
+                            ProfileAvatarCircle(
+                                name = activeProfileName,
+                                colorHex = activeProfileColorHex,
+                                size = NuvioTheme.sizes.sidebar.leadingVisual,
+                                avatarImageUrl = activeProfileAvatarImageUrl,
+                                imageCrossfade = false
+                            )
+                        }
+                    }
+
+                    // Live TV fork: every page in one menu. Slimmer items, a thin line between
+                    // Nuvio's pages and the Live TV pages, Settings kept at the bottom, and the
+                    // list starts below the logo (scrolling if it ever doesn't fit) instead of
+                    // being centred, which grew up into the logo as pages were added.
+                    val renderItem: @Composable (DrawerItem) -> Unit = { item ->
+                        key(item.route) {
+                            Column {
+                                if (item.sectionStart) {
+                                    Box(
+                                        Modifier
+                                            .offset(x = NuvioTheme.spacing.md)
+                                            .width(itemWidth)
+                                            .padding(horizontal = 12.dp, vertical = 5.dp)
+                                            .height(1.dp)
+                                            .background(Color.White.copy(alpha = 0.14f))
+                                    )
+                                }
+                                LegacySidebarButton(
+                                    label = item.label,
+                                    iconRes = item.iconRes,
+                                    icon = item.icon,
+                                    selected = selectedDrawerRoute == item.route,
+                                    expanded = isExpanded,
+                                    focusEnabled = showSidebar,
+                                    badge = item.badge,
+                                    trailingIcon = null,
+                                    onClick = {
+                                        keyboardController?.hide()
+                                        onNavigate(item.route)
+                                        navigateToDrawerRoute(
+                                            navController = navController,
+                                            currentRoute = currentRoute,
+                                            targetRoute = item.route
+                                        )
+                                        drawerState.setValue(DrawerValue.Closed)
+                                        pendingContentFocusTransfer = currentRoute == item.route
+                                    },
+                                    modifier = Modifier.focusRequester(
+                                        drawerItemFocusRequesters.getValue(item.route)
+                                    )
+                                        // Live TV fork: Up / Down go to the item above / below,
+                                        // across the gap above Settings too (with fewer pages in
+                                        // the menu, Down from the last one landed on the page).
+                                        .focusProperties {
+                                            val i = drawerItems.indexOfFirst { it.route == item.route }
+                                            drawerItems.getOrNull(i + 1)?.let { n -> drawerItemFocusRequesters[n.route]?.let { down = it } }
+                                            if (i > 0) drawerItems.getOrNull(i - 1)?.let { p -> drawerItemFocusRequesters[p.route]?.let { up = it } }
+                                        }
+                                        .width(itemWidth)
+                                        .offset(x = NuvioTheme.spacing.md)
+                                )
+                            }
+                        }
+                    }
+                    Column(
+                        modifier = Modifier
+                            .align(Alignment.TopStart)
+                            .fillMaxSize()
+                            .padding(top = 92.dp, bottom = 8.dp)
+                    ) {
+                        // Shrinks a little to fit when the pages don't (Settings → Menu & Features).
+                        val fitMenu = com.nuvio.tv.livetv.ui.LocalSideMenuFit.current
+                        androidx.compose.foundation.layout.BoxWithConstraints(
+                            Modifier
+                                .weight(1f)
+                                .fillMaxWidth()
+                        ) {
+                            val room = maxHeight - 8.dp
+                            Column(
+                                modifier = Modifier
+                                    .fillMaxSize()
+                                    .verticalScroll(androidx.compose.foundation.rememberScrollState())
+                                    // Room for the highlighted item, which grows a little.
+                                    .padding(vertical = 4.dp)
+                            ) {
+                                Column(
+                                    modifier = Modifier
+                                        .fillMaxWidth()
+                                        .shrinkToFit(fitMenu, room, 0f),
+                                    verticalArrangement = Arrangement.spacedBy(4.dp),
+                                    horizontalAlignment = Alignment.Start
+                                ) {
+                                    drawerItems.filter { !it.pinnedBottom }.forEach { renderItem(it) }
+                                }
+                            }
+                        }
+                        Column(
+                            verticalArrangement = Arrangement.spacedBy(4.dp),
+                            horizontalAlignment = Alignment.Start
+                        ) {
+                            drawerItems.filter { it.pinnedBottom }.forEach { renderItem(it) }
+                        }
+                    }
+            }
+        }
+        }
+    ) {
+        // Applied per root destination (not on the NavHost container) so it only changes
+        // with the collapse setting, never during a navigation transition.
+        val rootContentInset by animateDpAsState(
+            targetValue = if (sidebarCollapsed) {
+                NuvioTheme.spacing.none
+            } else {
+                NuvioLayout.tokens.sidebarContentOffset
+            },
+            animationSpec = tween(NuvioMotion.tokens.durations.medium),
+            label = "rootContentInset"
+        )
+        // Live TV fork pages keep the old rule: room for the menu only while it's showing.
+        val forkPageInset by animateDpAsState(
+            targetValue = if (showSidebar && !sidebarCollapsed) {
+                NuvioLayout.tokens.sidebarContentOffset
+            } else {
+                NuvioTheme.spacing.none
+            },
+            animationSpec = tween(NuvioMotion.tokens.durations.medium),
+            label = "forkPageInset"
+        )
+        Box(
+            modifier = Modifier
+                .fillMaxSize()
+                .onPreviewKeyEvent { keyEvent ->
+                    // Long-press Back on a root route directly opens the sidebar,
+                    // bypassing the "scroll row to start" BackHandler in home content.
+                    if (keyEvent.key == Key.Back) {
+                        if (
+                            keyEvent.type == KeyEventType.KeyDown &&
+                            showSidebar &&
+                            drawerState.currentValue == DrawerValue.Closed &&
+                            currentRoute in rootRoutes &&
+                            // Live TV fork: in the guide and on Sports, holding Back returns to
+                            // full screen (Sports opens the menu itself when nothing's playing).
+                            currentRoute != Screen.LiveTv.route &&
+                            currentRoute != Screen.Sports.route &&
+                            keyEvent.nativeKeyEvent.isLongPress
+                        ) {
+                            if (!longPressBackHeld.value) {
+                                longPressBackHeld.value = true
+                                pendingSidebarFocusRequest = true
+                                drawerState.setValue(DrawerValue.Open)
+                            }
+                            return@onPreviewKeyEvent true
+                        }
+                        if (longPressBackHeld.value) {
+                            if (keyEvent.type == KeyEventType.KeyUp) longPressBackHeld.value = false
+                            return@onPreviewKeyEvent true
+                        }
+                    }
+                    false
+                }
+                .onKeyEvent { keyEvent ->
+                    val openKey = if (isRtl) Key.DirectionRight else Key.DirectionLeft
+                    if (
+                        showSidebar &&
+                        drawerState.currentValue == DrawerValue.Closed &&
+                        keyEvent.type == KeyEventType.KeyDown &&
+                        keyEvent.key == openKey
+                    ) {
+                        if (focusManager.moveFocus(if (isRtl) FocusDirection.Right else FocusDirection.Left)) {
+                            true
+                        } else {
+                            pendingSidebarFocusRequest = true
+                            drawerState.setValue(DrawerValue.Open)
+                            true
+                        }
+                    } else {
+                        false
+                    }
+                }
+        ) {
+            CompositionLocalProvider(
+                LocalSidebarExpanded provides (drawerState.currentValue == DrawerValue.Open),
+                LocalRootContentInset provides rootContentInset,
+                LocalForkPageInset provides forkPageInset,
+                LocalContentFocusRequester provides contentFocusRequester,
+                LocalRequestAppExit provides onExitApp,
+                LocalOpenSidebar provides {
+                    pendingSidebarFocusRequest = true
+                    drawerState.setValue(DrawerValue.Open)
+                }
+            ) {
+                Box(Modifier.fillMaxSize()) {
+                    NuvioNavHost(
+                        navController = navController,
+                        startDestination = startDestination,
+                        hideBuiltInHeaders = hideBuiltInHeaders,
+                        discoverIsRoot = Screen.Discover.route in rootRoutes
+                    )
+                    GlobalStatsOverlay()
+                }
+            }
+        }
+    }
+}
