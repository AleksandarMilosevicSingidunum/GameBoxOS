+        id == "rts2.rs" || name.startsWith("rts2") -> "4/rts-2"
+        id == "rts3.rs" || name.startsWith("rts3") -> "2/rts-3"
+        id == "rtssvet.rs" || name.startsWith("rtssvet") -> "16889/rts-svet"
