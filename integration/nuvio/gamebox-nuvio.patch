@@ -0,0 +1,68 @@
+package com.gamebox.os.data
+
+import android.content.Context
+import com.gamebox.os.storage.DirectorySaveAdapter
+import com.gamebox.os.storage.GameSaveBackupResult
+import com.gamebox.os.storage.GameSaveRestoreResult
+import com.gamebox.os.storage.SafSaveAdapter
+import com.gamebox.os.storage.SaveAdapterRegistry
+import com.gamebox.os.storage.SaveBackupCoordinator
+import com.gamebox.os.storage.SaveBackupService
+import com.gamebox.os.storage.SaveRestoreCoordinator
+import com.gamebox.os.storage.SaveSnapshotManifestStore
+
+/** Coordinates managed and explicitly authorized emulator-save snapshots for game sessions. */
+internal class GameSaveSessionBackups(
+    context: Context,
+    emulatorSaveTreeUri: () -> String,
+) {
+    private val managedSaveBackup = SaveBackupCoordinator(
+        registry = SaveAdapterRegistry(
+            mapOf("*" to DirectorySaveAdapter(context.filesDir.resolve("saves"))),
+        ),
+        backupService = SaveBackupService(
+            context.filesDir.resolve("saves"),
+            context.filesDir.resolve("save-backups"),
+        ),
+        manifestStore = SaveSnapshotManifestStore(
+            context.filesDir.resolve("save-backup-manifests"),
+        ),
+    )
+
+    private val emulatorSaveAdapter = SafSaveAdapter(
+        context = context,
+        treeUri = emulatorSaveTreeUri,
+    )
+    private val emulatorSaveBackupService = SaveBackupService(
+        context.filesDir.resolve("emulator-saves"),
+        context.filesDir.resolve("emulator-save-backups"),
+    )
+    private val emulatorSaveManifestStore = SaveSnapshotManifestStore(
+        context.filesDir.resolve("emulator-save-backup-manifests"),
+    )
+    private val emulatorSaveBackup = SaveBackupCoordinator(
+        registry = SaveAdapterRegistry(mapOf("*" to emulatorSaveAdapter)),
+        backupService = emulatorSaveBackupService,
+        manifestStore = emulatorSaveManifestStore,
+    )
+    private val emulatorSaveRestore = SaveRestoreCoordinator(
+        backupService = emulatorSaveBackupService,
+        manifestStore = emulatorSaveManifestStore,
+        adapter = emulatorSaveAdapter,
+    )
+
+    fun backup(platform: String, gameId: String): GameSaveBackupResult {
+        val managed = managedSaveBackup.backup(platform, gameId)
+        val emulator = emulatorSaveBackup.backup(platform, gameId)
+        return GameSaveBackupResult(
+            gameId = gameId,
+            artifacts = managed.artifacts + emulator.artifacts,
+            message = listOfNotNull(managed.message, emulator.message)
+                .takeIf { it.isNotEmpty() }
+                ?.joinToString(" "),
+        )
+    }
+
+    fun restoreLatest(gameId: String): GameSaveRestoreResult =
+        emulatorSaveRestore.restoreLatest(gameId)
+}
diff --git a/app/src/gamebox/java/com/gamebox/os/data/ImportedGameRegistration.kt b/app/src/gamebox/java/com/gamebox/os/data/ImportedGameRegistration.kt
new file mode 100644
index 0000000..421e7df
--- /dev/null
+++ b/app/src/gamebox/java/com/gamebox/os/data/ImportedGameRegistration.kt
@@ -0,0 +1,85 @@
+package com.gamebox.os.data
+
+import com.gamebox.os.domain.Game
+import com.gamebox.os.domain.GameId
+import com.gamebox.os.domain.InstallState
+import com.gamebox.os.domain.LocalContentFile
+import kotlin.math.ceil
+
+data class ImportedGameRegistration(
+    val id: GameId,
+    val title: String,
+    val platform: String,
+    val year: Int,
+    val sizeBytes: Long,
+    val relativePath: String,
+    val sha256: String,
+    val mimeType: String,
+    val favorite: Boolean = false,
+    val artworkUrl: String? = null,
+    val description: String? = null,
+    val players: String? = null,
+    val region: String? = null,
+    val additionalFiles: List<LocalContentFile> = emptyList(),
+) {
+    init {
+        require(title.isNotBlank()) { "Imported title is required" }
+        require(platform.isNotBlank()) { "Imported platform is required" }
+        require(sizeBytes >= 0) { "Imported size must not be negative" }
+        require(sha256.matches(Regex("^[a-f0-9]{64}$"))) { "Imported SHA-256 is invalid" }
+        require(mimeType.isNotBlank()) { "Imported MIME type is required" }
+        require(relativePath.split('/').dropLast(1).contains(id.value)) { "Imported path is outside the selected game" }
+        require(relativePath.none { it == '\\' } && relativePath.split('/').none { it == ".." || it.isEmpty() }) {
+            "Imported path is unsafe"
+        }
+        val allFiles = listOf(LocalContentFile(relativePath, sha256, mimeType)) + additionalFiles
+        require(allFiles.map { it.relativePath.lowercase() }.distinct().size == allFiles.size) {
+            "Imported file paths must be unique"
+        }
+        require(allFiles.all { it.relativePath.split('/').dropLast(1).contains(id.value) }) {
+            "Imported companion path is outside the selected game"
+        }
+    }
+}
+
+fun mergeImportedGame(existing: Game?, imported: ImportedGameRegistration): Game {
+    require(existing == null || existing.id == imported.id) {
+        "Replacement content must belong to the same game"
+    }
+    // Replacing files must not replace the user's identity, corrections or the
+    // underlying provider values used by Reset metadata.
+    val metadata = existing ?: Game(
+        id = imported.id,
+        title = imported.title,
+        platform = imported.platform,
+        year = imported.year,
+        genre = "Imported",
+        sizeMb = 0,
+        state = InstallState.NOT_INSTALLED,
+        favorite = imported.favorite,
+        artworkUrl = imported.artworkUrl,
+        description = imported.description,
+        players = imported.players,
+        region = imported.region,
+    )
+    return metadata.copy(
+        // A discovery catalog may start with a broad Retro/Homebrew label. Once
+        // the user selects a uniquely identifying file, retain the concrete
+        // console profile so emulator selection and launch become actionable.
+        platform = if (existing == null ||
+            (existing.platform.isBroadImportPlatform() && !imported.platform.isBroadImportPlatform())
+        ) imported.platform else metadata.platform,
+        sizeMb = if (imported.sizeBytes == 0L) 0 else
+            ceil(imported.sizeBytes / (1024.0 * 1024.0)).toInt().coerceAtLeast(1),
+        state = InstallState.INSTALLED,
+        localContentRelativePath = imported.relativePath,
+        localContentSha256 = imported.sha256,
+        localContentMimeType = imported.mimeType,
+        localContentFiles = listOf(
+            LocalContentFile(imported.relativePath, imported.sha256, imported.mimeType)
+        ) + imported.additionalFiles,
+    )
+}
+
+private fun String.isBroadImportPlatform(): Boolean =
+    lowercase().filter(Char::isLetterOrDigit) in setOf("retro", "homebrew", "unknownplatform")
diff --git a/app/src/gamebox/java/com/gamebox/os/data/RoomDownloadRepository.kt b/app/src/gamebox/java/com/gamebox/os/data/RoomDownloadRepository.kt
new file mode 100644
