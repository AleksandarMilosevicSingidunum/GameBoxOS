-    <!-- DV7 Handling Mode -->
-<string name="dv7_handling_title">Gestione Dolby Vision</string>
-<string name="dv7_handling_dialog_subtitle">Scegli come vengono elaborati i flussi DV al momento della riproduzione.</string>
-<string name="dv7_mode_auto">Auto (consigliato)</string>
-<string name="dv7_mode_auto_desc">Rileva il display e sceglie la modalità migliore. Se ci sono problemi di riproduzione, prova il livello base HDR10.</string>
-<string name="dv7_mode_hdr10_base_layer">Livello base HDR10</string>
-<string name="dv7_mode_hdr10_base_layer_desc">Ignora i metadati di enhancement Dolby Vision. Può aiutare sui dispositivi che supportano HDR ma hanno difficoltà con DV Profile 7.</string>
-<string name="dv7_mode_dv81_libdovi">Converti in DV8.1</string>
-<string name="dv7_mode_dv81_libdovi_desc">Converte DV7 in DV8.1 a singolo layer. Richiede un display Dolby Vision.</string>
-<string name="dv7_mode_off">Disattivato (nativo)</string>
-<string name="dv7_mode_off_desc">Passa DV7 invariato. Può dare problemi su hardware che non supporta DV Profile 7.</string>
-<string name="dv7_mode_strip_dv">Rimuovi sempre DV</string>
-<string name="dv7_mode_strip_dv_desc">Rimuove il layer RPU Dolby Vision da tutti i flussi.</string>
-<string name="audio_dv5_to_dv81_title">Converti DV5 in DV8.1</string>
-<string name="audio_dv5_to_dv81_sub">Segnala i flussi Profile 5 come Profile 8.1 per l\'output compatibile HDR10. Utile sui dispositivi che non hanno un decoder DV5 nativo.</string>
-<string name="audio_strip_hdr10plus_title">Rimuovi metadati HDR10+</string>
-<string name="audio_strip_hdr10plus_sub">Rimuove i metadati dinamici HDR10+ dai flussi. Quando è attivo anche Converti in DV8.1, la rimozione avviene dopo la conversione.</string>
-<string name="audio_dv7_preserve_mapping_title">Mantieni il mapping DV (DV7 in DV8.1)</string>
-<string name="audio_dv7_preserve_mapping_sub">Mantiene il tone-mapping originale voluto dal creatore, al costo di un po\' più di elaborazione per frame.</string>
-<string name="dv7_libdovi_mode_caption" translatable="false">Modalità di conversione (selezionata automaticamente; non modificarla salvo diversa indicazione). Scegline una per forzarla; "Nessuna" usa la modalità automatica. È attiva solo quando "Gestione DV7" è impostata su "Converti in DV8.1".</string>
-<string name="dv7_libdovi_mode_row_title" translatable="false">Modalità di conversione</string>
-<string name="dv7_libdovi_mode_none_title" translatable="false">None</string>
-<string name="dv7_libdovi_mode_none_sub" translatable="false">Nessuna sovrascrittura. Usa la modalità di conversione selezionata automaticamente.</string>
-<string name="dv7_libdovi_mode_0_title" translatable="false">Modalità 0 — Copia (nessuna conversione)</string>
-<string name="dv7_libdovi_mode_0_sub" translatable="false">Analizza l\'RPU e lo riscrive senza modifiche. Nessuna conversione del profilo.</string>
-<string name="dv7_libdovi_mode_1_title" translatable="false">Modalità 1 — MEL</string>
-<string name="dv7_libdovi_mode_1_sub" translatable="false">Converte l\'RPU per renderlo compatibile con MEL (Minimum Enhancement Layer).</string>
-<string name="dv7_libdovi_mode_2_title" translatable="false">Modalità 2 — 8.1 (mappatura senza effetto)</string>
-<string name="dv7_libdovi_mode_2_sub" translatable="false">Converte al profilo 8.1 con la mappatura di luminanza e crominanza impostata senza effetto. È la conversione standard.</string>
-<string name="dv7_libdovi_mode_3_title" translatable="false">Modalità 3 — Profilo 5 a 8.1</string>
-<string name="dv7_libdovi_mode_3_sub" translatable="false">Converte gli stream del profilo 5 (DV5) al profilo 8.1. È la stessa conversione dell\'opzione "Converti DV5 in DV8.1".</string>
-<string name="dv7_libdovi_mode_4_title" translatable="false">Modalità 4 — 8.4 (statico)</string>
-<string name="dv7_libdovi_mode_4_sub" translatable="false">Converte al profilo statico 8.4.</string>
